@page
@model ProfileModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "پروفایل";
    Layout = "_LayoutApp";
}
@section Styles {
    <link href="~/assets/libs/bootstrap/css/bootstrap.rtl.min.css" rel="stylesheet" />
    <link href="~/assets/css/vazir-font.css" rel="stylesheet" />
    <link href="~/assets/css/styles.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <style>
        body { background: var(--default-body-bg-color, #f8f9fa); }
    </style>
}

<div class="container-fluid py-4">
    <div class="my-2 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <nav>
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/Portal">پورتال داخلی</a></li>
                    <li aria-current="page" class="breadcrumb-item active">پروفایل</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="col-xxl-12">
        <div class="card custom-card profile-card overflow-hidden bg-transparent shadow-none">
            <div class="profile-background">
                <img src="~/assets/images/media/backgrounds/7.png" alt="background">
            </div>
            <div class="main-profile-cover">
                <div class="p-xl-5 pb-xl-0 p-4 position-relative">
                    <div class="d-flex gap-3 align-items-center justify-content-center flex-wrap mb-4">
                        <div class="main-avatar avatar avatar-rounded bg-primary-transparent d-flex align-items-center justify-content-center fs-24 fw-bold">
                            @Model.Initials
                        </div>
                        <div class="text-center">
                            <h4 class="fw-semibold mb-1">@Model.DisplayName</h4>
                            <p class="mb-0 fs-15">
                                <i class="ti ti-briefcase lh-1 align-middle me-2"></i>
                                @Model.RoleNames
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-0 position-relative mx-3 main-card-body mt-4">
                    <div class="profile-content">
                        <ul class="list-group list-group-flush border rounded-3 mb-4">
                            <li class="list-group-item p-3">
                                <div class="row gy-2 align-items-center">
                                    <div class="col-xl-3">
                                        <span class="fw-medium">نام کاربری:</span>
                                    </div>
                                    <div class="col-xl-9" dir="ltr">@Model.Username</div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">کد ملی:</span>
                                    </div>
                                    <div class="col-xl-9" dir="ltr">@(Model.NationalId ?? "—")</div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">شماره همراه:</span>
                                    </div>
                                    <div class="col-xl-9" dir="ltr">@(Model.MobileNumber ?? "—")</div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">ایمیل:</span>
                                    </div>
                                    <div class="col-xl-9" dir="ltr">@(Model.Email ?? "—")</div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">تاریخ عضویت:</span>
                                    </div>
                                    <div class="col-xl-9">@Model.CreatedAt.ToPersianDate()</div>

                                    <div class="col-xl-3">
                                        <span class="fw-medium">آخرین ورود:</span>
                                    </div>
                                    <div class="col-xl-9">@Model.LastLogin.ToPersianDate()</div>
                                </div>
                            </li>
                        </ul>

                        <form id="changePasswordForm">
                            @Html.AntiForgeryToken()

                            <ul class="list-group list-group-flush border rounded-3">
                                <li class="list-group-item p-3">
                                    <div class="row gy-3 align-items-center">
                                        <div class="col-xl-3">
                                            <span class="fw-medium">رمز عبور فعلی:</span>
                                        </div>
                                        <div class="col-xl-9">
                                            <div class="input-group">
                                                <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                    <i class="ti ti-eye"></i>
                                                </span>
                                                <input class="form-control" type="password" name="CurrentPassword"
                                                       autocomplete="current-password" placeholder="رمز عبور فعلی">
                                            </div>
                                        </div>

                                        <div class="col-xl-3">
                                            <span class="fw-medium">رمز عبور جدید:</span>
                                        </div>
                                        <div class="col-xl-9">
                                            <div class="input-group">
                                                <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                    <i class="ti ti-eye"></i>
                                                </span>
                                                <input class="form-control" type="password" name="NewPassword"
                                                       autocomplete="new-password" placeholder="رمز عبور جدید">
                                            </div>
                                        </div>

                                        <div class="col-xl-3">
                                            <span class="fw-medium">تأیید رمز عبور:</span>
                                        </div>
                                        <div class="col-xl-9">
                                            <div class="input-group">
                                                <span class="input-group-text toggle-password" style="cursor: pointer;">
                                                    <i class="ti ti-eye"></i>
                                                </span>
                                                <input class="form-control" type="password" name="ConfirmNewPassword"
                                                       autocomplete="new-password" placeholder="تأیید رمز عبور">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-end mt-4">
                                        <a href="/Portal" class="btn btn-light border btn-wave me-2">بازگشت به پورتال</a>
                                        <button type="submit" id="pwBtn" class="btn btn-primary btn-wave">ثبت</button>
                                    </div>
                                </li>
                            </ul>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        function showToast(msg, isSuccess) {
            Toastify({
                text: msg,
                duration: 3000,
                gravity: "top",
                position: "left",
                style: { background: isSuccess ? "#28a745" : "#dc3545" }
            }).showToast();
        }

        $(document).ready(function () {
            $("#changePasswordForm").submit(function (e) {
                e.preventDefault();
                var form = $(this);
                var btn = $("#pwBtn");
                btn.prop("disabled", true);
                $.ajax({
                    url: '@Url.Page("/Account/Profile", "ChangePassword")',
                    type: "POST",
                    data: form.serialize(),
                    dataType: "json",
                    success: function (response) {
                        if (response && response.success) {
                            showToast(response.message || "رمز عبور با موفقیت تغییر کرد", true);
                            form[0].reset();
                        } else {
                            showToast(response?.message || "خطا در تغییر رمز عبور", false);
                        }
                    },
                    error: function () {
                        showToast("خطا در ارتباط با سرور", false);
                    },
                    complete: function () {
                        btn.prop("disabled", false);
                    }
                });
            });

            document.querySelectorAll('.toggle-password').forEach(element => {
                element.addEventListener('click', function () {
                    const input = this.closest('.input-group').querySelector('input');
                    const icon = this.querySelector('i');
                    if (input.type === 'password') {
                        input.type = 'text';
                        icon.className = 'ti ti-eye-off';
                    } else {
                        input.type = 'password';
                        icon.className = 'ti ti-eye';
                    }
                });
            });
        });
    </script>
    <link href="~/assets/libs/toastify-js/src/toastify.css" rel="stylesheet" />
    <script src="~/assets/libs/toastify-js/src/toastify.js"></script>
}

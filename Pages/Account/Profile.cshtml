@page
@model ProfileModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "پروفایل من";
    Layout = "_LayoutApp";
}
@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --navy-950: #0A2036;
            --navy-900: #0D2C48;
            --navy-800: #123A5C;
            --blue-600: #1573B8;
            --teal-500: #17A6B6;
            --gold-500: #D6A24C;
            --sand-50: #F6F4EE;
            --ink-900: #152230;
            --ink-500: #5C6C78;
            --line: #E3DFD2;
            --danger: #D65B4C;
        }

        body {
            margin: 0;
            font-family: 'Vazirmatn', 'Tahoma', sans-serif;
            background: var(--sand-50);
            color: var(--ink-900);
        }

        a { color: inherit; text-decoration: none; }
        .container { max-width: 900px; margin: 0 auto; padding: 32px 24px 64px; }

        .back-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; color: var(--blue-600); font-weight: 700; margin-bottom: 20px; }

        .cover {
            background: linear-gradient(150deg, var(--navy-950), var(--navy-800));
            border-radius: 20px;
            padding: 40px 32px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 20px;
            margin-bottom: 24px;
        }

        .cover .avatar {
            width: 72px; height: 72px; border-radius: 50%;
            background: linear-gradient(135deg, var(--teal-500), var(--blue-600));
            display: flex; align-items: center; justify-content: center;
            font-size: 24px; font-weight: 800; flex-shrink: 0;
        }

        .cover h1 { font-size: 21px; font-weight: 800; margin: 0 0 4px; }
        .cover p { margin: 0; color: #C6D5E1; font-size: 13.5px; }

        .card { background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 26px; margin-bottom: 20px; }
        .card h2 { font-size: 15px; font-weight: 800; margin: 0 0 18px; }

        .info-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 18px; }
        .info-item .label { font-size: 12px; color: var(--ink-500); margin-bottom: 4px; }
        .info-item .value { font-size: 14px; font-weight: 600; }
        .info-item .value.ltr { direction: ltr; text-align: right; }

        .form-control {
            height: 44px; border-radius: 10px; border: 1px solid var(--line);
            background: var(--sand-50); width: 100%; padding: 0 14px; font-family: inherit; font-size: 13.5px;
        }
        .form-control:focus { outline: none; border-color: var(--blue-600); background: #fff; }
        label.field-label { font-size: 13px; font-weight: 600; margin-bottom: 6px; display: block; }

        .row3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; margin-bottom: 16px; }

        .btn-primary {
            height: 44px; border: none; border-radius: 10px; font-weight: 700;
            background: var(--navy-900); color: #fff; padding: 0 22px; cursor: pointer; font-family: inherit;
        }
        .btn-primary:hover { background: var(--navy-800); }
        .btn-primary:disabled { opacity: .6; cursor: default; }

        .alert { border-radius: 10px; padding: 12px 16px; font-size: 13.5px; margin-bottom: 16px; }
        .alert-danger { background: #FBEAE8; color: var(--danger); }
        .alert-success { background: #E4F6EE; color: #1E8A5A; }
        .d-none { display: none; }
    </style>
}

<div class="container">
    <a href="/Portal" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l-6 6 6 6"/></svg>
        بازگشت به پورتال
    </a>

    <div class="cover">
        <div class="avatar">@Model.Initials</div>
        <div>
            <h1>@Model.DisplayName</h1>
            <p>@Model.RoleNames — @Model.Username</p>
        </div>
    </div>

    <div class="card">
        <h2>اطلاعات حساب</h2>
        <div class="info-grid">
            <div class="info-item">
                <div class="label">نام کاربری</div>
                <div class="value ltr">@Model.Username</div>
            </div>
            <div class="info-item">
                <div class="label">کد ملی</div>
                <div class="value ltr">@(Model.NationalId ?? "—")</div>
            </div>
            <div class="info-item">
                <div class="label">شماره همراه</div>
                <div class="value ltr">@(Model.MobileNumber ?? "—")</div>
            </div>
            <div class="info-item">
                <div class="label">ایمیل</div>
                <div class="value ltr">@(Model.Email ?? "—")</div>
            </div>
            <div class="info-item">
                <div class="label">تاریخ عضویت</div>
                <div class="value">@Model.CreatedAt.ToPersianDate()</div>
            </div>
            <div class="info-item">
                <div class="label">آخرین ورود</div>
                <div class="value">@Model.LastLogin.ToPersianDate()</div>
            </div>
        </div>
    </div>

    <div class="card">
        <h2>تغییر رمز عبور</h2>
        <div id="pwAlert" class="alert d-none"></div>
        <form id="changePasswordForm">
            <div class="row3">
                <div>
                    <label class="field-label">رمز عبور فعلی</label>
                    <input type="password" class="form-control" name="CurrentPassword" autocomplete="current-password" required />
                </div>
                <div>
                    <label class="field-label">رمز عبور جدید</label>
                    <input type="password" class="form-control" name="NewPassword" autocomplete="new-password" required />
                </div>
                <div>
                    <label class="field-label">تأیید رمز عبور جدید</label>
                    <input type="password" class="form-control" name="ConfirmNewPassword" autocomplete="new-password" required />
                </div>
            </div>
            @Html.AntiForgeryToken()
            <button type="submit" id="pwBtn" class="btn-primary">ثبت رمز جدید</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
            e.preventDefault();
            const form = e.target;
            const btn = document.getElementById('pwBtn');
            const alertBox = document.getElementById('pwAlert');
            alertBox.classList.add('d-none');
            btn.disabled = true;

            fetch('@Url.Page("/Account/Profile", "ChangePassword")', {
                method: 'POST',
                body: new FormData(form)
            })
                .then(r => r.json())
                .then(res => {
                    alertBox.classList.remove('d-none', 'alert-success', 'alert-danger');
                    alertBox.classList.add(res.success ? 'alert-success' : 'alert-danger');
                    alertBox.textContent = res.message;
                    if (res.success) {
                        form.reset();
                    }
                })
                .catch(() => {
                    alertBox.classList.remove('d-none', 'alert-success');
                    alertBox.classList.add('alert-danger');
                    alertBox.textContent = 'خطای سرور';
                })
                .finally(() => { btn.disabled = false; });
        });
    </script>
}

@page
@model IndexModel
@{
    ViewData["Title"] = "سامانه‌ها";
    Layout = "_LayoutAdmin";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mt-4 mb-0">@TempData["SuccessMessage"]</div>
}

<div class="row mt-4">
    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">افزودن سامانه جدید</div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger">@Model.ErrorMessage</div>
                }
                <form method="post" asp-page-handler="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">نام سامانه</label>
                        <input asp-for="ApplicationName" class="form-control" placeholder="مثلاً اتوماسیون اداری" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">کد سامانه</label>
                        <input asp-for="ApplicationCode" class="form-control" dir="ltr" placeholder="مثلاً AUTOMATION" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">آدرس سامانه</label>
                        <input asp-for="BaseUrl" class="form-control" dir="ltr" placeholder="https://..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-wave w-100">ثبت سامانه</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title">لیست سامانه‌ها</div>
            </div>
            <div class="card-body">
                @if (Model.AllApplications.Count == 0)
                {
                    <p class="text-muted mb-0">سامانه‌ای ثبت نشده است.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table text-nowrap mb-0">
                            <thead>
                                <tr>
                                    <th>نام سامانه</th>
                                    <th>کد</th>
                                    <th>ترتیب</th>
                                    <th>وضعیت</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.AllApplications)
                                {
                                    <tr>
                                        <td>@app.ApplicationName</td>
                                        <td dir="ltr" class="text-end">@app.ApplicationCode</td>
                                        <td>@app.DisplayOrder</td>
                                        <td>
                                            @if (app.IsActive)
                                            {
                                                <span class="badge bg-success-transparent">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-transparent">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="Toggle" asp-route-applicationId="@app.ApplicationId">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-light-secondary btn-sm">
                                                    @(app.IsActive ? "غیرفعال کردن" : "فعال کردن")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

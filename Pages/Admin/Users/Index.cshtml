@page
@model IndexModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "کاربران";
    Layout = "_LayoutAdmin";
}

<div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <nav>
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="javascript:void(0);">مدیریت</a></li>
                <li aria-current="page" class="breadcrumb-item active">کاربران</li>
            </ol>
        </nav>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-4">@TempData["SuccessMessage"]</div>
}

<div class="card custom-card">
    <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div class="card-title">لیست کاربران</div>
        <a href="/Admin/Users/Edit" class="btn btn-primary btn-wave">
            <i class="ti ti-plus me-1"></i>افزودن کاربر
        </a>
    </div>
    <div class="card-body">
        <div class="input-group w-100 mb-3">
            <input type="text" class="form-control" placeholder="جستجو در نام یا نام کاربری" id="searchInput">
            <span class="input-group-text"><i class="ti ti-search"></i></span>
        </div>
        @if (Model.UserRows.Count == 0)
        {
            <p class="text-muted mb-0">کاربری ثبت نشده است.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table text-nowrap mb-0" id="usersTable">
                    <thead>
                        <tr>
                            <th>کاربر</th>
                            <th>نام کاربری</th>
                            <th>نقش‌ها</th>
                            <th>تاریخ ثبت</th>
                            <th>آخرین ورود</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in Model.UserRows)
                        {
                            <tr class="user-row" data-search="@($"{u.Name} {u.LastName} {u.Username}".ToLower())">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="avatar avatar-md avatar-rounded bg-primary-transparent"><i class="ti ti-user fs-16"></i></span>
                                        <span class="fw-semibold">@u.Name @u.LastName</span>
                                    </div>
                                </td>
                                <td dir="ltr" class="text-end">@u.Username</td>
                                <td>
                                    @if (string.IsNullOrEmpty(u.Roles))
                                    {
                                        <span class="text-muted fs-12">بدون نقش</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-transparent fs-12">@u.Roles</span>
                                    }
                                </td>
                                <td>@u.CreatedAt.ToPersianDate()</td>
                                <td>@u.LastLogin.ToPersianDate()</td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge bg-success-transparent">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-transparent">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    <a href="/Admin/Users/Edit?id=@u.UserId" class="btn btn-primary-light btn-icon btn-sm" title="ویرایش">
                                        <i class="ti ti-edit"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const term = this.value.trim().toLowerCase();
            document.querySelectorAll('.user-row').forEach(function (row) {
                row.style.display = row.dataset.search.includes(term) ? '' : 'none';
            });
        });
    </script>
}

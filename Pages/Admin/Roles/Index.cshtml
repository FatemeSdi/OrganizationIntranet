@page
@model IndexModel
@{
    ViewData["Title"] = "نقش‌ها";
    Layout = "_LayoutAdmin";
}

<div class="my-4 page-header-breadcrumb d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-semibold">نقش‌ها و سطوح دسترسی</h4>
        <p class="mb-0 text-muted fs-13">تعریف و مدیریت نقش‌های سازمانی کاربران</p>
    </div>
    <nav>
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="/Admin">مدیریت</a></li>
            <li aria-current="page" class="breadcrumb-item active">نقش‌ها</li>
        </ol>
    </nav>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
        <i class="ti ti-circle-check me-1"></i>@TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row">
    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm avatar-rounded bg-primary-transparent"><i class="ti ti-square-rounded-plus fs-14"></i></span>
                    افزودن نقش جدید
                </div>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger"><i class="ti ti-alert-circle me-1"></i>@Model.ErrorMessage</div>
                }
                <form method="post" asp-page-handler="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">نام نقش</label>
                        <input asp-for="RoleName" class="form-control" placeholder="مثلاً مدیر سیستم" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">کد نقش</label>
                        <input asp-for="RoleCode" class="form-control" dir="ltr" placeholder="مثلاً ADMIN" required />
                    </div>
                    <button type="submit" class="btn btn-primary btn-wave w-100"><i class="ti ti-plus me-1"></i>ثبت نقش</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm avatar-rounded bg-warning-transparent"><i class="ti ti-shield-lock fs-14"></i></span>
                    لیست نقش‌ها
                    <span class="badge bg-warning-transparent rounded-pill">@Model.AllRoles.Count</span>
                </div>
            </div>
            <div class="card-body">
                @if (Model.AllRoles.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="ti ti-shield-lock fs-40 text-muted op-5 d-block mb-2"></i>
                        <p class="text-muted mb-0">نقشی ثبت نشده است.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table text-nowrap mb-0">
                            <thead>
                                <tr>
                                    <th>نام نقش</th>
                                    <th>کد</th>
                                    <th>وضعیت</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var role in Model.AllRoles)
                                {
                                    <tr>
                                        <td class="fw-medium">@role.RoleName</td>
                                        <td dir="ltr" class="text-end"><span class="badge bg-light text-default border">@role.RoleCode</span></td>
                                        <td>
                                            @if (role.IsActive)
                                            {
                                                <span class="badge bg-success-transparent">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-transparent">غیرفعال</span>
                                            }
                                        </td>
                                        <td>
                                            <form method="post" asp-page-handler="Toggle" asp-route-roleId="@role.RoleId">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-wave @(role.IsActive ? "btn-danger-light" : "btn-success-light")">
                                                    @(role.IsActive ? "غیرفعال کردن" : "فعال کردن")
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

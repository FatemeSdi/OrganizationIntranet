@page
@model AssignModel
@{
    ViewData["Title"] = "مدیریت نقش‌های Permission";
    Layout = "_LayoutAdmin";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a href="/Admin">مدیریت</a></li>
    <li class="breadcrumb-item"><a href="/Admin/Permissions">Permissionها</a></li>
    <li aria-current="page" class="breadcrumb-item active">مدیریت نقش‌ها</li>
</ol>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title d-flex align-items-center gap-2">
            <span class="avatar avatar-sm avatar-rounded bg-primary-transparent"><i class="ti ti-shield-lock fs-14"></i></span>
            مدیریت نقش‌های Permission
        </div>
    </div>
    <div class="card-body">
        <div class="row gy-2 align-items-center mb-4 border rounded-3 p-3">
            <div class="col-md-3"><span class="fw-medium text-muted">سامانه:</span></div>
            <div class="col-md-9"><span class="badge bg-primary-transparent">@Model.Permission!.Application.ApplicationName</span></div>

            <div class="col-md-3"><span class="fw-medium text-muted">نام Permission:</span></div>
            <div class="col-md-9 fw-semibold">@Model.Permission.PermissionName</div>

            <div class="col-md-3"><span class="fw-medium text-muted">کد:</span></div>
            <div class="col-md-9" dir="ltr"><span class="badge bg-light text-default border">@Model.Permission.PermissionCode</span></div>

            @if (!string.IsNullOrEmpty(Model.Permission.Description))
            {
                <div class="col-md-3"><span class="fw-medium text-muted">توضیحات:</span></div>
                <div class="col-md-9">@Model.Permission.Description</div>
            }
        </div>

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <h6 class="fw-semibold text-primary mb-3"><i class="ti ti-users me-1"></i>نقش‌هایی که این Permission را دارند</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var role in Model.AllRoles)
                {
                    var isChecked = Model.SelectedRoleIds.Contains(role.RoleId);
                    <label class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 @(isChecked ? "border-primary bg-primary-transparent" : "")" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input m-0" name="SelectedRoleIds" value="@role.RoleId"
                               id="role-@role.RoleId" checked="@isChecked" />
                        <span class="fw-medium">@role.RoleName</span>
                    </label>
                }
                @if (Model.AllRoles.Count == 0)
                {
                    <span class="text-muted fs-13">هیچ نقش فعالی تعریف نشده است.</span>
                }
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button>
                <a href="/Admin/Permissions" class="btn btn-light border btn-wave">انصراف</a>
            </div>
        </form>
    </div>
</div>

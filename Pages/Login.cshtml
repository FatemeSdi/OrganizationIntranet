@page
@model LoginModel
@{
    ViewData["Title"] = "ورود به سامانه";
    Layout = "_LayoutAuth";
}
<style>
    .login-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 16px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(1100px 600px at 8% 0%, rgba(27,66,117,.10), transparent 60%), radial-gradient(900px 500px at 100% 100%, rgba(183,138,52,.08), transparent 55%), #eef1f5;
    }

        .login-container::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(11,37,64,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(11,37,64,.035) 1px, transparent 1px);
            background-size: 42px 42px;
            pointer-events: none;
        }

    .official-header {
        width: 100%;
        max-width: 860px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 20px;
        z-index: 1;
    }

        .official-header .badge-line {
            width: 46px;
            height: 3px;
            background: linear-gradient(90deg, #b78a34, #1b4275);
            border-radius: 3px;
        }

        .official-header h6 {
            margin: 0;
            color: #0b2540;
            font-weight: 700;
            font-size: 15px;
        }

    .login-card {
        display: flex;
        width: 960px;
        height: 450px;
        max-width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(36, 75, 139, 0.12);
        position: relative;
        z-index: 1;
    }

    .login-right {
        flex: 1;
        padding: 40px 36px;
        overflow-y: auto;
    }

    .login-left {
        width: 320px;
        background: linear-gradient(160deg, #244b8b, #3a6bb5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 36px 28px;
        color: #fff;
        text-align: center;
    }

        .login-left img {
            max-width: 120px;
            margin-bottom: 24px;
            border-radius: 12px;
        }

    .login-title {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .form-control, .captchaInput, .captcha-box {
        height: 46px !important;
        border-radius: 10px !important;
        border: 1px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

    .input-group .form-control {
        border-radius: 10px 0 0 10px !important;
    }

        .form-control:focus {
            border-color: #244b8b !important;
            box-shadow: 0 0 0 3px rgba(36, 75, 139, 0.12) !important;
            background: #fff !important;
        }

    .input-group-text {
        border-radius: 0 10px 10px 0 !important;
        border: 1px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

    .captcha-box {
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 22px;
        letter-spacing: 8px;
        color: #244b8b;
        user-select: none;
        width: 140px;
    }

    .captcha-refresh {
        height: 46px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #244b8b;
    }

    .btn-primary {
        height: 48px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        background: #244b8b;
    }

        .btn-primary:hover {
            background: #1a3a6e;
        }

    .support-btn {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 50px;
        padding: 10px 18px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .support-btn:hover {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

    .support-number-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: #f8fafc;
        border-radius: 10px;
        margin-bottom: 8px;
    }

        .support-number-item i {
            color: #244b8b;
            font-size: 18px;
        }

        .support-number-item .number {
            font-weight: 600;
            direction: ltr;
            font-size: 13px;
        }

        .support-number-item .label {
            color: #64748b;
            font-size: 12px;
        }

    .authentication-barrier p {
        font-size: 12px;
        color: #94a3b8;
    }

    #supportModal .modal-content {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 48px rgba(36, 75, 139, 0.18);
    }

    #supportModal .modal-header {
        background: linear-gradient(135deg, #244b8b, #3a6bb5);
        color: #fff;
        border: none;
        padding: 20px 24px;
        margin-bottom: 0;
    }

    #supportModal .modal-title {
        color: #fff;
        font-size: 17px;
        margin: 0;
        line-height: 1.4;
    }

    #supportModal .btn-close {
        filter: invert(1);
        opacity: .8;
    }

    #supportModal .modal-body {
        padding: 24px;
        background: #f8fafc;
    }

    #supportModal .support-number-item {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 10px;
        transition: .2s;
    }

        #supportModal .support-number-item:hover {
            border-color: #244b8b;
            box-shadow: 0 4px 12px rgba(36, 75, 139, 0.08);
        }

        #supportModal .support-number-item i {
            color: #244b8b;
            font-size: 20px;
            width: 28px;
            text-align: center;
        }

        #supportModal .support-number-item .label {
            color: #64748b;
            font-size: 12px;
        }

        #supportModal .support-number-item .number {
            font-weight: 600;
            color: #0b2540;
            font-size: 14px;
            direction: ltr;
        }

    @@media (max-width: 991px) {
        .login-card {
            flex-direction: column;
            max-width: 420px;
            height: auto;
        }

        .login-left {
            width: 100%;
            padding: 28px 20px;
        }

        .login-right {
            padding: 28px 20px;
        }
    }
</style>

<div class="login-container">
    <div class="official-header">
        <span class="badge-line"></span>
        <h6>پورتال داخلی سازمان</h6>
        <span class="badge-line"></span>
    </div>

    <div class="login-card">
        <div class="login-right">
            <div class="alert alert-danger py-2 d-none" id="serverError"></div>

            <form id="loginForm" method="post" autocomplete="off" asp-page="/Login">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger d-none"></div>

                <div class="form-group mb-3">
                    <div class="input-group mt-3">
                        <span class="input-group-text"><i class="ti ti-user text-muted"></i></span>
                        <input asp-for="Username" class="form-control" placeholder="نام کاربری" autocomplete="username" required />
                    </div>
                    <span asp-validation-for="Username" class="text-danger d-block mt-1"></span>
                </div>

                <div class="form-group mb-3">
                    <div class="input-group" id="Password-toggle">
                        <span class="input-group-text"><i class="ti ti-lock text-muted"></i></span>
                        <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور" autocomplete="current-password" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger d-block mt-1"></span>
                    <a class="float-end link-danger fw-medium fs-12 mt-1" href="#">
                        رمز عبور را فراموش کرده‌اید؟
                    </a>
                </div>

                <div id="securitySection" class="form-group text-start mt-2" style="direction:rtl;">
                    <label class="form-label fs-13 text-muted">کد امنیتی</label>
                    <div class="d-flex align-items-center gap-2">
                        <div class="captcha-box" id="captchaText"></div>
                        <button type="button" class="captcha-refresh" id="captchaRefreshBtn" title="تازه‌سازی کد امنیتی">
                            <i class="ti ti-refresh"></i>
                        </button>
                    </div>
                    <input type="text" id="captchaInput" name="Captcha" class="form-control captchaInput mt-2" placeholder="کد امنیتی را وارد کنید" autocomplete="off" required />
                    <span class="text-danger d-block mt-1 d-none" id="captchaError">کد امنیتی اشتباه است</span>
                </div>

                <div class="form-check mt-3 mb-0">
                    <input asp-for="RememberMe" class="form-check-input" id="defaultCheck1" type="checkbox" />
                    <label class="form-check-label fs-13" for="defaultCheck1">مرا به خاطر بسپار</label>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" id="loginBtn" class="btn btn-primary w-100">
                        <span id="loginText">ورود</span>
                        <span id="loginSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                    </button>
                </div>
            </form>

            <div class="text-center mt-4 authentication-barrier">
                <p class="mb-0"><i class="ti ti-shield-check me-1"></i>پیروی از ISMS — تمامی فعالیت‌ها ثبت می‌شود</p>
            </div>
        </div>

        <div class="login-left">
            <img src="data:image/png;base64," alt="Logo" />
            <div class="login-title">اداره کل بنادر و دریانوردی<br>استان هرمزگان</div>
            <button class="support-btn" data-bs-toggle="modal" data-bs-target="#supportModal">
                <i class="ti ti-headset"></i><span>پشتیبانی</span>
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="supportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold"><i class="ti ti-headset me-2"></i>پشتیبانی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="support-number-item">
                    <i class="ti ti-phone"></i>
                    <div>
                        <div class="label">فاوا — نرم‌افزار (ساعات اداری)</div>
                        <div class="number">۰۹۹۴۰۶۵۷۷۵۳ — فاطمه صادقی</div>
                    </div>
                </div>
                <div class="support-number-item">
                    <i class="ti ti-phone"></i>
                    <div>
                        <div class="label">داخلی</div>
                        <div class="number">۴۶۴۷</div>
                    </div>
                </div>
                <div class="support-number-item">
                    <i class="ti ti-mail"></i>
                    <div>
                        <div class="label">ایمیل</div>
                        <div class="number">sdi10fateme@@gmail.com</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function showInlineError(msg) {
            const box = $("#serverError");
            box.text(msg).removeClass("d-none");
        }
        function hideInlineError() {
            $("#serverError").addClass("d-none");
        }

        function randomCaptcha() {
            let code = "";
            for (let i = 0; i < 4; i++) code += Math.floor(Math.random() * 10);
            return code;
        }
        let currentCaptcha = randomCaptcha();
        function renderCaptcha() {
            currentCaptcha = randomCaptcha();
            $("#captchaText").text(currentCaptcha);
            $("#captchaInput").val("");
        }
        $(document).ready(function () {
            renderCaptcha();
            $("#captchaRefreshBtn").on("click", renderCaptcha);
        });

        $('#loginForm').submit(function (e) {
            e.preventDefault();
            hideInlineError();
            $("#captchaError").addClass("d-none");

            if ($("#captchaInput").val().trim() !== currentCaptcha) {
                $("#captchaError").removeClass("d-none");
                renderCaptcha();
                return;
            }

            const btn = $("#loginBtn"), spinner = $("#loginSpinner"), text = $("#loginText");
            btn.prop("disabled", true); spinner.removeClass("d-none"); text.text("در حال ورود...");
            $.ajax({
                url: '@Url.Page("/Login")', type: 'POST', data: $(this).serialize(),
                success: function (res) {
                    if (res.success) { text.text("ورود موفق"); window.location.href = res.redirectUrl; }
                    else {
                        spinner.addClass("d-none"); text.text("ورود"); btn.prop("disabled", false);
                        showInlineError(res.message || "خطا در ورود");
                        renderCaptcha();
                    }
                },
                error: function () {
                    spinner.addClass("d-none"); text.text("ورود"); btn.prop("disabled", false);
                    showInlineError("خطای سرور");
                    renderCaptcha();
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function () {
            const toggle = document.getElementById('Password-toggle');
            if (toggle) {
                const icon = toggle.querySelector('i'), input = toggle.querySelector('input');
                toggle.addEventListener('click', e => {
                    if (e.target.closest('span.input-group-text')) {
                        input.type = input.type === 'password' ? 'text' : 'password';
                        icon.classList.toggle('ti-lock');
                        icon.classList.toggle('ti-eye');
                    }
                });
            }
        });
    </script>
}

@page
@model OrganizationIntranet.Pages.Account.ForgotPasswordModel
@{ ViewData["Title"] = "بازیابی رمز عبور"; Layout = "_LayoutAuth"; }
<link rel="stylesheet" href="~/assets/css/authentication.css" asp-append-version="true" />
<main class="auth-shell" dir="rtl"><section class="auth-panel">
<h1>بازیابی رمز عبور</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Message is not null) { <p role="status">@Model.Message</p> }
@if (!Model.Enabled) { <p>بازیابی رمز در حال حاضر غیرفعال است. با مدیر سامانه تماس بگیرید.</p> }
else if (Model.AwaitingCode) {
<form method="post" asp-page-handler="Reset">
<label asp-for="Code">کد پیامک</label>
<input asp-for="Code" class="form-control mb-3" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />
<label asp-for="NewPassword">رمز جدید (۱۰ تا ۱۲۸ کاراکتر)</label>
<input asp-for="NewPassword" type="password" class="form-control mb-3" autocomplete="new-password" minlength="10" maxlength="128" required />
<label asp-for="ConfirmNewPassword">تأیید رمز جدید</label>
<input asp-for="ConfirmNewPassword" type="password" class="form-control mb-3" autocomplete="new-password" minlength="10" maxlength="128" required />
<button type="submit" class="btn btn-primary w-100">تغییر رمز عبور</button>
</form>
<details class="mt-3"><summary>دریافت کد جدید</summary><p>برای ارسال مجدد حداقل یک دقیقه صبر کنید.</p>
<partial name="_PasswordResetRequest" />
</details>
} else { <partial name="_PasswordResetRequest" /> }
<a asp-page="/Account/Login" class="d-block mt-3">بازگشت به ورود</a>
</section></main>

@page
@model LoginModel
@{
    ViewData["Title"] = "ورود به پورتال داخلی سازمان";
    Layout = "_LayoutAuth";
}
@section Styles {
<link href="~/assets/css/vazir-font.css" rel="stylesheet" />
<link href="~/css/portal-toast.css" rel="stylesheet" asp-append-version="true" />
<style>
    /* هم‌رنگ صفحه‌ی اصلی پورتال: سرمه‌ای، طلایی و شنی (متفاوت از ورود پنل مدیریت) */
    .pl{
        --navy-950:#0A2036; --navy-900:#0D2C48; --navy-800:#123A5C; --blue-600:#1573B8;
        --gold-500:#D6A24C; --gold-600:#C08A34; --sand-50:#F6F4EE; --sand-100:#EFEBE0;
        --ink-900:#152230; --ink-500:#5C6C78; --line:#E3DFD2;
        font-family:'Vazirmatn','Vazir',Tahoma,sans-serif; color:var(--ink-900);
        min-height:100vh; display:grid; grid-template-columns:minmax(0,1.05fr) minmax(0,1fr); background:var(--sand-50);
    }
    body.authentication-background{background:var(--sand-50,#F6F4EE)!important}
    main.pb-3{padding-bottom:0!important}

    /* ستون معرفی (سرمه‌ای) */
    .pl-brand{position:relative; overflow:hidden; color:#fff; padding:44px 48px; display:flex; flex-direction:column;
        background:radial-gradient(800px 420px at 85% 0%, rgba(214,162,76,.20), transparent 60%), linear-gradient(160deg,var(--navy-950),var(--navy-800));}
    .pl-wheel{position:absolute; left:-90px; bottom:-90px; width:420px; height:420px; opacity:.09; pointer-events:none}
    .pl-top{display:flex; align-items:center; justify-content:space-between; gap:12px; position:relative}
    .pl-org{display:flex; align-items:center; gap:14px}
    .pl-org img{height:54px; width:auto; filter:brightness(0) invert(1)}
    .pl-org b{display:block; font-size:16px; font-weight:800; line-height:1.5}
    .pl-org span{font-size:12.5px; color:#C6D5E1}
    .pl-home{display:inline-flex; align-items:center; gap:8px; color:var(--navy-950); background:var(--gold-500); font-size:14px; font-weight:800; padding:10px 20px; border-radius:999px; border:1px solid var(--gold-500); text-decoration:none; box-shadow:0 8px 22px -10px rgba(214,162,76,.8); transition:background .15s, transform .15s}
    .pl-home i{font-size:18px}
    .pl-home:hover{background:#E5B968; color:var(--navy-950); transform:translateY(-1px)}
    .pl-home:focus-visible{outline:3px solid #fff; outline-offset:2px}
    .pl-hero{margin:auto 0; position:relative; max-width:460px; padding:40px 0}
    .pl-eyebrow{display:inline-flex; align-items:center; gap:8px; color:var(--gold-500); font-size:13px; font-weight:700; letter-spacing:.2px}
    .pl-eyebrow::before{content:""; width:28px; height:2px; background:var(--gold-500); border-radius:2px}
    .pl-hero h1{font-size:34px; font-weight:900; line-height:1.45; margin:14px 0 12px; color:#fff}
    .pl-hero h1 em{font-style:normal; color:var(--gold-500)}
    .pl-hero p{color:#C6D5E1; font-size:15px; line-height:2; margin:0 0 26px}
    .pl-features{list-style:none; padding:0; margin:0; display:grid; gap:12px}
    .pl-features li{display:flex; align-items:center; gap:12px; font-size:14px; color:#E8EEF3}
    .pl-features i{width:34px; height:34px; border-radius:10px; display:grid; place-items:center; background:rgba(255,255,255,.08); color:var(--gold-500); font-size:18px}
    .pl-support{position:relative; align-self:flex-start; display:inline-flex; align-items:center; gap:8px; background:rgba(214,162,76,.14); color:var(--gold-500); border:1px solid rgba(214,162,76,.45); border-radius:999px; padding:10px 18px; font-size:13.5px; font-weight:700; cursor:pointer; transition:background .15s}
    .pl-support:hover{background:rgba(214,162,76,.24)}

    /* ستون فرم (شنی) */
    .pl-form{display:flex; align-items:center; justify-content:center; padding:40px 24px}
    .pl-card{width:100%; max-width:430px; background:#fff; border:1px solid var(--line); border-radius:22px; padding:34px 32px; box-shadow:0 24px 60px -30px rgba(10,32,54,.35)}
    .pl-card h2{font-size:22px; font-weight:900; margin:0 0 20px; color:var(--navy-900); text-align:center}
    .pl-card .pl-sub{color:var(--ink-500); font-size:13.5px; margin:0 0 24px}
    .pl-card .form-label{font-size:13px; font-weight:700; color:var(--navy-900)}
    /* فقط background-color: shorthand ‌background فلش dropdown بوت‌استرپ را پاک می‌کرد */
    .pl-card .form-select,.pl-card .form-control,.pl-card .captchaInput{height:48px!important; border-radius:12px!important; border:1px solid var(--line)!important; background-color:#FBFAF6!important; font-family:inherit}
    /* کد امنیتی: عنوان و تصویر (با دکمه‌ی بازنشانی) در یک ردیف، ورودی زیر آن؛ order روی خروجی DNTCaptcha اعمال می‌شود تا با جایگزینی ajax هم بماند */
    .pl-card .dntCaptcha{display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:8px 10px}
    .pl-card .dntCaptcha > label{display:contents; font-size:13px; font-weight:700; color:var(--navy-900)}
    .pl-card .dntCaptcha > img{order:1; margin:0!important; margin-inline-start:auto!important; border-radius:10px}
    .pl-card .dntCaptcha > .captcha-refresh{order:2; padding:4px 6px}
    .pl-card .dntCaptcha .captchaInput{order:3; flex:1 1 100%; width:100%}
    .pl-card .dntCaptcha > .text-danger{order:4; flex:1 1 100%}
    .pl-card .dntCaptcha > .text-danger:empty{display:none}
    .pl-card .input-group .form-control{border-radius:12px 0 0 12px!important}
    .pl-card .input-group-text{border-radius:0 12px 12px 0!important; border:1px solid var(--line)!important; background:var(--sand-100)!important; color:var(--navy-800)}
    .pl-card .form-select:focus,.pl-card .form-control:focus{border-color:var(--gold-500)!important; box-shadow:0 0 0 3px rgba(214,162,76,.18)!important; background-color:#fff!important}
    /* روش ورود: آیکن در راست و فلش واضح در چپ تا معلوم باشد فهرست کشویی است */
    .pl-select{position:relative}
    .pl-select > i{position:absolute; right:14px; top:50%; transform:translateY(-50%); color:var(--gold-600); font-size:18px; pointer-events:none}
    .pl-card .pl-select .form-select{cursor:pointer; font-weight:600; color:var(--navy-900); padding-right:44px; padding-left:44px;
        background-image:url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%230D2C48' stroke-width='2.4' stroke-linecap='round' stroke-linejoin='round'%3e%3cpath d='m6 9 6 6 6-6'/%3e%3c/svg%3e")!important;
        background-repeat:no-repeat!important; background-position:left 14px center!important; background-size:18px 18px!important}
    .pl-card .pl-select .form-select:hover{border-color:var(--gold-500)!important}
    .pl-card .otp-input{font-size:24px; letter-spacing:12px; font-weight:800; text-align:center}
    .pl-submit{height:50px; border:none; border-radius:12px; font-weight:800; font-size:15px; width:100%; background:var(--navy-900); color:#fff; transition:background .15s, transform .15s}
    .pl-submit:hover:not(:disabled){background:var(--navy-800); transform:translateY(-1px)}
    .pl-submit:disabled{opacity:.65}
    .pl-link{color:var(--gold-600); font-weight:700; font-size:12.5px; text-decoration:none}
    .pl-link:hover{color:var(--navy-900); text-decoration:underline}
    .pl-hint{color:var(--ink-500); font-size:12px}
    .pl-card .btn-link{color:var(--blue-600); text-decoration:none; font-weight:700}
    .pl-card .btn-link:disabled{color:#9AA6AF}
    .pl-isms{margin:22px 0 0; text-align:center; color:#94A0A9; font-size:12px}
    .pl-card .form-check-input:checked{background-color:var(--navy-900); border-color:var(--navy-900)}

    /* پشتیبانی */
    #supportModal .modal-content{border:0; border-radius:18px; overflow:hidden; font-family:'Vazirmatn','Vazir',Tahoma,sans-serif}
    #supportModal .modal-header{background:linear-gradient(135deg,var(--navy-950,#0A2036),var(--navy-800,#123A5C)); color:#fff; border:0; padding:18px 22px}
    #supportModal .modal-title{color:#fff; font-size:16px; font-weight:800}
    #supportModal .btn-close{filter:invert(1); opacity:.85}
    #supportModal .modal-body{background:#F6F4EE; padding:20px 22px}
    .pl-contact{display:flex; align-items:center; gap:12px; background:#fff; border:1px solid #E3DFD2; border-radius:12px; padding:12px 14px; margin-bottom:10px}
    .pl-contact i{color:#C08A34; font-size:20px; width:26px; text-align:center}
    .pl-contact .label{color:#5C6C78; font-size:12px}
    .pl-contact .number{color:#0D2C48; font-weight:700; font-size:14px; direction:ltr; text-align:right}

    @@media (max-width: 991px){
        .pl{grid-template-columns:1fr}
        .pl-brand{padding:24px 20px}
        .pl-hero{padding:22px 0 12px}
        .pl-hero h1{font-size:24px}
        .pl-features,.pl-wheel{display:none}
        .pl-form{padding:24px 16px 40px}
        .pl-card{padding:26px 20px}
    }
    /* موبایل: فرم بدون اسکرول طولانی در دسترس باشد */
    @@media (max-width: 575px){
        .pl-hero{padding:14px 0 6px}
        .pl-hero h1{font-size:20px; margin:8px 0 0}
        .pl-hero p{display:none}
        .pl-support{padding:7px 14px; font-size:12.5px}
    }
    @@media (prefers-reduced-motion: reduce){ .pl-submit{transition:none} }
</style>
}

<div class="pl">
    <section class="pl-brand" aria-label="معرفی پورتال">
        <svg class="pl-wheel" viewBox="0 0 200 200" fill="none" stroke="#fff" stroke-width="2" aria-hidden="true">
            <circle cx="100" cy="100" r="70"/><circle cx="100" cy="100" r="46"/><circle cx="100" cy="100" r="6" fill="#fff"/>
            <g><line x1="100" y1="8" x2="100" y2="192"/><line x1="8" y1="100" x2="192" y2="100"/><line x1="33" y1="33" x2="167" y2="167"/><line x1="167" y1="33" x2="33" y2="167"/></g>
            <circle cx="100" cy="30" r="8"/><circle cx="100" cy="170" r="8"/><circle cx="30" cy="100" r="8"/><circle cx="170" cy="100" r="8"/>
        </svg>
        <div class="pl-top">
            <div class="pl-org">
                <img src="~/assets/images/brand-logos/logo-pmo.png" alt="نشان اداره کل بنادر و دریانوردی استان هرمزگان" />
                <div><b>اداره کل بنادر و دریانوردی استان هرمزگان</b></div>
            </div>
            <a class="pl-home" href="/Portal"><i class="ti ti-home-2" aria-hidden="true"></i>صفحه‌ی اصلی پورتال</a>
        </div>
        <div class="pl-hero">
            <span class="pl-eyebrow">یک ورود، همه سامانه‌ها</span>
            <h1>به <em>پورتال داخلی</em> سازمان خوش آمدید</h1>
            <p>پورتال داخلی، درگاه یکپارچه‌ی کارکنان اداره کل برای دسترسی به سامانه‌های سازمانی است. به‌جای یادگرفتن نشانی و حساب جداگانه برای هر سامانه، پس از یک بار ورود، همه‌ی سامانه‌هایی را که مدیر برای شما فعال کرده است در یک صفحه می‌بینید و با یک کلیک وارد آن‌ها می‌شوید.</p>
            <p>اخبار و اطلاعیه‌های سازمان، بخشنامه‌ها، قوانین و فرم‌های اداری نیز همین‌جا در دسترس است. اگر به سامانه‌ای نیاز دارید که در فهرست شما نیست، می‌توانید از همین پورتال درخواست دسترسی ثبت کنید و پیگیری نتیجه آن را از بخش اعلان‌ها ببینید.</p>
            <ul class="pl-features">
                <li><i class="ti ti-apps" aria-hidden="true"></i>سامانه‌های اختصاصی من</li>
                <li><i class="ti ti-bell" aria-hidden="true"></i>اعلان‌ها و کارتابل درخواست دسترسی</li>
                <li><i class="ti ti-file-text" aria-hidden="true"></i>اطلاعیه‌ها، بخشنامه‌ها و فرم‌ها</li>
            </ul>
        </div>
        <button type="button" class="pl-support" data-bs-toggle="modal" data-bs-target="#supportModal"><i class="ti ti-headset" aria-hidden="true"></i>پشتیبانی</button>
    </section>

    <section class="pl-form">
        <div class="pl-card">
            <h2>ورود به حساب کاربری</h2>
            @* پیام‌ها مثل بقیه‌ی پورتال به‌صورت توست هم‌تم (wwwroot/js/portal-toast.js)؛ بدون JavaScript همان کادر قبلی نمایش داده می‌شود *@
            @{ var success = TempData["AuthenticationMessage"] as string ?? (Model.LoggedOut ? "با موفقیت از سیستم خارج شدید" : null); }
            <partial name="_PortalToasts" model='(success, Model.Error)' />
            <noscript>
                @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }
                @if (success is not null) { <p role="status" class="alert alert-success">@success</p> }
            </noscript>

            <form id="loginForm" method="post" autocomplete="off" asp-page="/Account/Login">
                <input type="hidden" asp-for="ReturnUrl" />
                @Html.AntiForgeryToken()
                <label for="loginMethod" class="form-label">روش ورود</label>
                <div class="pl-select mb-3">
                    <i class="ti ti-login-2" aria-hidden="true"></i>
                    <select asp-for="Method" id="loginMethod" class="form-select">
                        @if (Model.Methods.PasswordEnabled) { <option value="password">نام کاربری و رمز عبور</option> }
                        @if (Model.Methods.LdapEnabled) { <option value="ldap">حساب سازمانی (LDAP)</option> }
                        @if (Model.Methods.NationalIdSmsEnabled) { <option value="national-id-sms">کد ملی و پیامک</option> }
                    </select>
                </div>

                <div data-method-panel="credentials">
                    <div class="mb-3">
                        <label for="Username" class="form-label">نام کاربری</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-user" aria-hidden="true"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="نام کاربری خود را وارد کنید" autocomplete="username" required />
                        </div>
                    </div>
                    <div class="mb-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <label for="Password" class="form-label mb-1">رمز عبور</label>
                            @if (Model.Methods.ForgotPasswordEnabled) { <a class="pl-link mb-1" asp-page="/Account/ForgotPassword">فراموشی رمز عبور</a> }
                        </div>
                        <div class="input-group" id="Password-toggle">
                            <span class="input-group-text password-eye" role="button" title="نمایش رمز"><i class="ti ti-lock" aria-hidden="true"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور" autocomplete="current-password" required />
                        </div>
                    </div>
                </div>

                <div data-method-panel="national-id" hidden>
                    <div id="nationalIdStep" class="mb-2">
                        <label for="NationalId" class="form-label">کد ملی</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="ti ti-id" aria-hidden="true"></i></span>
                            <input asp-for="NationalId" class="form-control" inputmode="numeric" maxlength="10" dir="ltr" placeholder="۱۰ رقم" autocomplete="off" required />
                        </div>
                        <small class="pl-hint d-block mt-1"><i class="ti ti-message-2 me-1" aria-hidden="true"></i>کد تأیید به شماره همراه ثبت‌شده در سامانه پیامک می‌شود.</small>
                    </div>
                    <div id="codeStep" class="mb-2" hidden>
                        <label for="Code" class="form-label">کد تأیید پیامک‌شده</label>
                        <input asp-for="Code" class="form-control otp-input" inputmode="numeric" maxlength="6" dir="ltr" placeholder="------" autocomplete="one-time-code" aria-label="کد تأیید ۶ رقمی" required />
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button type="button" id="changeNationalId" class="btn btn-link p-0 fs-12"><i class="ti ti-arrow-right me-1" aria-hidden="true"></i>تغییر کد ملی</button>
                            <button type="button" id="resendCode" class="btn btn-link p-0 fs-12" disabled>ارسال دوباره <span id="resendTimer"></span></button>
                        </div>
                    </div>
                </div>

                <div id="securitySection" class="mt-3" style="direction:rtl;">
                    <dnt-captcha asp-captcha-generator-max="9999"
                                 asp-captcha-generator-min="1000"
                                 asp-captcha-generator-language="English"
                                 asp-captcha-generator-display-mode="ShowDigits"
                                 asp-use-relative-urls="true"
                                 asp-placeholder="کد امنیتی"
                                 asp-text-box-class="form-control captchaInput"
                                 asp-validation-error-message="کد امنیتی اشتباه است"
                                 asp-too-many-requests-error-message="درخواست‌های زیاد! یک دقیقه صبر کنید"
                                 asp-font-name="Tahoma"
                                 asp-font-size="28"
                                 asp-fore-color="#0D2C48"
                                 asp-back-color="#F6F4EE"
                                 asp-text-box-template="<label class='form-label'>کد امنیتی{0}</label>"
                                 asp-validation-message-class="text-danger"
                                 asp-show-refresh-button="true"
                                 asp-refresh-button-class="ti ti-refresh btn captcha-refresh" />
                </div>

                <div class="form-check mt-3">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberMe" type="checkbox" />
                    <label class="form-check-label fs-13" for="rememberMe">مرا به خاطر بسپار</label>
                </div>

                <button type="submit" id="loginBtn" class="pl-submit mt-3" disabled="@(!Model.AnyMethodEnabled)">
                    <span id="loginText">ورود</span>
                    <span id="loginSpinner" class="spinner-border spinner-border-sm ms-2 d-none" aria-hidden="true"></span>
                </button>
            </form>
            <p class="pl-isms"><i class="ti ti-shield-check me-1" aria-hidden="true"></i>پیروی از ISMS — تمامی فعالیت‌ها ثبت می‌شود</p>
        </div>
    </section>
</div>

<div class="modal fade" id="supportModal" tabindex="-1" aria-labelledby="supportTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="supportTitle"><i class="ti ti-headset me-2" aria-hidden="true"></i>پشتیبانی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="بستن"></button>
            </div>
            <div class="modal-body">
                <div class="pl-contact"><i class="ti ti-phone" aria-hidden="true"></i><div><div class="label">فاوا — نرم‌افزار (ساعات اداری)</div><div class="number">۰۹۹۴۰۶۵۷۷۵۳ — فاطمه صادقی</div></div></div>
                <div class="pl-contact"><i class="ti ti-phone" aria-hidden="true"></i><div><div class="label">داخلی</div><div class="number">۴۶۴۷</div></div></div>
                <div class="pl-contact"><i class="ti ti-mail" aria-hidden="true"></i><div><div class="label">ایمیل</div><div class="number">sdi10fateme@@gmail.com</div></div></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/portal-toast.js" asp-append-version="true"></script>
    <script src="~/js/login-form.js" asp-append-version="true"></script>
}

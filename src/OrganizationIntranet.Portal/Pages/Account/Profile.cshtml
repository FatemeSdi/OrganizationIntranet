@page
@model ProfileModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "پروفایل من";
    ViewData["PortalNav"] = "profile";
    Layout = "_LayoutPortal";
}
@section Styles {
    <style>
        .pp-identity { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; }
        .pp-identity .pp-avatar { width: 76px; height: 76px; font-size: 26px; box-shadow: 0 0 0 5px #fff, 0 0 0 7px rgba(214, 162, 76, .45); }
        .pp-identity h2 { font-size: 20px; font-weight: 800; margin: 0 0 6px; color: var(--navy-900); }
        .pp-roles { display: flex; flex-wrap: wrap; gap: 6px; }
        .pp-role { font-size: 12px; font-weight: 700; padding: 3px 12px; border-radius: 999px; background: rgba(214, 162, 76, .14); color: #8A6320; }
        .pp-identity-actions { display: flex; gap: 10px; margin-inline-start: auto; flex-wrap: wrap; }
        @@media (max-width: 767px) { .pp-identity-actions { margin-inline-start: 0; width: 100%; } .pp-identity-actions .pp-btn { flex: 1; } }
    </style>
}

<section class="pp-card pp-identity" aria-label="مشخصات کاربر">
    <span class="pp-avatar" aria-hidden="true">@Model.Initials</span>
    <div>
        <h2>@Model.DisplayName</h2>
        <div class="pp-roles">@foreach (var role in Model.RoleNames.Split("، ", StringSplitOptions.RemoveEmptyEntries)) { <span class="pp-role">@role</span> }</div>
    </div>
    <div class="pp-identity-actions">
        <a class="pp-btn pp-btn-outline" href="/Account/Settings"><i class="ti ti-settings" aria-hidden="true"></i>تنظیمات حساب</a>
        <a class="pp-btn pp-btn-soft" asp-page="/Account/Security"><i class="ti ti-shield-lock" aria-hidden="true"></i>امنیت و Google Authenticator</a>
    </div>
</section>

<section class="pp-section" aria-labelledby="info-title">
    <h2 class="pp-section-title" id="info-title">اطلاعات حساب</h2>
    <div class="pp-grid">
        <div class="pp-item"><i class="ti ti-user" aria-hidden="true"></i><div class="min-w-0"><span>نام کاربری</span><b dir="ltr">@Model.Username</b></div></div>
        <div class="pp-item"><i class="ti ti-id" aria-hidden="true"></i><div class="min-w-0"><span>کد ملی</span><b dir="ltr">@(Model.NationalId ?? "—")</b></div></div>
        <div class="pp-item"><i class="ti ti-device-mobile" aria-hidden="true"></i><div class="min-w-0"><span>شماره همراه</span><b dir="ltr">@(Model.MobileNumber ?? "—")</b></div></div>
        <div class="pp-item"><i class="ti ti-mail" aria-hidden="true"></i><div class="min-w-0"><span>ایمیل</span><b dir="ltr">@(Model.Email ?? "—")</b></div></div>
        <div class="pp-item"><i class="ti ti-calendar" aria-hidden="true"></i><div class="min-w-0"><span>تاریخ عضویت</span><b>@Model.CreatedAt.ToPersianDate()</b></div></div>
        <div class="pp-item"><i class="ti ti-clock" aria-hidden="true"></i><div class="min-w-0"><span>آخرین ورود</span><b>@(Model.LastLogin.HasValue ? Model.LastLogin.ToPersianDate() : "—")</b></div></div>
    </div>
</section>

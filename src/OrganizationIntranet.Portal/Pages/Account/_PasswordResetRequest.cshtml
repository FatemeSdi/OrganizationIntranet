@model OrganizationIntranet.Pages.Account.ForgotPasswordModel
<form method="post">
<label asp-for="Username">نام کاربری</label>
<input asp-for="Username" class="form-control mb-3" autocomplete="username" maxlength="100" required />
<dnt-captcha asp-captcha-generator-max="9999" asp-captcha-generator-min="1000"
 asp-captcha-generator-language="English" asp-captcha-generator-display-mode="ShowDigits"
 asp-use-relative-urls="true" asp-placeholder="کد امنیتی" asp-text-box-class="form-control mb-3"
 asp-text-box-template="<label class='d-block'>کد امنیتی{0}</label>"
 asp-font-name="Tahoma" asp-font-size="28" asp-show-refresh-button="true" />
<button type="submit" class="btn btn-primary w-100">ارسال کد بازیابی</button>
</form>

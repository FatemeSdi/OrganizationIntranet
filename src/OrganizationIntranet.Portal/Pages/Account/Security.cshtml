@page
@model OrganizationIntranet.Pages.Account.SecurityModel
@{
    ViewData["Title"] = "امنیت حساب و Google Authenticator";
    ViewData["PortalNav"] = "settings";
    ViewData["ParentTitle"] = "تنظیمات حساب";
    ViewData["ParentUrl"] = "/Account/Settings";
    Layout = "_LayoutPortal";
    var step = Model.Status.AuthenticatorConfigured ? 3 : Model.Setup is not null ? 2 : 1;
}
@section Styles {
    <style>
        .pp-steps { display: flex; gap: 10px; list-style: none; margin: 0 0 20px; padding: 0; flex-wrap: wrap; }
        .pp-steps li { display: flex; align-items: center; gap: 8px; font-size: 13.5px; font-weight: 700; color: var(--ink-500); }
        .pp-steps li + li::before { content: ""; width: 34px; height: 2px; background: var(--line); }
        .pp-steps li span { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; background: var(--sand-100); }
        .pp-steps li.is-current { color: var(--navy-900); }
        .pp-steps li.is-current span { background: var(--navy-900); color: #fff; }
        .pp-steps li.is-done span { background: rgba(46, 139, 87, .14); color: var(--success); }
        .pp-secret { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 10px 0 4px; }
        .pp-secret code { font-size: 16px; letter-spacing: .12em; padding: 10px 14px; border-radius: 12px; border: 1px dashed var(--gold-500); background: #FBFAF6; word-break: break-all; }
        .pp-code { max-width: 230px; text-align: center; font-size: 20px; font-weight: 800; letter-spacing: .4em; }
    </style>
}

<div class="pp-grid" style="margin-bottom:22px">
    <div class="pp-item"><i class="ti ti-lock-check" aria-hidden="true"></i><div><span>ورود دومرحله‌ای</span><b>@(Model.Status.TwoFactorRequired ? "برای همه الزامی است" : "اختیاری")</b></div></div>
    <div class="pp-item"><i class="ti ti-device-mobile-check" aria-hidden="true"></i><div><span>Google Authenticator</span><b>@(Model.Status.AuthenticatorConfigured ? "تنظیم شده" : Model.Status.AuthenticatorAvailable ? "هنوز تنظیم نشده" : "غیرفعال توسط مدیر")</b></div></div>
    <div class="pp-item"><i class="ti ti-message-2" aria-hidden="true"></i><div><span>تأیید با پیامک</span><b>@(Model.Status.SmsAvailable ? "در دسترس" : "در دسترس نیست")</b></div></div>
</div>

<section class="pp-card" aria-labelledby="auth-title">
    <h2 class="pp-section-title" id="auth-title">راه‌اندازی Google Authenticator</h2>
    <div asp-validation-summary="All" class="pp-alert pp-alert-error" role="alert"></div>

    @if (Model.Status.AuthenticatorConfigured)
    {
        <div class="pp-empty">
            <div class="pp-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>
            <b>Google Authenticator برای حساب شما تنظیم شده است</b>
            اگر دستگاه را از دست دادید، از پیامک فعال یا پشتیبانی سازمان کمک بگیرید.
        </div>
    }
    else if (!Model.Status.AuthenticatorAvailable)
    {
        <div class="pp-empty"><b>این روش توسط مدیر سامانه غیرفعال شده است</b></div>
    }
    else
    {
        <ol class="pp-steps" aria-label="مراحل راه‌اندازی">
            <li class="@(step == 1 ? "is-current" : "is-done")"><span>۱</span>تأیید رمز فعلی</li>
            <li class="@(step == 2 ? "is-current" : "")"><span>۲</span>ثبت کلید و تأیید کد</li>
        </ol>
        @if (Model.Setup is not null)
        {
            <form method="post" asp-page-handler="Confirm" data-busy>
                <p class="pp-hint" style="font-size:13.5px">در Google Authenticator «وارد کردن کلید راه‌اندازی» را بزنید، نوع کلید را «مبتنی بر زمان» بگذارید و این کلید را وارد کنید (اعتبار ۵ دقیقه):</p>
                <div class="pp-secret">
                    <code dir="ltr" id="authSecret">@Model.Setup.Secret</code>
                    <button type="button" class="pp-btn pp-btn-soft pp-btn-sm" id="copySecret"><i class="ti ti-copy" aria-hidden="true"></i>رونوشت</button>
                    <span class="pp-hint" id="copyStatus" role="status"></span>
                </div>
                <div class="pp-field" style="margin-top:18px">
                    <label asp-for="Code">کد ۶ رقمی برنامه</label>
                    <input asp-for="Code" class="pp-input pp-code" dir="ltr" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required />
                </div>
                <div class="pp-actions-row">
                    <button class="pp-btn pp-btn-primary" type="submit">تأیید راه‌اندازی</button>
                    <a asp-page="/Account/Security" class="pp-btn pp-btn-soft">شروع دوباره</a>
                </div>
            </form>
        }
        else
        {
            <form method="post" data-busy>
                <div class="pp-form-grid">
                    <div class="pp-field"><label asp-for="LoginMethod">روش تأیید رمز</label><select asp-for="LoginMethod" class="pp-select">
                        @if (Model.Methods.PasswordEnabled) { <option value="password">رمز محلی</option> }
                        @if (Model.Methods.LdapEnabled) { <option value="ldap">حساب سازمانی (LDAP)</option> }
                    </select></div>
                    <div class="pp-field"><label asp-for="Password">رمز فعلی</label><input asp-for="Password" type="password" class="pp-input" autocomplete="current-password" required /></div>
                </div>
                <div class="pp-actions-row">
                    <button class="pp-btn pp-btn-primary" type="submit">ادامه و ساخت کلید</button>
                    <a href="/Account/Settings" class="pp-btn pp-btn-soft">بازگشت</a>
                </div>
            </form>
        }
    }
</section>

@section Scripts {
    <script>
        document.getElementById('copySecret')?.addEventListener('click', () => {
            const status = document.getElementById('copyStatus');
            const text = document.getElementById('authSecret').textContent.trim();
            (navigator.clipboard ? navigator.clipboard.writeText(text) : Promise.reject())
                .then(() => status.textContent = 'رونوشت شد', () => status.textContent = 'رونوشت ممکن نشد؛ کلید را دستی وارد کنید');
        });
    </script>
}

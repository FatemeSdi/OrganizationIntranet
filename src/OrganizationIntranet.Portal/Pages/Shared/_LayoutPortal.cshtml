@* پوسته‌ی صفحه‌های داخلی پورتال (کاربر واردشده): هدر با منوی حساب، سربرگ صفحه و پاورقی؛ هم‌خوان با تم صفحه‌ی اصلی.
   صفحه‌ها ViewData["Title"]، ViewData["Subtitle"] و ViewData["PortalNav"] (کلید منوی فعال) را تعیین می‌کنند. *@
<!DOCTYPE html>
<html dir="rtl" lang="fa">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پورتال داخلی</title>
    <link href="~/assets/images/brand-logos/favicon.ico" rel="icon" type="image/x-icon" />
    <link href="~/assets/css/vazir-font.css" rel="stylesheet" />
    <link href="~/assets/css/icons.css" rel="stylesheet" />
    <link href="~/css/portal-shell.css" rel="stylesheet" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="pp-body">
    <a href="#main" class="pp-skip">رفتن به محتوای اصلی</a>
    @await Component.InvokeAsync("PortalHeader", new { active = ViewData["PortalNav"] as string })
    <main id="main">
        <section class="pp-hero">
            <div class="pp-container">
                <nav class="pp-crumb" aria-label="مسیر صفحه"><a href="/Portal">پورتال داخلی</a>@if (ViewData["ParentTitle"] is string parent) { <text> / <a href="@ViewData["ParentUrl"]">@parent</a></text> }</nav>
                <h1>@ViewData["Title"]</h1>
                @if (ViewData["Subtitle"] is string subtitle) { <p>@subtitle</p> }
            </div>
        </section>
        <div class="pp-container pp-main">
            @RenderBody()
        </div>
    </main>
    <footer class="pp-site">تمامی حقوق متعلق به اداره کل بنادر و دریانوردی استان هرمزگان محفوظ می‌باشد.</footer>
    <script src="~/js/portal-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

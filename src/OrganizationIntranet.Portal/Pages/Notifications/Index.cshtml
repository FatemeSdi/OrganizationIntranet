@page
@model OrganizationIntranet.Pages.Notifications.IndexModel
@using OrganizationIntranet.Contracts
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "اعلان‌ها";
    ViewData["PortalNav"] = "notifications";
    Layout = "_LayoutPortal";
    var c = Model.Center;
    (string? Key, string Label, int Count)[] tabs = [(null, "همه", c.AllCount), (NotificationCenter.Unread, "خوانده‌نشده", c.UnreadCount), (NotificationCenter.Read, "خوانده‌شده", c.ReadCount)];
    (string? Key, string Label)[] sources = [(null, "همه‌ی منابع"), (NotificationCenter.SystemKind, "سامانه‌ها"), (NotificationCenter.RequestKind, "درخواست‌های دسترسی")];
    var periods = new List<(int? Days, string Label)> { (null, "همه‌ی زمان‌ها") };
    periods.AddRange(NotificationCenter.Periods.Select(p => ((int?)p.Days, p.Label)));
    var filtered = Model.Source is not null || Model.Days is not null;
}
@section Styles {
    <style>
        .pp-list-item form { margin: 0; }
    </style>
}

<section class="pp-card" aria-label="فهرست اعلان‌ها">
    <partial name="_PortalToasts" model='(TempData["NotificationsMessage"] as string, (string?)null)' />

    <div class="pp-filters">
        <div class="pp-filter-group">
            <span class="pp-filter-label" id="source-label">منبع</span>
            <nav class="pp-chips" aria-labelledby="source-label">
                @foreach (var s in sources)
                {
                    <a asp-all-route-data="Model.Route(source: s.Key)" class="@(Model.Source == s.Key ? "active" : "")" aria-current="@(Model.Source == s.Key ? "true" : null)">@s.Label</a>
                }
            </nav>
        </div>
        @if (c.UnreadCount > 0)
        {
            <form method="post" asp-page-handler="ReadAll" asp-all-route-data="Model.Route()" data-busy>
                <button type="submit" class="pp-btn pp-btn-soft pp-btn-sm"><i class="ti ti-checks" aria-hidden="true"></i>خواندن همه</button>
            </form>
        }
    </div>
    <div class="pp-filter-group">
        <span class="pp-filter-label" id="period-label">بازه</span>
        <nav class="pp-chips" aria-labelledby="period-label">
            @foreach (var p in periods)
            {
                <a asp-all-route-data="Model.Route(days: p.Days)" class="@(Model.Days == p.Days ? "active" : "")" aria-current="@(Model.Days == p.Days ? "true" : null)">@p.Label</a>
            }
        </nav>
    </div>

    <nav class="pp-tabs" aria-label="وضعیت اعلان" style="margin-top:14px">
        @foreach (var t in tabs)
        {
            <a asp-all-route-data="Model.Route(tab: t.Key)" class="@(Model.Tab == t.Key ? "active" : "")" aria-current="@(Model.Tab == t.Key ? "page" : null)">@t.Label <span class="pp-tab-count">@t.Count</span></a>
        }
    </nav>

    @if (c.Items.Count == 0)
    {
        <div class="pp-empty">
            <div class="pp-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 8a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z"/><path d="M10 20a2 2 0 0 0 4 0"/></svg></div>
            <b>@(Model.Tab == NotificationCenter.Unread ? "اعلان خوانده‌نشده‌ای ندارید" : "اعلانی وجود ندارد")</b>
            @if (filtered) { <a asp-all-route-data="Model.Route(source: null, days: null)" class="pp-link">حذف فیلترها</a> }
        </div>
    }
    <div class="pp-list">
        @foreach (var n in c.Items)
        {
            var isRequest = n.Kind == NotificationCenter.RequestKind;
            <article class="pp-list-item @(n.Unread ? "is-unread" : "")">
                <span class="pp-list-icon @(isRequest ? "is-gold" : "")" aria-hidden="true">
                    @if (isRequest) { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg> }
                    else { <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg> }
                </span>
                <div class="pp-list-body">
                    <div class="pp-list-top">
                        <span class="pp-list-source">@(isRequest ? "درخواست دسترسی · " : "")@n.Source</span>
                        <span class="pp-list-time">@n.CreatedAt.ToPersianDate()</span>
                    </div>
                    <h3 class="pp-list-title">@n.Title</h3>
                    <div class="pp-list-actions">
                        @if (isRequest)
                        {
                            <form method="post" asp-page-handler="ReadAlert" asp-route-id="@n.Id"><button type="submit" class="pp-btn pp-btn-outline pp-btn-sm">مشاهده در کارتابل نظارت</button></form>
                        }
                        else if (n.HasDestination)
                        {
                            <form method="post" asp-page-handler="Open" asp-route-id="@n.Id"><button type="submit" class="pp-btn pp-btn-outline pp-btn-sm">مشاهده در سامانه</button></form>
                        }
                    </div>
                </div>
                @if (n.Unread) { <span class="pp-unread-dot" title="خوانده‌نشده"><span class="pp-visually-hidden">خوانده‌نشده</span></span> }
            </article>
        }
    </div>

    @if (c.TotalPages > 1)
    {
        <div class="pp-pager">
            <span>صفحه @Model.PageNumber از @c.TotalPages · @c.Total اعلان</span>
            <nav aria-label="صفحه‌بندی اعلان‌ها">
                @if (Model.PageNumber > 1) { <a asp-all-route-data="Model.Route(page: Model.PageNumber - 1)" class="pp-btn pp-btn-soft pp-btn-sm">قبلی</a> }
                @if (Model.PageNumber < c.TotalPages) { <a asp-all-route-data="Model.Route(page: Model.PageNumber + 1)" class="pp-btn pp-btn-soft pp-btn-sm">بعدی</a> }
            </nav>
        </div>
    }
</section>

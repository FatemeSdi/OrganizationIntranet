          <h2 class="section-title">سامانه‌های در اختیار شما</h2>
        </div>
        <p class="section-desc">سامانه‌های عمومی و سامانه‌های تخصیص‌یافته به شما یا نقش‌های فعال شما نمایش داده می‌شوند. شیوه ورود و شبکه دسترسی هر سامانه روی کارت مشخص است.</p>
      </div>
      <div class="systems-grid" id="systemsGrid">
        @foreach (var app in Model.Applications)
        {
          <a class="sys-card" href="@app.Url" aria-disabled="@(app.Url is null ? "true" : "false")" data-name="@app.Name @app.Description">
            <div class="sys-top">
              <div class="sys-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/assets/images/application-icons.svg#@app.Icon"></use></svg></div>
              @if (app.UnreadCount > 0) { <span class="sys-unread">@app.UnreadCount جدید</span> }
            </div>
            <h3>@app.Name</h3><p>@app.Description</p>
            <small>@(app.IsInternetAccessible ? "قابل دسترسی از اینترنت" : "فقط اینترانت") · @(app.IsPublic ? "عمومی" : "اختصاص‌یافته")</small>
            <span class="go">@(app.Url is null ? "آدرس سامانه ثبت نشده است" : app.RequiresLogin ? "ورود با لاگین" : "ورود بدون نیاز به لاگین")</span>

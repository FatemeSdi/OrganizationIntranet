          <article class="news-card@(i == 0 ? " is-active" : "")" aria-roledescription="slide" aria-label="@(i + 1) از @news.Count">
            <a href="/Publications/Details/@item.PublicationId">
              <div class="news-media" data-kind="@item.Kind">

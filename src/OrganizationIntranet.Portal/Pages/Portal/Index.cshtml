        }
        </div>
        @if (news.Count > 1)
        {
        <div class="news-dots" role="group" aria-label="انتخاب خبر">
          @for (var i = 0; i < news.Count; i++) { <button type="button" data-news-dot="@i" aria-label="خبر @(i + 1)" aria-current="@(i == 0 ? "true" : "false")"></button> }

@page
@model IndexModel
@{
    ViewData["Title"] = "پورتال داخلی | اداره کل بنادر و دریانوردی هرمزگان";
    Layout = "_LayoutApp";
}
@section Styles {
    <link href="~/assets/css/vazir-font.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/portal-access-requests.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/portal-toast.css" asp-append-version="true" />
<style>
  :root{
    --navy-950:#0A2036;
    --navy-900:#0D2C48;
    --navy-800:#123A5C;
    --blue-600:#1573B8;
    --blue-500:#2489D1;
    --teal-500:#17A6B6;
    --gold-500:#D6A24C;
    --gold-600:#C08A34;
    --sand-50:#F6F4EE;
    --sand-100:#EFEBE0;
    --card:#FFFFFF;
    --ink-900:#152230;
    --ink-700:#33434F;
    --ink-500:#5C6C78;
    --line:#E3DFD2;
    --danger:#D65B4C;
    --radius:16px;
    --shadow:0 8px 28px -12px rgba(10,32,54,.18);
    --shadow-lg:0 20px 46px -18px rgba(10,32,54,.32);
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    margin:0;
    font-family:'Vazirmatn', 'Vazir', Tahoma, sans-serif;
    background:var(--sand-50);
    color:var(--ink-900);
    line-height:1.7;
  }
  a{color:inherit; text-decoration:none}
  ul{margin:0; padding:0; list-style:none}
  button{font-family:inherit}
  img{max-width:100%; display:block}
  .container{max-width:1240px; margin:0 auto; padding:0 28px}
  .skip-link{position:absolute; right:-999px; top:0; background:var(--gold-500); color:var(--navy-950); padding:10px 16px; border-radius:0 0 8px 8px; z-index:999; font-weight:700}
  .skip-link:focus{right:0}

  /* ---------- header ---------- */
  header.site{
    position:sticky; top:0; z-index:80;
    background:rgba(10,32,54,.97);
    backdrop-filter:blur(6px);
    border-bottom:1px solid rgba(255,255,255,.08);
  }
  .header-inner{display:flex; align-items:center; gap:20px; height:78px}
  .brand{display:flex; align-items:center; gap:14px; color:#fff}
  .brand img{height:42px; width:auto; filter:brightness(0) invert(1)}
  .brand-text{display:flex; flex-direction:column; line-height:1.3}
  .brand-text b{font-size:15.5px; font-weight:800; letter-spacing:.2px}
  .brand-text span{font-size:11.5px; color:#AFC4D6; font-weight:400}
  .template-badge{
    display:inline-flex; align-items:center; gap:6px; background:rgba(214,162,76,.14); color:var(--gold-500);
    border:1px solid rgba(214,162,76,.35); font-size:11px; font-weight:700; padding:4px 10px; border-radius:100px;
    margin-inline-start:6px;
  }
  .template-badge span.dot{width:5px; height:5px; border-radius:50%; background:var(--gold-500); display:inline-block}

  nav.main{display:flex; gap:4px; margin-inline-start:14px}
  nav.main a{
    color:#D9E4EC; font-size:14.5px; font-weight:500; padding:10px 14px; border-radius:10px;
    transition:background .2s, color .2s;
  }
  nav.main a:hover, nav.main a:focus-visible{background:rgba(255,255,255,.08); color:#fff}
  nav.main a.active{background:var(--gold-500); color:var(--navy-950); font-weight:700}

  .header-actions{display:flex; align-items:center; gap:12px; margin-inline-start:auto; position:relative}
  .login-btn{display:inline-flex; align-items:center; gap:8px; padding:9px 20px; border-radius:999px; background:var(--gold-500); color:var(--navy-950); font-weight:800; font-size:14px; transition:background .15s}
  .login-btn:hover{background:var(--gold-600); color:#fff}
  .login-btn:focus-visible{outline:2px solid #fff; outline-offset:2px}
  .hero-login{display:inline-flex; align-items:center; gap:8px; margin:0 0 22px; padding:10px 24px; border-radius:999px; background:var(--gold-500); color:var(--navy-950); font-weight:800; font-size:15px}
  .hero-login:hover{background:var(--gold-600); color:#fff}

  /* notification bell + dropdown */
  .bell-wrap{position:relative}
  .icon-btn{
    width:40px; height:40px; border-radius:11px; display:grid; place-items:center;
    background:rgba(255,255,255,.06); color:#EDEDED; border:1px solid rgba(255,255,255,.1);
    cursor:pointer; position:relative;
  }
  .icon-btn:hover{background:rgba(255,255,255,.14)}
  .badge-dot{
    position:absolute; top:6px; left:6px; min-width:16px; height:16px; padding:0 4px; border-radius:100px;
    background:var(--danger); color:#fff; font-size:10px; font-weight:800; display:grid; place-items:center;
    border:2px solid var(--navy-950);
  }
  .dropdown{
    position:absolute; top:calc(100% + 12px); left:0; width:360px; background:#fff; color:var(--ink-900);
    border-radius:16px; box-shadow:var(--shadow-lg); border:1px solid var(--line); overflow:hidden;
    opacity:0; visibility:hidden; transform:translateY(-8px); transition:opacity .16s, transform .16s, visibility .16s;
    z-index:100;
  }
  .dropdown.open{opacity:1; visibility:visible; transform:translateY(0)}
  .dropdown-head{
    display:flex; justify-content:space-between; align-items:center; padding:16px 18px; border-bottom:1px solid var(--line);
  }
  .dropdown-head b{font-size:14.5px}
  .dropdown-head a{font-size:12.5px; color:var(--blue-600); font-weight:700}
  .notif-list{max-height:340px; overflow-y:auto}
  .notif-item{
    display:flex; gap:12px; padding:14px 18px; border-bottom:1px solid var(--line); align-items:flex-start;
  }
  .notif-item:last-child{border-bottom:none}
  .notif-item .src-icon{
    flex-shrink:0; width:36px; height:36px; border-radius:10px; display:grid; place-items:center; color:#fff;
    background:linear-gradient(135deg,var(--navy-900),var(--blue-600));
  }
  .notif-item .src-icon svg{width:18px; height:18px}
  .notif-item.unread{background:#F7FAFD}
  .notif-body{flex:1; min-width:0}
  .notif-body .top-line{display:flex; justify-content:space-between; gap:8px}
  .notif-body .source{font-size:11px; color:var(--blue-600); font-weight:700}
  .notif-body .time{font-size:11px; color:var(--ink-500); white-space:nowrap}
  .notif-body h5{margin:3px 0 2px; font-size:13.5px; font-weight:700}
  .notif-body p{margin:0; font-size:12.5px; color:var(--ink-500); overflow:hidden; text-overflow:ellipsis; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical}
  .dropdown-foot{padding:12px 18px; text-align:center; border-top:1px solid var(--line)}
  .dropdown-foot a{font-size:13px; font-weight:700; color:var(--blue-600)}
  .dropdown-unread{display:inline-block; margin-inline-start:8px; font-size:11px; font-weight:700; color:var(--danger); background:rgba(214,91,76,.1); padding:2px 8px; border-radius:99px; vertical-align:middle}
  .read-all-btn{display:inline-flex; align-items:center; gap:6px; padding:6px 12px; border-radius:99px; border:1px solid var(--line); background:var(--sand-50); color:var(--navy-900); font-size:12px; font-weight:700; cursor:pointer; transition:background .15s, border-color .15s}
  .read-all-btn:hover{background:#fff; border-color:var(--gold-500)}
  .read-all-btn svg{width:15px; height:15px; color:var(--success, #2E8B57)}
  .dropdown-head form{margin:0}

  /* profile chip + dropdown */
  .profile-wrap{position:relative}
  .user-chip{
    display:flex; align-items:center; gap:10px; padding:6px 10px 6px 6px; background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.1); border-radius:100px; color:#fff; cursor:pointer;
  }
  .user-chip:hover{background:rgba(255,255,255,.12)}
  .user-chip .avatar{
    width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,var(--teal-500),var(--blue-600));
    display:grid; place-items:center; font-size:12px; font-weight:800; flex-shrink:0;
  }
  .user-chip .info{line-height:1.25; text-align:right}
  .user-chip .info b{font-size:13px; display:block}
  .user-chip .info small{color:#AFC4D6; font-size:11px; font-weight:400}
  .user-chip .chev{width:14px; height:14px; color:#AFC4D6; transition:transform .16s}
  .user-chip[aria-expanded="true"] .chev{transform:rotate(180deg)}

  .profile-menu{
    position:absolute; top:calc(100% + 12px); left:0; width:270px; background:#fff; color:var(--ink-900);
    border-radius:16px; box-shadow:var(--shadow-lg); border:1px solid var(--line); overflow:hidden;
    opacity:0; visibility:hidden; transform:translateY(-8px); transition:opacity .16s, transform .16s, visibility .16s;
    z-index:100;
  }
  .profile-menu.open{opacity:1; visibility:visible; transform:translateY(0)}
  .profile-menu .pm-head{display:flex; align-items:center; gap:12px; padding:18px; background:var(--sand-100)}
  .profile-menu .pm-head .avatar{
    width:44px; height:44px; border-radius:50%; background:linear-gradient(135deg,var(--teal-500),var(--blue-600));
    display:grid; place-items:center; color:#fff; font-weight:800; font-size:14px; flex-shrink:0;
  }
  .profile-menu .pm-head b{display:block; font-size:14.5px}
  .profile-menu .pm-head span{font-size:12px; color:var(--ink-500)}
  .profile-menu ul{padding:8px}
  .profile-menu ul li a{
    display:flex; align-items:center; gap:12px; padding:10px 12px; font-size:13.5px; border-radius:10px; color:var(--ink-700);
  }
  .profile-menu ul li a:hover{background:var(--sand-100)}
  .profile-menu ul li a svg{width:17px; height:17px; color:var(--ink-500); flex-shrink:0}
  .profile-menu ul li a.pm-danger{color:var(--danger)}
  .profile-menu ul li a.pm-danger svg{color:var(--danger)}

  /* ---------- hero (personalized) ---------- */
  .hero{
    position:relative;
    background:radial-gradient(1100px 480px at 18% -10%, #163F63 0%, transparent 60%),
               linear-gradient(160deg, var(--navy-950) 0%, var(--navy-900) 55%, var(--navy-800) 100%);
    color:#fff; overflow:hidden; padding:56px 0 40px;
  }
  .hero-wheel{
    position:absolute; inset-inline-end:-140px; top:-110px; width:520px; height:520px; opacity:.13;
    animation:spin 90s linear infinite;
  }
  @@media (prefers-reduced-motion: reduce){ .hero-wheel{animation:none} }
  @@keyframes spin{from{transform:rotate(0)} to{transform:rotate(360deg)}}
  .hero-grid{position:relative; display:grid; grid-template-columns:1.15fr .85fr; gap:40px; align-items:center}
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px; color:var(--gold-500); font-weight:700; font-size:13px;
    letter-spacing:.3px; margin-bottom:16px;
  }
  .eyebrow::before{content:""; width:26px; height:2px; background:var(--gold-500); display:inline-block}
  h1.hero-title{font-size:clamp(28px, 3.6vw, 42px); font-weight:900; margin:0 0 8px; line-height:1.3; letter-spacing:-.4px}
  h1.hero-title em{font-style:normal; color:var(--gold-500)}
  .hero-role{font-size:15px; color:#C6D5E1; margin:0 0 26px; font-weight:400}
  .hero-role b{color:#fff; font-weight:700}
  .hero-search{
    display:flex; align-items:center; gap:10px; background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.16); border-radius:14px; padding:6px 8px 6px 18px; max-width:560px;
  }
  .hero-search input{flex:1; background:transparent; border:0; outline:0; color:#fff; font-family:inherit; font-size:15px; padding:12px 4px}
  .hero-search input::placeholder{color:#9CB1C1}
  .hero-search button{
    background:var(--gold-500); color:var(--navy-950); border:0; border-radius:10px; padding:12px 22px;
    font-weight:800; font-size:14.5px; cursor:pointer; white-space:nowrap;
  }
  .hero-search button:hover{background:#e2b160}

  .hero-card{background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:20px; padding:26px; backdrop-filter:blur(4px)}
  .hero-card h3{margin:0 0 4px; font-size:14px; color:#AFC4D6; font-weight:600}
  .hero-card .big{font-size:15px; font-weight:700; margin-bottom:18px; color:#fff}
  .stat-row{display:flex; justify-content:space-between; gap:10px}
  .stat{text-align:center; flex:1}
  .stat b{display:block; font-size:26px; font-weight:900; color:var(--gold-500)}
  .stat span{font-size:11.5px; color:#B8C9D6}
  .stat + .stat{border-inline-start:1px solid rgba(255,255,255,.14)}

  .wave{display:block; width:100%; height:64px; margin-bottom:-2px}

  /* ---------- section shell ---------- */
  section{padding:60px 0}
  .section-head{display:flex; justify-content:space-between; align-items:flex-end; gap:20px; margin-bottom:30px; flex-wrap:wrap}
  .section-head .eyebrow{color:var(--blue-600)}
  .section-head .eyebrow::before{background:var(--blue-600)}
  h2.section-title{font-size:clamp(21px,2.4vw,28px); font-weight:800; margin:0; letter-spacing:-.3px}

  /* ---------- systems grid (role-based) ---------- */
  .systems-grid{display:grid; grid-template-columns:repeat(3, 1fr); gap:20px}
  .sys-card{
    background:var(--card); border:1px solid var(--line); border-radius:var(--radius); padding:22px;
    display:flex; flex-direction:column; gap:12px; transition:transform .18s, box-shadow .18s, border-color .18s; position:relative;
  }
  .sys-card:hover{transform:translateY(-4px); box-shadow:var(--shadow); border-color:transparent}
  .sys-top{display:flex; align-items:flex-start; justify-content:space-between; gap:10px}
  .sys-icon{
    width:46px; height:46px; border-radius:12px; display:grid; place-items:center;
    background:linear-gradient(135deg, var(--navy-900), var(--blue-600)); color:#fff; flex-shrink:0;
  }
  .sys-icon svg{width:23px; height:23px}
  .sys-unread{
    background:var(--danger); color:#fff; font-size:11px; font-weight:800; border-radius:100px; padding:2px 8px; height:fit-content;
  }
  .sys-card h3{font-size:16px; font-weight:700; margin:0}
  .sys-card p{font-size:13px; color:var(--ink-500); margin:0; flex:1}
  .sys-card .go{display:inline-flex; align-items:center; gap:6px; font-size:13px; font-weight:700; color:var(--blue-600); margin-top:auto}
  .sys-card .go svg{width:15px; height:15px; transform:scaleX(-1)}
  .sys-card[hidden]{display:none}
  .no-results{display:none; text-align:center; color:var(--ink-500); padding:40px 0; font-size:14.5px}
  .no-results.show{display:block}

  .request-access-card{
    border:1.5px dashed var(--line); background:transparent; box-shadow:none; align-items:center; text-align:center;
    justify-content:center; color:var(--ink-500);
  }
  .request-access-card:hover{border-color:var(--blue-600); transform:none; box-shadow:none}
  .request-access-card .sys-icon{background:var(--sand-100); color:var(--ink-500)}
  .request-access-card .go{color:var(--ink-500)}

  /* ---------- news carousel (اخبار سازمان) ---------- */
  .news-section{background:var(--sand-100); padding:46px 0 40px}
  .news-tools{display:flex; align-items:center; gap:8px}
  .news-nav{width:40px; height:40px; border-radius:50%; display:grid; place-items:center; border:1px solid var(--line); background:var(--card); color:var(--navy-900); cursor:pointer; transition:background .15s, border-color .15s}
  .news-nav:hover{border-color:var(--gold-500); background:#fff}
  .news-nav svg{width:18px; height:18px}
  .news-all{display:inline-flex; align-items:center; gap:6px; padding:9px 16px; border-radius:999px; background:var(--navy-900); color:#fff; font-size:13px; font-weight:700; margin-inline-start:6px}
  .news-all:hover{background:var(--navy-800)}
  .news-track{display:flex; gap:20px; overflow-x:auto; scroll-snap-type:x mandatory; scroll-behavior:smooth; padding:8px calc(50% - 170px) 18px; scrollbar-width:none; overscroll-behavior-x:contain}
  .news-track::-webkit-scrollbar{display:none}
  .news-track:focus-visible{outline:2px solid var(--blue-500); outline-offset:4px; border-radius:20px}
  .news-card{flex:0 0 min(340px, 82vw); scroll-snap-align:center; background:var(--card); border:1px solid var(--line); border-radius:20px; overflow:hidden;
    transform:scale(.94); opacity:.72; transition:transform .35s ease, opacity .35s ease, box-shadow .35s ease}
  .news-card.is-active{transform:scale(1); opacity:1; box-shadow:var(--shadow-lg); border-color:transparent}
  .news-card a{display:flex; flex-direction:column; height:100%}
  .news-card a:focus-visible{outline:2px solid var(--blue-500); outline-offset:-2px; border-radius:20px}
  .news-media{aspect-ratio:16/9; background:linear-gradient(135deg, var(--navy-900), var(--blue-600)); display:grid; place-items:center; position:relative}
  .news-media[data-kind="Announcement"]{background:linear-gradient(135deg, #8A6320, var(--gold-500))}
  .news-media[data-kind="Circular"]{background:linear-gradient(135deg, var(--navy-800), var(--teal-500))}
  .news-media img{width:100%; height:100%; object-fit:cover; display:block}
  .news-media svg{width:46px; height:46px; color:rgba(255,255,255,.75)}
  .news-media .tag{position:absolute; top:12px; right:12px; background:var(--gold-500); color:var(--navy-950); font-weight:800; font-size:11.5px; padding:4px 12px; border-radius:100px}
  .news-body{padding:16px 18px 18px; display:flex; flex-direction:column; gap:6px; flex:1}
  .news-body h3{margin:0; font-size:16px; font-weight:800; line-height:1.6; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow-wrap:anywhere}
  .news-body p{margin:0; font-size:13px; color:var(--ink-500); overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow-wrap:anywhere}
  .news-body .meta{margin-top:auto; padding-top:6px; font-size:12px; color:var(--ink-500); display:flex; align-items:center; gap:6px}
  .news-dots{display:flex; justify-content:center; gap:6px; margin-top:4px}
  .news-dots button{width:8px; height:8px; padding:0; border-radius:99px; border:0; background:#CFC8B6; cursor:pointer; transition:width .25s, background .25s}
  .news-dots button[aria-current="true"]{width:24px; background:var(--navy-900)}
  .news-empty{text-align:center; color:var(--ink-500); padding:30px 0}
  @@media (prefers-reduced-motion: reduce){ .news-track{scroll-behavior:auto} .news-card, .news-dots button{transition:none} }

  /* ---------- quick links ---------- */
  .quick-links{background:var(--sand-100); border-top:1px solid var(--line); border-bottom:1px solid var(--line)}
  .ql-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:0}
  .ql-col{padding:0 30px; border-inline-start:1px solid var(--line)}
  .ql-col:first-child{border-inline-start:none; padding-inline-start:0}
  .ql-col h3{display:flex; align-items:center; gap:10px; font-size:15px; font-weight:800; margin:0 0 16px; color:var(--navy-900)}
  .ql-col h3 svg{width:18px; height:18px; color:var(--gold-600)}
  .ql-col ul li{margin-bottom:10px}
  .ql-col ul li a{display:flex; justify-content:space-between; font-size:13.5px; color:var(--ink-700); padding:4px 0; border-bottom:1px dashed transparent}
  .ql-col ul li a:hover{color:var(--blue-600); border-color:var(--line)}
  .ql-col ul li a .count{color:var(--ink-500); font-size:12px; font-weight:600}
  .ql-head{display:flex; align-items:center; justify-content:space-between; gap:10px; margin:0 0 16px}
  .ql-col .ql-head h3{margin:0}
  .ql-all{display:inline-flex; align-items:center; gap:6px; flex-shrink:0; padding:4px 12px; border:1px solid var(--line); border-radius:999px; background:var(--card); color:var(--blue-600); font-size:12.5px; font-weight:700; cursor:pointer; transition:background .15s, border-color .15s}
  .ql-all svg{width:14px; height:14px; transform:scaleX(-1)}
  .ql-all:hover{background:#fff; border-color:var(--blue-500)}
  .ql-all:focus-visible, .ql-close:focus-visible{outline:2px solid var(--blue-500); outline-offset:2px}
  .ql-dialog{border:none; border-radius:var(--radius); padding:0; width:min(640px, calc(100vw - 32px)); max-height:min(80vh, 640px); background:var(--card); color:var(--ink-900); box-shadow:var(--shadow-lg)}
  .ql-dialog[open]{display:flex; flex-direction:column}
  .ql-dialog::backdrop{background:rgba(10,32,54,.55)}
  .ql-dialog-head{display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px 22px 12px}
  .ql-dialog-head h3{margin:0; font-size:16px; font-weight:800; color:var(--navy-900)}
  .ql-dialog-head h3 small{font-size:12px; font-weight:600; color:var(--ink-500)}
  .ql-close{display:grid; place-items:center; width:32px; height:32px; border:none; border-radius:8px; background:var(--sand-100); color:var(--ink-700); cursor:pointer}
  .ql-close svg{width:16px; height:16px}
  .ql-close:hover{background:var(--line)}
  .ql-search{padding:0 22px 12px}
  .ql-search-input{width:100%; padding:10px 14px; border:1px solid var(--line); border-radius:10px; font:inherit; font-size:13.5px; background:var(--sand-50)}
  .ql-search-input:focus{outline:2px solid var(--blue-500); outline-offset:0; background:#fff}
  .ql-dialog-list{margin:0; padding:0 22px 18px; overflow-y:auto; flex:1}
  .ql-dialog-list li{border-bottom:1px solid var(--line)}
  .ql-dialog-list li[hidden]{display:none}
  .ql-dialog-list li a{display:flex; justify-content:space-between; gap:12px; padding:10px 0; font-size:13.5px; color:var(--ink-700)}
  .ql-dialog-list li a:hover{color:var(--blue-600)}
  .ql-dialog-list li a .count{color:var(--ink-500); font-size:12px; font-weight:600}
  .ql-empty{margin:0; padding:6px 22px 22px; color:var(--ink-500); font-size:13px}

  /* ---------- footer ---------- */
  footer.site{background:var(--navy-950); color:#AFC4D6; padding:40px 0 22px}
  .footer-top{display:flex; justify-content:space-between; align-items:center; gap:24px; padding-bottom:24px; border-bottom:1px solid rgba(255,255,255,.1); flex-wrap:wrap}
  .footer-brand{display:flex; align-items:center; gap:14px; color:#fff}
  .footer-brand img{height:34px; filter:brightness(0) invert(1)}
  .footer-brand b{font-size:14.5px}
  .footer-links{display:flex; gap:24px; flex-wrap:wrap; font-size:13.5px}
  .footer-links a:hover{color:#fff}
  .footer-bottom{display:flex; justify-content:space-between; align-items:center; padding-top:18px; font-size:12px; flex-wrap:wrap; gap:10px; color:#8AA0B2}
  .footer-bottom .tpl-tag{color:#6E8194}

  @@media (max-width:960px){
    nav.main{display:none}
    .hero-grid{grid-template-columns:1fr}
    .systems-grid{grid-template-columns:repeat(2,1fr)}
    .ql-grid{grid-template-columns:1fr; gap:26px}
    .ql-col{border-inline-start:none; padding-inline-start:0; padding-bottom:20px; border-bottom:1px solid var(--line)}
    .dropdown, .profile-menu{left:auto; right:0}
  }
  @@media (max-width:600px){
    .systems-grid{grid-template-columns:1fr}
    .container{padding:0 18px}
    .header-inner{height:66px}
    .user-chip .info{display:none}
    .dropdown{width:92vw}
  }
</style>

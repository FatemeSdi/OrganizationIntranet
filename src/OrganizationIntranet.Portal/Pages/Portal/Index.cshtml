@section Scripts {
    <script src="~/js/portal-navigation.js" asp-append-version="true"></script>
    <script src="~/js/portal-access-requests.js" asp-append-version="true"></script>
    <script src="~/js/news-carousel.js" asp-append-version="true"></script>
    <script src="~/js/portal-toast.js" asp-append-version="true"></script>
    <script>

const grid = document.getElementById('systemsGrid');

/* ---------------- search filter (scoped to my systems) ---------------- */
const noResults = document.getElementById('noResults');
noResults.classList.toggle('show', @Model.Applications.Count === 0);
const searchInput = document.getElementById('systemSearch');
searchInput.addEventListener('input', ()=>{
  const term = searchInput.value.trim().toLowerCase();
  let visible = 0;
  Array.from(grid.querySelectorAll('.sys-card:not(.request-access-card)')).forEach(c=>{
    const match = !term || c.dataset.name.toLowerCase().includes(term);
    c.hidden = !match;
    if(match) visible++;
  });
  noResults.textContent = term ? "سامانه‌ای مطابق با جست‌وجوی شما یافت نشد." : noResults.dataset.empty;
  noResults.classList.toggle('show', visible === 0);
});

/* ---------------- dropdown toggles ---------------- */
function setupDropdown(btnId, panelId){
  const btn = document.getElementById(btnId);
  const panel = document.getElementById(panelId);
  if(!btn || !panel) return; // بازدیدکننده‌ی ناشناس زنگ اعلان و منوی کاربر ندارد
  btn.addEventListener('click', (e)=>{
    e.stopPropagation();
    const isOpen = panel.classList.contains('open');
    document.querySelectorAll('.dropdown.open, .profile-menu.open').forEach(p=>{
      p.classList.remove('open');
      p.previousElementSibling && p.previousElementSibling.setAttribute && p.previousElementSibling.setAttribute('aria-expanded','false');
    });
    if(!isOpen){
      panel.classList.add('open');
      btn.setAttribute('aria-expanded','true');
    } else {
      btn.setAttribute('aria-expanded','false');
    }
  });
}
setupDropdown('bellBtn','bellDropdown');
setupDropdown('userBtn','profileMenu');

document.addEventListener('keydown', (e)=>{
  if(e.key !== 'Escape') return;
  const openPanel = document.querySelector('.dropdown.open, .profile-menu.open');
  if(!openPanel) return;
  const trigger = document.getElementById(openPanel.id === 'bellDropdown' ? 'bellBtn' : 'userBtn');
  openPanel.classList.remove('open');
  if(!trigger) return;
  trigger.setAttribute('aria-expanded', 'false');
  trigger.focus();
});

document.addEventListener('click', ()=>{
  document.querySelectorAll('.dropdown.open, .profile-menu.open').forEach(p=>p.classList.remove('open'));
  document.getElementById('bellBtn')?.setAttribute('aria-expanded','false');
  document.getElementById('userBtn')?.setAttribute('aria-expanded','false');
});
document.querySelectorAll('.dropdown, .profile-menu').forEach(p=>p.addEventListener('click', e=>e.stopPropagation()));


/* ---------------- quick links: «همه» modal with search ---------------- */
(function(){
  const norm = s => (s || '').replace(/ي/g,'ی').replace(/ك/g,'ک').replace(/‌/g,' ').toLowerCase().trim();
  document.querySelectorAll('[data-ql-open]').forEach(btn=>{
    const dlg = document.getElementById(btn.dataset.qlOpen);
    if(!dlg || typeof dlg.showModal !== 'function') return;
    const input = dlg.querySelector('.ql-search-input');
    const items = Array.from(dlg.querySelectorAll('.ql-dialog-list li'));
    const empty = dlg.querySelector('.ql-empty');
    const filter = ()=>{
      const term = norm(input.value);
      let visible = 0;
      items.forEach(li=>{
        const match = !term || norm(li.dataset.text).includes(term);
        li.hidden = !match;
        if(match) visible++;
      });
      empty.hidden = visible !== 0;
    };
    btn.addEventListener('click', ()=>{
      input.value = '';
      filter();
      dlg.showModal();
      document.body.style.overflow = 'hidden';
      input.focus();
    });
    input.addEventListener('input', filter);
    dlg.querySelector('[data-ql-close]').addEventListener('click', ()=>dlg.close());
    dlg.addEventListener('click', e=>{ if(e.target === dlg) dlg.close(); });
    dlg.addEventListener('close', ()=>{ document.body.style.overflow = ''; });
  });
})();

    </script>

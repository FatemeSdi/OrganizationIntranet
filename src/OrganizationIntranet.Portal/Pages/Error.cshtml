@page "/Error/{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Content.Title;
    Layout = "_LayoutAuth"; // بدون هدر و فراخوانی API
    var c = Model.Content;
    var signedIn = User.Identity?.IsAuthenticated == true;
}
@section Styles {
    <style>
        /* هم‌رنگ پورتال (سرمه‌ای/طلایی، زمینه‌ی کرم) — مستقل از layout تا روی پس‌زمینه‌ی صفحه‌ی ورود هم درست دیده شود */
        .pe-page { --navy-950: #0A2036; --navy-900: #0D2C48; --navy-800: #123A5C; --gold-500: #D6A24C; --gold-600: #C08A34;
            --sand-50: #F6F4EE; --sand-100: #EFEBE0; --ink-900: #152230; --ink-500: #5C6C78; --line: #E3DFD2;
            position: fixed; inset: 0; z-index: 10; overflow-y: auto; background: var(--sand-50); color: var(--ink-900);
            font-family: 'Vazirmatn', 'Vazir', Tahoma, sans-serif; line-height: 1.7; }
        .pe-band { position: relative; overflow: hidden; background: linear-gradient(135deg, var(--navy-950) 0%, var(--navy-800) 100%); color: #fff; padding: 22px 24px 96px; }
        .pe-band::after { content: ""; position: absolute; left: -80px; top: -90px; width: 280px; height: 280px; border-radius: 50%; border: 34px solid rgba(214, 162, 76, .10); }
        .pe-brand { position: relative; display: flex; align-items: center; gap: 12px; max-width: 1140px; margin: 0 auto; color: #fff; text-decoration: none; }
        .pe-brand img { height: 40px; filter: brightness(0) invert(1); }
        .pe-brand b { display: block; font-size: 15px; font-weight: 800; }
        .pe-brand span { display: block; font-size: 11.5px; color: #AFC4D6; }
        .pe-card { position: relative; z-index: 1; max-width: 560px; margin: -64px auto 40px; padding: 36px 28px 30px; background: #fff; border: 1px solid var(--line);
            border-radius: 16px; box-shadow: 0 20px 46px -18px rgba(10, 32, 54, .32); text-align: center; }
        .pe-code { font-size: 54px; font-weight: 900; line-height: 1; color: var(--sand-100); -webkit-text-stroke: 1.5px var(--gold-500); margin-bottom: 6px; letter-spacing: 2px; }
        .pe-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 18px; display: grid; place-items: center; background: rgba(214, 162, 76, .16); color: var(--gold-600); }
        .pe-icon svg { width: 30px; height: 30px; }
        .pe-card h1 { font-size: 21px; font-weight: 800; color: var(--navy-900); margin: 0 0 8px; }
        .pe-message { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
        .pe-hint { font-size: 13.5px; color: var(--ink-500); margin: 0 auto 18px; max-width: 460px; }
        .pe-id { display: inline-block; direction: ltr; margin-bottom: 22px; padding: 4px 12px; border-radius: 999px; background: var(--sand-100); color: var(--ink-500);
            font: 500 12px ui-monospace, Consolas, monospace; overflow-wrap: anywhere; }
        .pe-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
        .pe-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 20px; border-radius: 12px; font-size: 14px; font-weight: 700;
            text-decoration: none; border: 1px solid transparent; transition: background .2s, border-color .2s; }
        .pe-btn-primary { background: var(--navy-900); color: #fff; }
        .pe-btn-primary:hover, .pe-btn-primary:focus-visible { background: var(--navy-800); color: #fff; }
        .pe-btn-soft { background: var(--sand-100); color: var(--navy-900); border-color: var(--line); }
        .pe-btn-soft:hover, .pe-btn-soft:focus-visible { border-color: var(--gold-500); color: var(--navy-900); }
        .pe-btn:focus-visible { outline: 3px solid rgba(214, 162, 76, .45); outline-offset: 2px; }
        @@media (max-width: 480px) { .pe-card { margin: -64px 16px 32px; padding: 28px 18px 24px; } .pe-btn { width: 100%; } }
    </style>
}

<div class="pe-page">
    <div class="pe-band">
        <a class="pe-brand" href="/Portal">
            <img src="~/assets/images/brand-logos/logo-pmo.png" alt="" />
            <div><b>پورتال داخلی سازمان</b><span>اداره کل بنادر و دریانوردی استان هرمزگان</span></div>
        </a>
    </div>
    <section class="pe-card" aria-labelledby="error-title">
        <div class="pe-code" aria-hidden="true">@c.StatusCode</div>
        <div class="pe-icon" aria-hidden="true">
            @if (c.StatusCode == 403)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><path d="M12 14.5v3"/></svg>
            }
            else if (c.StatusCode == 404)
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M9 9l4 4M13 9l-4 4"/></svg>
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 2 20h20L12 3Z"/><path d="M12 10v4M12 17h.01"/></svg>
            }
        </div>
        <h1 id="error-title">@c.Title</h1>
        <p class="pe-message">@c.Message</p>
        <p class="pe-hint">@c.Hint</p>
        @if (c.StatusCode >= 500 && Model.RequestId is not null)
        {
            <span class="pe-id" title="شناسه‌ی پیگیری">@Model.RequestId</span>
        }
        <div class="pe-actions">
            <a href="/Portal" class="pe-btn pe-btn-primary">بازگشت به صفحه‌ی اصلی</a>
            @if (c.StatusCode == 403 && signedIn)
            {
                <a href="/AccessRequests" class="pe-btn pe-btn-soft">درخواست دسترسی</a>
            }
        </div>
    </section>
</div>

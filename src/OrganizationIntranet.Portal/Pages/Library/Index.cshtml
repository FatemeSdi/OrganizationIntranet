@page
@model OrganizationIntranet.Pages.Library.IndexModel
@using OrganizationIntranet.Pages.Library
@using OrganizationIntranet.Contracts
@{
    ViewData["Title"] = "قوانین، انتشارات و فرم‌ها";
    ViewData["PortalNav"] = "library";
    Layout = "_LayoutPortal";
    var filtered = Model.Q is not null || Model.Group is not null || Model.Category is not null;
    var total = Model.IsOverview ? Model.CountAll : Model.Documents.Count;
}
@section Styles {
    <style>
        .pp-lib-groups { display: grid; gap: 26px; margin-top: 6px; }
        .pp-lib-group h2 { display: flex; align-items: center; gap: 10px; font-size: 16px; font-weight: 800; color: var(--navy-900); margin: 0 0 12px; }
        .pp-lib-group h2 svg { width: 20px; height: 20px; color: var(--gold-600); flex-shrink: 0; }
        .pp-lib-group h2 small { font-size: 12px; font-weight: 600; color: var(--ink-500); }
        .pp-lib-group h3 { font-size: 14px; font-weight: 800; color: var(--ink-700); margin: 16px 0 8px; }
        .pp-lib-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px; margin: 0; padding: 0; list-style: none; }
        .pp-lib-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
        a.pp-lib-item:hover { border-color: var(--blue-600); }
        .pp-lib-item .pp-lib-icon { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; flex-shrink: 0; background: var(--sand-100); color: var(--navy-800); }
        .pp-lib-item .pp-lib-icon svg { width: 18px; height: 18px; }
        .pp-lib-item b { display: block; font-size: 14px; font-weight: 700; overflow-wrap: anywhere; }
        .pp-lib-item span { font-size: 12px; color: var(--ink-500); }
        .pp-lib-docs { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
        .pp-lib-doc { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 14px; background: var(--card); }
        .pp-lib-doc .pp-lib-ext { flex-shrink: 0; min-width: 46px; text-align: center; padding: 6px 8px; border-radius: 10px; background: var(--sand-100); color: var(--navy-800); font-size: 11px; font-weight: 800; letter-spacing: .5px; }
        .pp-lib-doc .pp-lib-thumb { flex-shrink: 0; width: 56px; height: 56px; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); background: var(--sand-100); }
        .pp-lib-doc .pp-lib-body { flex: 1; min-width: 0; }
        .pp-lib-doc b { display: block; font-size: 14px; font-weight: 700; overflow-wrap: anywhere; }
        .pp-lib-doc p { margin: 2px 0 0; font-size: 12.5px; color: var(--ink-500); overflow-wrap: anywhere; }
        .pp-lib-doc small { display: block; margin-top: 4px; font-size: 11.5px; color: var(--ink-500); }
        .pp-lib-doc .pp-btn { flex-shrink: 0; }
        .pp-lib-more { display: inline-flex; align-items: center; gap: 6px; margin-top: 12px; font-size: 13px; font-weight: 700; color: var(--blue-600); }
        .pp-lib-more svg { width: 14px; height: 14px; transform: scaleX(-1); }
        .pp-lib-more:hover { color: var(--navy-900); }
        .pp-lib-cats { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 16px; }
        .pp-lib-cats a { padding: 5px 12px; border-radius: 999px; border: 1px solid var(--line); font-size: 12.5px; color: var(--ink-700); }
        .pp-lib-cats a.active { background: var(--navy-900); color: #fff; border-color: var(--navy-900); }
        @@media (max-width: 575px) { .pp-lib-doc { flex-wrap: wrap; } .pp-lib-doc .pp-btn { width: 100%; justify-content: center; } }
    </style>
}

<section class="pp-card" aria-label="قوانین، انتشارات و فرم‌ها">
    <div class="pp-pub-toolbar">
        <nav class="pp-tabs" aria-label="بخش">
            <a asp-route-q="@Model.Q" class="@(Model.Group is null ? "active" : null)" aria-current="@(Model.Group is null ? "page" : null)">همه <span class="pp-tab-count">@LibraryView.Fa(Model.CountAll)</span></a>
            @foreach (var g in LibraryGroups.All)
            {
                <a asp-route-group="@g.Code" asp-route-q="@Model.Q" class="@(Model.Group == g.Code ? "active" : null)" aria-current="@(Model.Group == g.Code ? "page" : null)">@g.Title <span class="pp-tab-count">@LibraryView.Fa(Model.Count(g.Code))</span></a>
            }
        </nav>
        <form method="get" class="pp-pub-search" role="search">
            @if (Model.Group is not null) { <input type="hidden" name="group" value="@Model.Group" /> }
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input name="q" value="@Model.Q" type="search" maxlength="@LibraryRules.MaxSearchLength" class="pp-input" placeholder="جست‌وجو در قوانین، انتشارات و فرم‌ها" aria-label="جست‌وجو در قوانین، انتشارات و فرم‌ها" />
            <button type="submit" class="pp-btn pp-btn-primary pp-btn-sm">جست‌وجو</button>
        </form>
    </div>

    <p class="pp-hint pp-pub-count">@LibraryView.Fa(total) @(Model.IsOverview ? "سند" : "مورد")@if (filtered) { <text> یافت شد · <a href="/Library" class="pp-link">پاک‌کردن فیلتر</a></text> }</p>

    @if (Model.ApiUnavailable)
    {
        <div class="pp-empty"><b>در حال حاضر دریافت فهرست اسناد ممکن نیست؛ کمی بعد دوباره تلاش کنید.</b></div>
    }
    else if (!Model.HasAnyContent)
    {
        <div class="pp-empty">
            <div class="pp-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></div>
            <b>@(Model.Q is null ? "هنوز سندی منتشر نشده است" : "موردی مطابق جست‌وجوی شما یافت نشد")</b>
        </div>
    }
    else if (Model.IsOverview)
    {
        <div class="pp-lib-groups">
            @foreach (var g in LibraryGroups.All)
            {
                var categories = Model.Categories.Where(c => c.GroupCode == g.Code).ToList();
                if (categories.Count == 0) { continue; }
                <section class="pp-lib-group" id="@g.Code" aria-labelledby="@($"lib-{g.Code}")">
                    <h2 id="@($"lib-{g.Code}")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(LibraryView.Icon(g.Code))</svg>@g.Title <small>(@LibraryView.Fa(categories.Sum(c => c.DocumentCount)) سند)</small></h2>
                    <ul class="pp-lib-grid">
                        @foreach (var c in categories.Take(LibraryView.PreviewLimit))
                        {
                            <li>
                                <a class="pp-lib-item" asp-route-group="@g.Code" asp-route-category="@c.CategoryId">
                                    <span class="pp-lib-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(LibraryView.Icon(g.Code))</svg></span>
                                    <div><b>@c.Title</b><span>@LibraryView.Fa(c.DocumentCount) مدرک</span></div>
                                </a>
                            </li>
                        }
                    </ul>
                    @if (categories.Count > LibraryView.PreviewLimit)
                    {
                        <a asp-route-group="@g.Code" class="pp-lib-more">مشاهده‌ی همه‌ی @LibraryView.Fa(categories.Count) دسته‌ی «@g.Title»
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                        </a>
                    }
                </section>
            }
        </div>
    }
    else
    {
        if (Model.Group is not null)
        {
            <div class="pp-lib-cats" aria-label="دسته‌ها">
                <a asp-route-group="@Model.Group" asp-route-q="@Model.Q" class="@(Model.Category is null ? "active" : null)">همه‌ی دسته‌ها</a>
                @foreach (var c in Model.Categories.Where(c => c.GroupCode == Model.Group))
                {
                    <a asp-route-group="@Model.Group" asp-route-category="@c.CategoryId" asp-route-q="@Model.Q" class="@(Model.Category == c.CategoryId ? "active" : null)">@c.Title <span class="pp-tab-count">@LibraryView.Fa(c.DocumentCount)</span></a>
                }
            </div>
        }
        <div class="pp-lib-groups">
            @foreach (var byGroup in Model.DocumentsByGroup)
            {
                <section class="pp-lib-group" id="@byGroup.Key" aria-labelledby="@($"lib-{byGroup.Key}")">
                    <h2 id="@($"lib-{byGroup.Key}")"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(LibraryView.Icon(byGroup.Key))</svg>@LibraryGroups.Title(byGroup.Key) <small>(@LibraryView.Fa(byGroup.Count()) مورد)</small></h2>
                    @foreach (var byCategory in byGroup.GroupBy(d => d.CategoryTitle))
                    {
                        <h3>@byCategory.Key</h3>
                        <ul class="pp-lib-docs">
                            @foreach (var d in byCategory)
                            {
                                <li class="pp-lib-doc">
                                    @if (d.HasPreview) { <img class="pp-lib-thumb" src="/Library/Preview/@d.DocumentId" alt="" width="56" height="56" loading="lazy" /> }
                                    else { <span class="pp-lib-ext" aria-hidden="true">@d.Extension.ToUpperInvariant()</span> }
                                    <div class="pp-lib-body">
                                        <b>@d.Title</b>
                                        @if (!string.IsNullOrEmpty(d.Description)) { <p>@d.Description</p> }
                                        <small dir="ltr" style="text-align:start">@d.FileName · @LibraryView.Size(d.SizeBytes)</small>
                                    </div>
                                    <a class="pp-btn pp-btn-primary pp-btn-sm" href="/Library/Download/@d.DocumentId" aria-label="دانلود @d.Title">دانلود</a>
                                </li>
                            }
                        </ul>
                    }
                </section>
            }
        </div>
    }
</section>

@page
@model OrganizationIntranet.Pages.Sso.OpenModel
@{
    ViewData["Title"] = "ورود به سامانه";
    Layout = "_LayoutPortal";
}
<section class="pp-card" aria-labelledby="sso-error-title">
    <div class="pp-empty">
        <div class="pp-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg></div>
        <b id="sso-error-title">ورود خودکار به سامانه ممکن نشد</b>
        <p>@Model.Error</p>
        <a href="/Portal#systems" class="pp-btn pp-btn-soft pp-btn-sm">بازگشت به سامانه‌های من</a>
    </div>
</section>

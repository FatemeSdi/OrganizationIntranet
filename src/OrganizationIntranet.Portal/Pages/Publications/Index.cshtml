@page
@model OrganizationIntranet.Pages.Publications.IndexModel
@using OrganizationIntranet.Contracts
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "اخبار و اطلاعیه‌ها";
    ViewData["PortalNav"] = "news";
    Layout = "_LayoutPortal";
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Result.Total / (double)Math.Max(1, Model.Result.PageSize)));
    (string? Key, string Label)[] kinds = [(null, "همه"), ("News", PublicationKinds.Label("News")), ("Announcement", PublicationKinds.Label("Announcement")), ("Circular", PublicationKinds.Label("Circular"))];
    var filtered = !string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Kind);
}

<section class="pp-card" aria-label="فهرست مطالب">
    <div class="pp-pub-toolbar">
        <nav class="pp-tabs" aria-label="نوع مطلب">
            @foreach (var k in kinds)
            {
                <a asp-route-kind="@k.Key" asp-route-search="@Model.Search" class="@(Model.Kind == k.Key ? "active" : null)" aria-current="@(Model.Kind == k.Key ? "page" : null)">@k.Label</a>
            }
        </nav>
        <form method="get" class="pp-pub-search" role="search">
            <input type="hidden" asp-for="Kind" />
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input asp-for="Search" type="search" maxlength="200" class="pp-input" placeholder="جست‌وجو در عنوان و خلاصه" aria-label="جست‌وجو در عنوان و خلاصه" />
            <button type="submit" class="pp-btn pp-btn-primary pp-btn-sm">جست‌وجو</button>
        </form>
    </div>

    <p class="pp-hint pp-pub-count">@Model.Result.Total مطلب@(filtered ? " یافت شد" : "")@if (filtered) { <text> · <a href="/Publications" class="pp-link">پاک‌کردن فیلتر</a></text> }</p>

    @if (Model.Result.Items.Count == 0)
    {
        <div class="pp-empty">
            <div class="pp-empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5h13a2 2 0 0 1 2 2v11a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2Z"/><path d="M8 9h7M8 13h7M8 17h4"/></svg></div>
            <b>@(filtered ? "مطلبی با این مشخصات پیدا نشد" : "هنوز مطلبی منتشر نشده است")</b>
        </div>
    }
    <div class="pp-pub-grid">
        @foreach (var item in Model.Result.Items)
        {
            <article class="pp-pub-card">
                <a asp-page="Details" asp-route-id="@item.PublicationId">
                    <partial name="_PublicationMedia" model="item" />
                    <div class="pp-pub-body">
                        <h2>@item.Title</h2>
                        <p>@item.Summary</p>
                        <span class="pp-pub-date"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>@((item.PublishedAt ?? item.CreatedAt).ToPersianDate())</span>
                    </div>
                </a>
            </article>
        }
    </div>

    @if (totalPages > 1)
    {
        <div class="pp-pager">
            <span>صفحه @Model.PageNumber از @totalPages</span>
            <nav aria-label="صفحه‌بندی مطالب">
                @if (Model.PageNumber > 1) { <a asp-route-pageNumber="@(Model.PageNumber - 1)" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" class="pp-btn pp-btn-soft pp-btn-sm">قبلی</a> }
                @if (Model.PageNumber < totalPages) { <a asp-route-pageNumber="@(Model.PageNumber + 1)" asp-route-kind="@Model.Kind" asp-route-search="@Model.Search" class="pp-btn pp-btn-soft pp-btn-sm">بعدی</a> }
            </nav>
        </div>
    }
</section>

@page "/Error/{code:int?}"
@model ErrorModel
@{
    ViewData["Title"] = Model.Content.Title;
    Layout = "_LayoutAuth"; // بدون منو و زنگ اعلان (بی‌نیاز از API)
    var c = Model.Content;
    var signedIn = User.Identity?.IsAuthenticated == true;
    var icon = c.StatusCode switch { 403 => "ti-lock-access", 404 => "ti-map-search", _ => "ti-alert-triangle" };
}
@section Styles {
    <style>
        /* هم‌خوان با تمپلیت yzen پنل مدیریت (رنگ اصلی --primary-rgb) */
        .ae-wrap { min-height: 100vh; display: grid; place-items: center; padding: 24px 16px; }
        .ae-card { width: 100%; max-width: 540px; text-align: center; padding: 34px 28px 28px; }
        .ae-code { font-size: 56px; font-weight: 900; line-height: 1; color: rgba(var(--primary-rgb), .14); letter-spacing: 2px; margin-bottom: 6px; }
        .ae-icon { width: 64px; height: 64px; margin: 0 auto 14px; border-radius: 18px; display: grid; place-items: center;
            background: rgba(var(--primary-rgb), .1); color: rgb(var(--primary-rgb)); font-size: 30px; }
        .ae-card h1 { font-size: 20px; font-weight: 800; margin: 0 0 8px; }
        .ae-message { font-size: 15px; font-weight: 600; margin: 0 0 6px; }
        .ae-hint { font-size: 13.5px; color: var(--text-muted); margin: 0 auto 18px; max-width: 440px; }
        .ae-id { display: inline-block; direction: ltr; margin-bottom: 20px; padding: 4px 12px; border-radius: 999px; background: var(--default-background);
            color: var(--text-muted); font: 500 12px ui-monospace, Consolas, monospace; overflow-wrap: anywhere; }
        .ae-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 10px; }
        @@media (max-width: 480px) { .ae-actions .btn { width: 100%; } }
    </style>
}

<div class="ae-wrap">
    <section class="card custom-card ae-card" aria-labelledby="error-title">
        <div class="ae-code" aria-hidden="true">@c.StatusCode</div>
        <div class="ae-icon" aria-hidden="true"><i class="ti @icon"></i></div>
        <h1 id="error-title">@c.Title</h1>
        <p class="ae-message">@c.Message</p>
        <p class="ae-hint">@c.Hint</p>
        @if (c.StatusCode >= 500 && Model.RequestId is not null)
        {
            <span class="ae-id" title="شناسه‌ی پیگیری">@Model.RequestId</span>
        }
        <div class="ae-actions">
            <a href="@(signedIn ? "/Admin" : "/Account/Login")" class="btn btn-primary btn-wave">@(signedIn ? "بازگشت به داشبورد" : "ورود به پنل مدیریت")</a>
            @if (c.StatusCode == 403 && signedIn)
            {
                <a href="/Account/Logout" class="btn btn-primary-light">ورود با حساب دیگر</a>
            }
        </div>
    </section>
</div>

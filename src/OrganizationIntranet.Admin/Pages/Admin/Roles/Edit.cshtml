@page
@model EditModel
@using OrganizationIntranet.Helper
@using P = OrganizationIntranet.Contracts.AdminPermissions
@{
    var role = Model.Details.Role;
    var canEdit = User.HasPermission(P.RoleEdit);
    var isSystem = P.IsSystemRole(role.RoleCode);
    ViewData["Title"] = canEdit ? "ویرایش نقش" : "جزئیات نقش";
    ViewData["Icon"] = "ti ti-user-shield";
    ViewData["Subtitle"] = role.RoleName;
    ViewData["ParentTitle"] = "نقش‌ها";
    ViewData["ParentUrl"] = "/Admin/Roles";
    Layout = "_LayoutAdmin";
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(null, Model.ErrorMessage)' />

<form method="post" class="card custom-card" data-busy data-dirty-guard>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-id-badge-2"></i>مشخصات نقش</h2>
            <p class="form-section__help">تغییر نام یا کد، حداکثر ظرف ۵ دقیقه در نشست کاربران این نقش اعمال می‌شود.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="RoleName" class="form-label">نام نقش <span class="text-danger">*</span></label><input asp-for="RoleName" class="form-control" maxlength="100" required readonly="@(!canEdit)" /></div>
            <div class="col-md-6">
                <label asp-for="RoleCode" class="form-label">کد نقش <span class="text-danger">*</span></label>
                <input asp-for="RoleCode" class="form-control" dir="ltr" maxlength="50" required pattern="[A-Za-z][A-Za-z0-9_]*" readonly="@(!canEdit || isSystem)" />
                <div class="form-text">@(isSystem ? "نقش سیستمی است؛ برنامه آن را با همین کد پیدا می‌کند و کدش تغییر نمی‌کند." : "یکتا؛ حروف انگلیسی، رقم و _ (با حرف شروع شود).")</div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-2 align-items-center">
                <span class="status-pill @(role.IsActive ? "status-pill--success" : "status-pill--muted")">@(role.IsActive ? "فعال" : "غیرفعال")</span>
                @if (isSystem) { <span class="status-pill status-pill--primary">نقش سیستمی</span> }
                <span class="text-muted fs-12">ایجاد: @role.CreatedAt.ToPersianDate()</span>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-users"></i>کاربران این نقش <span class="badge bg-primary-transparent ms-1">@role.UserCount</span></h2>
            <p class="form-section__help">نقش هر کاربر در صفحه‌ی ویرایش همان کاربر تغییر می‌کند.</p>
        </div>
        <div>
            @if (Model.Details.UsersHidden)
            {
                <span class="text-muted fs-13">برای دیدن فهرست کاربران، مجوز «مشاهده‌ی کاربران» لازم است.</span>
            }
            else if (Model.Details.Users.Count == 0)
            {
                <span class="text-muted fs-13">هیچ کاربری این نقش را ندارد.</span>
            }
            else
            {
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var u in Model.Details.Users)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3">
                            <span class="entity__avatar">@(u.DisplayName.Length > 0 ? u.DisplayName[..1] : "?")</span>
                            <div class="flex-fill min-w-0">
                                <a href="/Admin/Users/Edit?id=@u.UserId" class="entity__name d-block text-truncate">@u.DisplayName</a>
                                <span class="entity__sub" dir="ltr">@u.Username</span>
                            </div>
                            @if (!u.IsActive) { <span class="status-pill status-pill--muted">غیرفعال</span> }
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-lock-access"></i>مجوزها <span class="badge bg-primary-transparent ms-1">@role.PermissionCount</span></h2>
            <p class="form-section__help">مجوزها در صفحه‌ی «مجوزها ← اختصاص به نقش‌ها» به نقش داده یا از آن گرفته می‌شوند.</p>
        </div>
        <div>
            @if (Model.Details.Permissions.Count == 0)
            {
                <span class="text-muted fs-13">هیچ مجوزی به این نقش داده نشده است.</span>
            }
            else
            {
                <ul class="list-group list-group-flush border rounded">
                    @foreach (var p in Model.Details.Permissions)
                    {
                        <li class="list-group-item d-flex flex-wrap align-items-center gap-2">
                            <div class="flex-fill min-w-0">
                                @if (User.HasPermission(P.PermissionView)) { <a href="/Admin/Permissions/Assign?id=@p.PermissionId" class="entity__name">@p.PermissionName</a> }
                                else { <span class="entity__name">@p.PermissionName</span> }
                                <span class="code-chip ms-1">@p.PermissionCode</span>
                            </div>
                            <span class="badge bg-primary-transparent">@p.ApplicationName</span>
                            @if (!p.IsActive) { <span class="status-pill status-pill--muted">غیرفعال</span> }
                        </li>
                    }
                </ul>
            }
        </div>
    </section>

    <div class="form-actions">
        @if (canEdit) { <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button> }
        <a href="/Admin/Roles" class="btn btn-primary-light">@(canEdit ? "انصراف" : "بازگشت")</a>
        @if (canEdit) { <span class="form-actions__hint"><span class="text-danger">*</span> فیلد الزامی</span> }
    </div>
</form>

@if (canEdit)
{
    <div class="card custom-card border-danger-subtle">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-fill">
                <div class="fw-semibold text-danger"><i class="ti ti-trash me-1"></i>حذف نقش</div>
                <p class="text-muted fs-13 mb-0">
                    @if (isSystem) { @:نقش سیستمی حذف نمی‌شود.
                    }
                    else if (role.CanDelete) { @:این نقش کاربر، مجوز یا اتصالی ندارد و می‌توان آن را برای همیشه حذف کرد.
                    }
                    else { @:نقش در حال استفاده حذف نمی‌شود (@role.UserCount کاربر، @role.PermissionCount مجوز، @role.LinkCount دسترسی سامانه یا گروه نظارت). برای قطع دسترسی، آن را غیرفعال کنید.
                    }
                </p>
            </div>
            @if (role.CanDelete)
            {
                <form method="post" asp-page-handler="Delete" asp-route-id="@role.RoleId" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" data-confirm="@($"نقش «{role.RoleName}» برای همیشه حذف شود؟")"><i class="ti ti-trash me-1"></i>حذف نقش</button>
                </form>
            }
        </div>
    </div>
}

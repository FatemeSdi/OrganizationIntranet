@page
@model IndexModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "نقش‌ها";
    ViewData["Icon"] = "ti ti-user-shield";
    ViewData["Subtitle"] = "نقش سطح کلی دسترسی است؛ مجوزهای دقیق هر سامانه به نقش‌ها داده می‌شود";
    Layout = "_LayoutAdmin";
}
@section PageActions {
    <a href="/Admin/Permissions" class="btn btn-primary-light"><i class="ti ti-lock-access me-1"></i>مجوزها</a>
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(TempData["SuccessMessage"] as string, Model.ErrorMessage)' />

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card custom-card" data-filter-scope data-page-size="10" data-noun="نقش">
            @if (Model.AllRoles.Count == 0)
            {
                <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-user-shield", "نقشی تعریف نشده است", "از فرم «افزودن نقش» اولین نقش را بسازید.")' />
            }
            else
            {
                <div class="admin-toolbar" role="search">
                    <div class="admin-toolbar__search"><i class="ti ti-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="جست‌وجوی نام یا کد نقش" aria-label="جست‌وجوی نقش‌ها" data-filter="search" /></div>
                    <span class="admin-toolbar__count"><span data-filter-count>@Model.AllRoles.Count</span> نقش</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-admin text-nowrap">
                        <thead><tr><th>نقش</th><th>کد</th><th>تاریخ ایجاد</th><th>وضعیت</th></tr></thead>
                        <tbody>
                            @foreach (var role in Model.AllRoles)
                            {
                                <tr data-row data-search="@role.RoleName @role.RoleCode">
                                    <td>
                                        <div class="entity">
                                            <span class="entity__avatar entity__avatar--square bg-warning-transparent text-warning"><i class="ti ti-user-shield"></i></span>
                                            <span class="entity__name">@role.RoleName</span>
                                        </div>
                                    </td>
                                    <td><span class="code-chip">@role.RoleCode</span></td>
                                    <td>@role.CreatedAt.ToPersianDate()</td>
                                    <td>
                                        <form method="post" asp-page-handler="Toggle" asp-route-roleId="@role.RoleId" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <div class="form-check form-switch d-inline-flex align-items-center gap-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="role-toggle-@role.RoleId" checked="@role.IsActive" data-autosubmit
                                                       data-confirm-off="@($"نقش «{role.RoleName}» غیرفعال شود؟ کاربران این نقش پس از ورود بعدی دسترسی‌های آن را از دست می‌دهند.")" />
                                                <label class="form-check-label" for="role-toggle-@role.RoleId"><span class="status-pill @(role.IsActive ? "status-pill--success" : "status-pill--muted")">@(role.IsActive ? "فعال" : "غیرفعال")</span></label>
                                            </div>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div data-filter-empty hidden><partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-search-off", "نقشی پیدا نشد")' /></div>
                <div class="admin-pager" data-pager hidden></div>
            }
        </div>
    </div>

    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header"><div class="card-title"><i class="ti ti-square-rounded-plus text-primary me-1"></i>افزودن نقش</div></div>
            <form method="post" asp-page-handler="Create" class="card-body" data-busy>
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="RoleName" class="form-label">نام نقش</label>
                    <input asp-for="RoleName" class="form-control" placeholder="مثلاً کارشناس منابع انسانی" required />
                </div>
                <div class="mb-3">
                    <label asp-for="RoleCode" class="form-label">کد نقش</label>
                    <input asp-for="RoleCode" class="form-control" dir="ltr" placeholder="HR_EXPERT" required />
                    <div class="form-text">کد یکتا و انگلیسی؛ در کد و گزارش‌ها استفاده می‌شود.</div>
                </div>
                <div class="card-actions"><button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-plus me-1"></i>ثبت نقش</button></div>
            </form>
        </div>
    </div>
</div>

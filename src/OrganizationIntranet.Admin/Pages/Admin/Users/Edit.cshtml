@page
@model EditModel
@{
    ViewData["Title"] = Model.IsNew ? "افزودن کاربر" : "ویرایش کاربر";
    Layout = "_LayoutAdmin";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-page="/Admin/Index">مدیریت</a></li>
    <li class="breadcrumb-item"><a href="/Admin/Users">کاربران</a></li>
    <li aria-current="page" class="breadcrumb-item active">@ViewData["Title"]</li>
</ol>

<div class="card custom-card">
    <div class="card-header">
        <div class="card-title d-flex align-items-center gap-2">
            <span class="avatar avatar-sm avatar-rounded bg-primary-transparent"><i class="ti ti-user-edit fs-14"></i></span>
            @ViewData["Title"]
        </div>
    </div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div id="errorMessageData" class="d-none">@Model.ErrorMessage</div>
        }

        <form method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <h6 class="fw-semibold text-primary mb-3"><i class="ti ti-id-badge-2 me-1"></i>اطلاعات هویتی</h6>
            <div class="row gy-3">
                <div class="col-xl-6">
                    <label class="form-label">نام</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="col-xl-6">
                    <label class="form-label">نام خانوادگی</label>
                    <input asp-for="LastName" class="form-control" required />
                </div>
                <div class="col-xl-6">
                    <label class="form-label">کد ملی</label>
                    <input asp-for="NationalId" class="form-control" maxlength="10" dir="ltr" />
                </div>
                <div class="col-xl-6">
                    <label class="form-label">شماره همراه</label>
                    <input asp-for="MobileNumber" class="form-control" maxlength="11" dir="ltr" />
                </div>
                <div class="col-xl-6">
                    <label class="form-label">ایمیل</label>
                    <input asp-for="Email" class="form-control" dir="ltr" />
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-semibold text-primary mb-3"><i class="ti ti-lock me-1"></i>اطلاعات ورود</h6>
            <div class="row gy-3">
                <div class="col-xl-6">
                    <label class="form-label">نام کاربری</label>
                    <input asp-for="Username" class="form-control" dir="ltr" required />
                </div>
                <div class="col-xl-6">
                    <label class="form-label">@(Model.IsNew ? "رمز عبور" : "رمز عبور جدید (اختیاری)")</label>
                    <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" />
                </div>
                <div class="col-xl-6 d-flex align-items-center">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label class="form-check-label" for="IsActive">کاربر فعال است</label>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <h6 class="fw-semibold text-primary mb-3"><i class="ti ti-shield-lock me-1"></i>نقش‌ها و سطح دسترسی</h6>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var role in Model.AllRoles)
                {
                    var isChecked = Model.SelectedRoleIds.Contains(role.RoleId);
                    <label class="border rounded-3 px-3 py-2 d-flex align-items-center gap-2 @(isChecked ? "border-primary bg-primary-transparent" : "")" style="cursor:pointer;">
                        <input type="checkbox" class="form-check-input m-0" name="SelectedRoleIds" value="@role.RoleId"
                               id="role-@role.RoleId" checked="@isChecked" />
                        <span class="fw-medium">@role.RoleName</span>
                    </label>
                }
                @if (Model.AllRoles.Count == 0)
                {
                    <span class="text-muted fs-13">هیچ نقشی تعریف نشده است.</span>
                }
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button>
                <a href="/Admin/Users" class="btn btn-light border btn-wave">انصراف</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var errorEl = document.getElementById('errorMessageData');
            if (errorEl) showToast(errorEl.textContent, 'danger');
        })();
    </script>
}

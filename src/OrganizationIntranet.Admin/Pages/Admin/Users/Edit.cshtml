@page
@model EditModel
@{
    ViewData["Title"] = Model.IsNew ? "افزودن کاربر" : "ویرایش کاربر";
    ViewData["Icon"] = Model.IsNew ? "ti ti-user-plus" : "ti ti-user-edit";
    ViewData["Subtitle"] = Model.IsNew ? "حساب جدید بسازید و نقش‌های آن را مشخص کنید" : $"{Model.Name} {Model.LastName}".Trim();
    ViewData["ParentTitle"] = "کاربران";
    ViewData["ParentUrl"] = "/Admin/Users";
    Layout = "_LayoutAdmin";
    var canEdit = User.HasPermission(OrganizationIntranet.Contracts.AdminPermissions.UserEdit);
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(null, Model.ErrorMessage)' />

<form method="post" class="card custom-card" data-busy data-dirty-guard>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-id-badge-2"></i>اطلاعات هویتی</h2>
            <p class="form-section__help">کد ملی و شماره همراه برای «ورود با کد ملی و پیامک»، بازیابی رمز و پیامک‌های اطلاع‌رسانی استفاده می‌شوند.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Name" class="form-label">نام <span class="text-danger">*</span></label><input asp-for="Name" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="LastName" class="form-label">نام خانوادگی <span class="text-danger">*</span></label><input asp-for="LastName" class="form-control" required /></div>
            <div class="col-md-6"><label asp-for="NationalId" class="form-label">کد ملی</label><input asp-for="NationalId" class="form-control" maxlength="10" inputmode="numeric" dir="ltr" placeholder="۱۰ رقم" /></div>
            <div class="col-md-6"><label asp-for="MobileNumber" class="form-label">شماره همراه</label><input asp-for="MobileNumber" class="form-control" maxlength="11" inputmode="tel" dir="ltr" placeholder="09xxxxxxxxx" /></div>
            <div class="col-md-6"><label asp-for="Email" class="form-label">ایمیل</label><input asp-for="Email" type="email" class="form-control" dir="ltr" /></div>
            <div class="col-md-6">
                <label asp-for="UnitId" class="form-label">واحد سازمانی</label>
                <select asp-for="UnitId" class="form-select">
                    <option value="">— بدون واحد —</option>
                    @foreach (var unit in Model.Units.Where(u => u.IsActive || u.UnitId == Model.UnitId))
                    {
                        <option value="@unit.UnitId">@(string.Concat(Enumerable.Repeat("— ", unit.Depth)) + unit.Title)</option>
                    }
                </select>
                <div class="form-text">از «چارت سازمانی» ساخته می‌شود؛ بعداً دیدن سامانه‌ها و اعلان‌ها بر پایه‌ی آن تعیین می‌شود.</div>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-lock"></i>اطلاعات ورود</h2>
            <p class="form-section__help">@(Model.IsNew ? "برای کاربرانی که فقط با LDAP یا کد ملی وارد می‌شوند، رمز محلی را خالی بگذارید." : "برای حفظ رمز فعلی، فیلد رمز را خالی بگذارید.")</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Username" class="form-label">نام کاربری <span class="text-danger">*</span></label><input asp-for="Username" class="form-control" dir="ltr" required autocomplete="off" /></div>
            <div class="col-md-6"><label asp-for="NewPassword" class="form-label">@(Model.IsNew ? "رمز عبور" : "رمز عبور جدید")</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" required="@Model.IsNew" /></div>
            <div class="col-12">
                <div class="switch-row">
                    <div>
                        <label class="switch-row__label" for="IsActive">حساب فعال است</label>
                        <p class="switch-row__help">حساب غیرفعال نمی‌تواند وارد شود و دسترسی‌های آن اعمال نمی‌شود.</p>
                    </div>
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" />
                </div>
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-user-shield"></i>نقش‌ها</h2>
            <p class="form-section__help">نقش، سطح کلی دسترسی کاربر را تعیین می‌کند. برای کاربر موجود همان لحظه ثبت می‌شود.</p>
        </div>
        @if (Model.AllRoles.Count == 0)
        {
            <span class="text-muted fs-13">هیچ نقشی تعریف نشده است. <a href="/Admin/Roles">تعریف نقش</a></span>
        }
        else
        {
            @* فهرست کشویی قابل جست‌وجو (با ۳۰ نقش هم جا می‌گیرد)؛ برای کاربر موجود هر انتخاب همان لحظه ثبت می‌شود، برای کاربر جدید همراه فرم ذخیره می‌شود. *@
            <partial name="_EntityPicker" model='OrganizationIntranet.Pages.Shared.PickList.ForRoles("SelectedRoleIds", "نقش‌های کاربر", Model.AllRoles, Model.SelectedRoleIds, Model.IsNew ? null : Url.Page("Edit", "Role", new { id = Model.Id }))' />
        }
    </section>

    <div class="form-actions">
        @if (canEdit) { <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button> }
        <a href="/Admin/Users" class="btn btn-primary-light">انصراف</a>
    </div>
</form>

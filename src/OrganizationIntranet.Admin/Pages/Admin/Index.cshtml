@page
@model IndexModel
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "داشبورد";
    ViewData["HidePageHead"] = true; // کادر خوش‌آمد جای سربرگ صفحه را می‌گیرد
    Layout = "_LayoutAdmin";
    var activePercent = Model.TotalUsers == 0 ? 0 : (int)Math.Round(Model.ActiveUsers * 100.0 / Model.TotalUsers);
}

<section class="admin-hero mb-4" aria-labelledby="dashboard-title">
    <div class="admin-hero__text">
        <span class="admin-hero__eyebrow"><i class="ti ti-calendar" aria-hidden="true"></i>@Model.TodayPersian</span>
        <h1 id="dashboard-title">@(string.IsNullOrWhiteSpace(Model.AdminDisplayName) ? "خوش آمدید" : $"{Model.AdminDisplayName}، خوش آمدید")</h1>
        <p>پنل مدیریت اینترانت اداره کل بنادر و دریانوردی استان هرمزگان؛ کاربران، سامانه‌ها، درخواست‌های دسترسی و اطلاع‌رسانی سازمانی را از این‌جا مدیریت کنید.</p>
    </div>
    <partial name="_PortIllustration" />
</section>

<div class="row g-3 mb-4">
    <div class="col-xl-3 col-sm-6">
        <a class="stat-tile" href="/Admin/Users">
            <span class="stat-tile__icon bg-primary-transparent"><i class="ti ti-users"></i></span>
            <div class="flex-fill">
                <div class="stat-tile__value">@Model.TotalUsers.ToString("N0")</div>
                <div class="stat-tile__label">کل کاربران</div>
            </div>
        </a>
    </div>
    <div class="col-xl-3 col-sm-6">
        <a class="stat-tile" href="/Admin/Users">
            <span class="stat-tile__icon bg-success-transparent"><i class="ti ti-user-check"></i></span>
            <div class="flex-fill">
                <div class="stat-tile__value">@Model.ActiveUsers.ToString("N0")</div>
                <div class="stat-tile__label">کاربران فعال · @(activePercent)%</div>
                <div class="stat-tile__meter" role="progressbar" aria-label="درصد کاربران فعال" aria-valuenow="@activePercent" aria-valuemin="0" aria-valuemax="100"><span style="width:@(activePercent)%"></span></div>
            </div>
        </a>
    </div>
    <div class="col-xl-3 col-sm-6">
        <a class="stat-tile" href="/Admin/Roles">
            <span class="stat-tile__icon bg-warning-transparent"><i class="ti ti-user-shield"></i></span>
            <div class="flex-fill">
                <div class="stat-tile__value">@Model.TotalRoles.ToString("N0")</div>
                <div class="stat-tile__label">نقش‌ها</div>
            </div>
        </a>
    </div>
    <div class="col-xl-3 col-sm-6">
        <a class="stat-tile" href="/Admin/Applications">
            <span class="stat-tile__icon bg-info-transparent"><i class="ti ti-apps"></i></span>
            <div class="flex-fill">
                <div class="stat-tile__value">@Model.TotalApplications.ToString("N0")</div>
                <div class="stat-tile__label">سامانه‌ها</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-7">
        <div class="card custom-card h-100">
            <div class="card-header justify-content-between">
                <div class="card-title d-flex align-items-center gap-2">
                    درخواست‌های دسترسی در انتظار
                    <span class="badge @(Model.PendingRequests.Total > 0 ? "bg-warning" : "bg-light text-muted") rounded-pill">@Model.PendingRequests.Total</span>
                </div>
                <a href="/Admin/AccessRequests?status=Pending" class="btn btn-sm btn-primary-light">بررسی همه <i class="ti ti-arrow-left ms-1"></i></a>
            </div>
            <div class="card-body p-0">
                @if (Model.PendingRequests.Total == 0)
                {
                    <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-circle-check", "کاری در انتظار نیست", "درخواست دسترسی جدیدی برای بررسی وجود ندارد.")' />
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var request in Model.PendingRequests.Items.Take(5))
                        {
                            <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                <span class="entity__avatar">@(request.DisplayName.Length > 0 ? request.DisplayName[..1] : "?")</span>
                                <div class="flex-fill min-w-0">
                                    <div class="entity__name text-truncate">@request.DisplayName</div>
                                    <div class="entity__sub text-truncate"><i class="ti ti-apps me-1"></i>@request.ApplicationName · @request.CreatedAt.ToPersianDate()</div>
                                </div>
                                <a href="/Admin/AccessRequests?status=Pending" class="btn btn-sm btn-primary-light">بررسی</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
    <div class="col-xl-5">
        <div class="card custom-card h-100">
            <div class="card-header"><div class="card-title">دسترسی سریع</div></div>
            <div class="card-body">
                <nav class="quick-actions" aria-label="دسترسی سریع">
                    <a class="quick-action" href="/Admin/Users/Edit"><i class="ti ti-user-plus"></i>افزودن کاربر</a>
                    <a class="quick-action" href="/Admin/Publications/Edit"><i class="ti ti-speakerphone"></i>انتشار اطلاعیه</a>
                    <a class="quick-action" href="/Admin/Applications"><i class="ti ti-apps"></i>مدیریت سامانه‌ها</a>
                    <a class="quick-action" href="/Admin/Permissions"><i class="ti ti-lock-access"></i>مجوزها</a>
                    <a class="quick-action" href="/Admin/AccessRequests/Notifications"><i class="ti ti-message-2"></i>وضعیت پیامک‌ها</a>
                    <a class="quick-action" href="/Admin/Authentication"><i class="ti ti-fingerprint"></i>ورود و امنیت</a>
                </nav>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card custom-card">
            <div class="card-header justify-content-between">
                <div class="card-title">آخرین کاربران ثبت‌شده</div>
                <a href="/Admin/Users" class="btn btn-sm btn-primary-light">مشاهده همه <i class="ti ti-arrow-left ms-1"></i></a>
            </div>
            <div class="card-body p-0">
                @if (Model.RecentUsers.Count == 0)
                {
                    <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-users", "کاربری ثبت نشده است", null, "افزودن کاربر", "/Admin/Users/Edit")' />
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-admin text-nowrap">
                            <thead><tr><th>کاربر</th><th>تاریخ ثبت</th><th>آخرین ورود</th><th>وضعیت</th><th class="col-actions">عملیات</th></tr></thead>
                            <tbody>
                                @foreach (var u in Model.RecentUsers)
                                {
                                    <tr>
                                        <td>
                                            <div class="entity">
                                                <span class="entity__avatar">@(u.Name.Length > 0 ? u.Name[..1] : "?")</span>
                                                <div><div class="entity__name">@u.Name @u.LastName</div><div class="entity__sub" dir="ltr">@u.Username</div></div>
                                            </div>
                                        </td>
                                        <td>@u.CreatedAt.ToPersianDate()</td>
                                        <td>@(u.LastLogin.HasValue ? u.LastLogin.ToPersianDate() : "—")</td>
                                        <td><span class="status-pill @(u.IsActive ? "status-pill--success" : "status-pill--danger")">@(u.IsActive ? "فعال" : "غیرفعال")</span></td>
                                        <td class="col-actions"><a href="/Admin/Users/Edit?id=@u.UserId" class="btn btn-icon btn-sm btn-primary-light" title="ویرایش @u.Name @u.LastName" aria-label="ویرایش @u.Name @u.LastName"><i class="ti ti-edit"></i></a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.Welcome)
    {
        <script>
            showToast(@Html.Raw(Json.Serialize($"خوش آمدید، {Model.AdminDisplayName}")), 'success');
        </script>
    }
}

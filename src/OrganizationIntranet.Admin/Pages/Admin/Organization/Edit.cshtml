@page
@model EditModel
@using P = OrganizationIntranet.Contracts.AdminPermissions
@{
    var unit = Model.Unit;
    var canEdit = User.HasPermission(P.OrgEdit);
    var canDelete = unit.ChildCount == 0 && unit.UserCount == 0;
    var subtree = Model.SubtreeIds();
    ViewData["Title"] = canEdit ? "ویرایش واحد" : "جزئیات واحد";
    ViewData["Icon"] = "ti ti-sitemap";
    ViewData["Subtitle"] = unit.FullPath;
    ViewData["ParentTitle"] = "چارت سازمانی";
    ViewData["ParentUrl"] = "/Admin/Organization";
    Layout = "_LayoutAdmin";
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(null, Model.ErrorMessage)' />

<form method="post" class="card custom-card" data-busy data-dirty-guard>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-building"></i>مشخصات واحد</h2>
            <p class="form-section__help">با تغییر عنوان یا جابه‌جایی، مسیر کامل این واحد و همه‌ی زیرمجموعه‌هایش خودکار به‌روز می‌شود.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Title" class="form-label">عنوان واحد <span class="text-danger">*</span></label><input asp-for="Title" class="form-control" maxlength="200" required readonly="@(!canEdit)" /><div class="form-text">نباید شامل «/» باشد.</div></div>
            <div class="col-md-6">
                <label asp-for="ParentId" class="form-label">زیر مجموعه‌ی</label>
                <select asp-for="ParentId" class="form-select" disabled="@(!canEdit)">
                    <option value="">— واحد اصلی (ریشه) —</option>
                    @foreach (var u in Model.Units.Where(u => !subtree.Contains(u.UnitId) && (u.IsActive || u.UnitId == unit.ParentId)))
                    {
                        <option value="@u.UnitId">@(string.Concat(Enumerable.Repeat("— ", u.Depth)) + u.Title)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="DisplayOrder" class="form-label">ترتیب نمایش</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" dir="ltr" min="0" max="10000" readonly="@(!canEdit)" />
                <div class="form-text">میان واحدهای هم‌سطح، عدد کوچک‌تر بالاتر می‌آید.</div>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" role="switch" disabled="@(!canEdit)" />
                    <label asp-for="IsActive" class="form-check-label">واحد فعال است</label>
                </div>
            </div>
            <div class="col-12 d-flex flex-wrap gap-3 text-muted fs-12">
                <span>زیرمجموعه‌ی مستقیم: <b>@unit.ChildCount</b></span>
                <span>کاربران مستقیم: <b>@unit.UserCount</b></span>
            </div>
        </div>
    </section>

    <div class="form-actions">
        @if (canEdit) { <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button> }
        <a href="/Admin/Organization" class="btn btn-primary-light">@(canEdit ? "انصراف" : "بازگشت")</a>
    </div>
</form>

@if (canEdit)
{
    <div class="card custom-card border-danger-subtle">
        <div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="flex-fill">
                <div class="fw-semibold text-danger"><i class="ti ti-trash me-1"></i>حذف واحد</div>
                <p class="text-muted fs-13 mb-0">
                    @if (canDelete) { @:این واحد زیرمجموعه و کاربری ندارد و می‌توان آن را برای همیشه حذف کرد.
                    }
                    else { @:واحد در حال استفاده حذف نمی‌شود (@unit.ChildCount زیرمجموعه، @unit.UserCount کاربر). برای کنار گذاشتن آن، غیرفعالش کنید.
                    }
                </p>
            </div>
            @if (canDelete)
            {
                <form method="post" asp-page-handler="Delete" asp-route-id="@unit.UnitId" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger" data-confirm="@($"واحد «{unit.Title}» برای همیشه حذف شود؟")"><i class="ti ti-trash me-1"></i>حذف واحد</button>
                </form>
            }
        </div>
    </div>
}

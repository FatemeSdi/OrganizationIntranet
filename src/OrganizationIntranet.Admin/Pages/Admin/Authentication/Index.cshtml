@page
@model OrganizationIntranet.Pages.Admin.Authentication.IndexModel
@{
    ViewData["Title"] = "ورود و امنیت";
    ViewData["Icon"] = "ti ti-fingerprint";
    ViewData["Subtitle"] = "روش‌های ورود، ورود دومرحله‌ای و سرویس پیامک — مشترک برای پورتال و پنل مدیریت";
    Layout = "_LayoutAdmin";
}
@section PageActions {
    <a asp-page="/Account/Security" class="btn btn-primary-light"><i class="ti ti-shield-check me-1"></i>تنظیم Google Authenticator</a>
}

<div class="admin-callout admin-callout--warning mb-4">
    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
    <div>با ذخیره‌ی این تنظیمات، <strong>همه‌ی نشست‌های فعلی پایان می‌یابد</strong> و کاربران (از جمله شما) باید دوباره وارد شوند.</div>
</div>

<form method="post" autocomplete="off" class="card custom-card" data-busy data-dirty-guard>
    <input asp-for="Input.Revision" type="hidden" />
    <div asp-validation-summary="All" class="alert alert-danger m-3 mb-0" role="alert"></div>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-login"></i>روش‌های ورود</h2>
            <p class="form-section__help">روش‌های فعال در فهرست «روش ورود» صفحه‌ی ورود نمایش داده می‌شوند. حداقل یک روش باید فعال بماند. برای خاموش‌کردن رمز محلی، ابتدا LDAP را تنظیم و با آن وارد شوید.</p>
        </div>
        <div>
            <div class="switch-row">
                <div><label asp-for="Input.PasswordEnabled" class="switch-row__label">نام کاربری و رمز محلی</label><p class="switch-row__help">رمز در همین سامانه نگه‌داری می‌شود.</p></div>
                <input asp-for="Input.PasswordEnabled" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label asp-for="Input.LdapEnabled" class="switch-row__label">حساب سازمانی (LDAP)</label><p class="switch-row__help">کاربران LDAP باید از قبل در سامانه تعریف شده باشند.</p></div>
                <input asp-for="Input.LdapEnabled" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div>
                    <label asp-for="Input.NationalIdSmsEnabled" class="switch-row__label">کد ملی و پیامک</label>
                    <p class="switch-row__help">کاربر کد ملی را وارد می‌کند و با کد یک‌بارمصرفی که به شماره همراه ثبت‌شده‌اش پیامک می‌شود وارد می‌شود. به «روش پیامک» فعال و ثبت کد ملی و شماره همراه کاربر نیاز دارد. این روش یک‌عاملی است (در اختیار داشتن تلفن) و از ورود دومرحله‌ای عبور نمی‌کند؛ اگر ورود دومرحله‌ای الزامی است، آن را با آگاهی فعال کنید.</p>
                </div>
                <input asp-for="Input.NationalIdSmsEnabled" class="form-check-input" role="switch" />
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-server"></i>تنظیمات LDAP</h2>
            <p class="form-section__help">اتصال فقط رمزنگاری‌شده (LDAPS) است و گواهی سرور باید مورد اعتماد میزبان API باشد.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-5"><label asp-for="Input.LdapHost" class="form-label">میزبان LDAP</label><input asp-for="Input.LdapHost" class="form-control" dir="ltr" placeholder="dc.example.org" /></div>
            <div class="col-md-2"><label asp-for="Input.LdapPort" class="form-label">پورت LDAPS</label><input asp-for="Input.LdapPort" class="form-control" dir="ltr" /></div>
            <div class="col-md-5"><label asp-for="Input.LdapDomain" class="form-label">دامنه ورود (UPN)</label><input asp-for="Input.LdapDomain" class="form-control" dir="ltr" placeholder="example.org" /></div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-shield-lock"></i>ورود دومرحله‌ای و بازیابی</h2>
            <p class="form-section__help">پیش از اجباری‌کردن ورود دومرحله‌ای، کاربران باید Google Authenticator را تنظیم کرده یا شماره همراه ثبت‌شده و سرویس پیامک فعال داشته باشند.</p>
        </div>
        <div>
            <div class="switch-row">
                <div><label asp-for="Input.TwoFactorEnabled" class="switch-row__label">الزام ورود دومرحله‌ای برای همه</label><p class="switch-row__help">پس از رمز یا LDAP، یک مرحله‌ی تأیید دوم لازم است.</p></div>
                <input asp-for="Input.TwoFactorEnabled" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label asp-for="Input.AuthenticatorEnabled" class="switch-row__label">روش Google Authenticator</label></div>
                <input asp-for="Input.AuthenticatorEnabled" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label asp-for="Input.SmsEnabled" class="switch-row__label">روش پیامک</label><p class="switch-row__help">پیش‌نیاز ورود با کد ملی و بازیابی رمز.</p></div>
                <input asp-for="Input.SmsEnabled" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label asp-for="Input.ForgotPasswordEnabled" class="switch-row__label">فراموشی رمز با کد پیامکی</label><p class="switch-row__help">پیوند «رمز عبور را فراموش کرده‌اید؟» در صفحه‌ی ورود نمایش داده می‌شود.</p></div>
                <input asp-for="Input.ForgotPasswordEnabled" class="form-check-input" role="switch" />
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-message-2"></i>سرویس پیامک</h2>
            <p class="form-section__help">درگاه باید درخواست POST با فیلدهای to، sender و message و هدر <span dir="ltr">Authorization: Bearer</span> را بپذیرد. اگر ارائه‌دهنده قالب دیگری دارد، درگاه واسط سازمان را وارد کنید.</p>
        </div>
        <div class="row g-3">
            <div class="col-12"><label asp-for="Input.SmsEndpoint" class="form-label">نشانی HTTPS درگاه پیامک</label><input asp-for="Input.SmsEndpoint" class="form-control" dir="ltr" placeholder="https://sms.example.org/send" /></div>
            <div class="col-md-6"><label asp-for="Input.SmsSender" class="form-label">شناسه فرستنده</label><input asp-for="Input.SmsSender" class="form-control" dir="ltr" /></div>
            <div class="col-md-6">
                <label asp-for="Input.SmsApiKey" class="form-label">کلید سرویس پیامک</label>
                <input asp-for="Input.SmsApiKey" type="password" class="form-control" autocomplete="new-password" value="" />
                <div class="form-text">@(Model.Input.HasSmsApiKey ? "کلید قبلاً ذخیره شده است؛ خالی گذاشتن یعنی حفظ کلید فعلی." : "هنوز کلیدی ذخیره نشده است.")</div>
            </div>
        </div>
    </section>

    <div class="form-actions">
        <button class="btn btn-primary btn-wave" type="submit" data-confirm="با ذخیره، همه‌ی نشست‌ها پایان می‌یابد و باید دوباره وارد شوید. ادامه می‌دهید؟"><i class="ti ti-device-floppy me-1"></i>ذخیره تنظیمات و ورود مجدد</button>
    </div>
</form>

@page
@model AssignModel
@{
    ViewData["Title"] = "اختصاص مجوز به نقش‌ها";
    ViewData["Icon"] = "ti ti-user-shield";
    ViewData["Subtitle"] = Model.Permission!.PermissionName;
    ViewData["ParentTitle"] = "مجوزها";
    ViewData["ParentUrl"] = "/Admin/Permissions";
    Layout = "_LayoutAdmin";
    var canEdit = User.HasPermission(OrganizationIntranet.Contracts.AdminPermissions.PermissionEdit);
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(null, Model.ErrorMessage)' />

<form method="post" class="card custom-card" data-busy data-dirty-guard>
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-lock-access"></i>مشخصات مجوز</h2>
            <p class="form-section__help">مجوزها در لحظه‌ی ورود در نشست کاربر بارگذاری می‌شوند؛ تغییر این صفحه پس از ورود دوباره‌ی کاربران اعمال می‌شود.</p>
        </div>
        <dl class="row mb-0 fs-13">
            <dt class="col-sm-3 text-muted fw-medium">سامانه</dt><dd class="col-sm-9"><span class="badge bg-primary-transparent">@Model.Permission.ApplicationName</span></dd>
            <dt class="col-sm-3 text-muted fw-medium">نام</dt><dd class="col-sm-9 fw-semibold">@Model.Permission.PermissionName</dd>
            <dt class="col-sm-3 text-muted fw-medium">کد</dt><dd class="col-sm-9"><span class="code-chip">@Model.Permission.PermissionCode</span></dd>
            @if (!string.IsNullOrEmpty(Model.Permission.Description))
            {
                <dt class="col-sm-3 text-muted fw-medium">توضیحات</dt><dd class="col-sm-9 mb-0">@Model.Permission.Description</dd>
            }
        </dl>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-user-shield"></i>نقش‌های دارای این مجوز</h2>
            <p class="form-section__help">فقط نقش‌های فعال نمایش داده می‌شوند.</p>
        </div>
        <div class="row g-2">
            @foreach (var role in Model.AllRoles)
            {
                <div class="col-md-6">
                    <div class="switch-row mb-0">
                        <label class="switch-row__label" for="role-@role.RoleId">@role.RoleName <span class="code-chip ms-1">@role.RoleCode</span></label>
                        @if (OrganizationIntranet.Contracts.AdminPermissions.IsSystem(Model.Permission.PermissionCode) && role.RoleCode == OrganizationIntranet.Contracts.AdminPermissions.AdminRoleCode)
                        {
                            @* مجوز سیستمی همیشه برای نقش مدیر می‌ماند؛ کنترل غیرفعال است و مقدار با فیلد پنهان ارسال می‌شود *@
                            <input type="hidden" name="SelectedRoleIds" value="@role.RoleId" />
                            <input type="checkbox" class="form-check-input" role="switch" id="role-@role.RoleId" checked disabled title="مجوز سیستمی از نقش مدیر گرفته نمی‌شود" />
                        }
                        else
                        {
                            <input type="checkbox" class="form-check-input" role="switch" name="SelectedRoleIds" value="@role.RoleId" id="role-@role.RoleId" checked="@Model.SelectedRoleIds.Contains(role.RoleId)" disabled="@(!canEdit)" />
                        }
                    </div>
                </div>
            }
            @if (Model.AllRoles.Count == 0)
            {
                <div class="col-12"><span class="text-muted fs-13">هیچ نقش فعالی تعریف نشده است. <a href="/Admin/Roles">تعریف نقش</a></span></div>
            }
        </div>
    </section>

    <div class="form-actions">
        @if (canEdit) { <button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-device-floppy me-1"></i>ذخیره</button> }
        <a href="/Admin/Permissions" class="btn btn-primary-light">انصراف</a>
    </div>
</form>

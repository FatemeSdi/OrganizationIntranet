@page
@model IndexModel
@{
    ViewData["Title"] = "مجوزها (Permission)";
    ViewData["Icon"] = "ti ti-lock-access";
    ViewData["Subtitle"] = "سطح دقیق دسترسی به هر سامانه؛ هر مجوز به یک یا چند نقش اختصاص داده می‌شود";
    Layout = "_LayoutAdmin";
    var canEdit = User.HasPermission(OrganizationIntranet.Contracts.AdminPermissions.PermissionEdit);
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(TempData["SuccessMessage"] as string, Model.ErrorMessage)' />

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card custom-card" data-filter-scope data-page-size="10" data-noun="مجوز">
            @if (Model.AllPermissions.Count == 0)
            {
                <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-lock-access", "مجوزی تعریف نشده است", "ابتدا سامانه را انتخاب و مجوز آن را از فرم کناری ثبت کنید.")' />
            }
            else
            {
                <div class="admin-toolbar" role="search">
                    <div class="admin-toolbar__search"><i class="ti ti-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="جست‌وجوی نام یا کد مجوز" aria-label="جست‌وجوی مجوزها" data-filter="search" /></div>
                    <select class="form-select" aria-label="فیلتر سامانه" data-filter="app">
                        <option value="">همه سامانه‌ها</option>
                        @foreach (var name in Model.AllPermissions.Select(p => p.ApplicationName).Distinct().Order()) { <option value="@name">@name</option> }
                    </select>
                    <span class="admin-toolbar__count"><span data-filter-count>@Model.AllPermissions.Count</span> مجوز</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-admin text-nowrap">
                        <thead><tr><th>مجوز</th><th>سامانه</th><th>نقش‌ها</th><th>وضعیت</th><th class="col-actions">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var permission in Model.AllPermissions)
                            {
                                <tr data-row data-search="@permission.PermissionName @permission.PermissionCode" data-app="@permission.ApplicationName">
                                    <td>
                                        <div class="entity__name">@permission.PermissionName</div>
                                        <span class="code-chip">@permission.PermissionCode</span>
                                    </td>
                                    <td><span class="badge bg-primary-transparent">@permission.ApplicationName</span></td>
                                    <td>
                                        @if (permission.RoleCount == 0) { <span class="status-pill status-pill--warning" title="این مجوز به هیچ نقشی داده نشده است">بدون نقش</span> }
                                        else { <span class="fw-semibold">@permission.RoleCount</span> <span class="text-muted fs-12">نقش</span> }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Toggle" asp-route-permissionId="@permission.PermissionId" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <div class="form-check form-switch d-inline-flex align-items-center gap-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="perm-toggle-@permission.PermissionId" checked="@permission.IsActive" data-autosubmit disabled="@(!canEdit || (permission.IsActive && OrganizationIntranet.Contracts.AdminPermissions.IsSystem(permission.PermissionCode)))" title="@(OrganizationIntranet.Contracts.AdminPermissions.IsSystem(permission.PermissionCode) ? "مجوز سیستمی پنل مدیریت" : null)"
                                                       data-confirm-off="@($"مجوز «{permission.PermissionName}» غیرفعال شود؟")" />
                                                <label class="form-check-label" for="perm-toggle-@permission.PermissionId"><span class="status-pill @(permission.IsActive ? "status-pill--success" : "status-pill--muted")">@(permission.IsActive ? "فعال" : "غیرفعال")</span></label>
                                            </div>
                                        </form>
                                    </td>
                                    <td class="col-actions">
                                        <a href="/Admin/Permissions/Assign?id=@permission.PermissionId" class="btn btn-sm btn-primary-light"><i class="ti ti-user-shield me-1"></i>اختصاص به نقش‌ها</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div data-filter-empty hidden><partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-search-off", "مجوزی پیدا نشد")' /></div>
                <div class="admin-pager" data-pager hidden></div>
            }
        </div>
    </div>

    @if (canEdit)
    {
    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header"><div class="card-title"><i class="ti ti-square-rounded-plus text-primary me-1"></i>افزودن مجوز</div></div>
            <form method="post" asp-page-handler="Create" class="card-body" data-busy>
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label asp-for="ApplicationId" class="form-label">سامانه</label>
                    <select asp-for="ApplicationId" class="form-select" required>
                        <option value="">انتخاب کنید</option>
                        @foreach (var app in Model.AllApplications) { <option value="@app.ApplicationId">@app.ApplicationName</option> }
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="PermissionName" class="form-label">نام مجوز</label>
                    <input asp-for="PermissionName" class="form-control" placeholder="مثلاً مشاهده گزارش تردد" required />
                </div>
                <div class="mb-3">
                    <label asp-for="PermissionCode" class="form-label">کد مجوز</label>
                    <input asp-for="PermissionCode" class="form-control" dir="ltr" placeholder="ACCESS_REPORT_VIEW" required />
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label">توضیحات</label>
                    <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                </div>
                <div class="card-actions"><button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-plus me-1"></i>ثبت مجوز</button></div>
            </form>
        </div>
    </div>
    }
</div>

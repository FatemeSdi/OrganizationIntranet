@page
@model OrganizationIntranet.Pages.Admin.AccessRequests.NotificationsModel
@{
    ViewData["Title"] = "پیامک درخواست‌های دسترسی";
    ViewData["Icon"] = "ti ti-message-2";
    ViewData["Subtitle"] = "صف و سابقه‌ی پیامک‌های اطلاع‌رسانی درخواست‌های دسترسی";
    ViewData["ParentTitle"] = "درخواست‌های دسترسی";
    ViewData["ParentUrl"] = "/Admin/AccessRequests";
    Layout = "_LayoutAdmin";
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(TempData["SuccessMessage"] as string, Model.ErrorMessage)' />

<div class="admin-callout mb-4">
    <i class="ti ti-info-circle" aria-hidden="true"></i>
    <div>پیامک‌ها از سرویس تنظیم‌شده در «ورود و امنیت» ارسال می‌شوند. روش اطلاع‌رسانی و گروه‌های نظارت در تنظیمات هر سامانه انتخاب می‌شود.</div>
</div>

<div class="card custom-card">
    @if (Model.Result.Items.Count == 0)
    {
        <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-message-2", "پیامکی در صف یا سابقه وجود ندارد")' />
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-admin text-nowrap">
                <thead><tr><th>سامانه</th><th>گیرنده</th><th>درخواست</th><th>وضعیت</th><th>تلاش</th><th class="col-actions">عملیات</th></tr></thead>
                <tbody>
                    @foreach (var sms in Model.Result.Items)
                    {
                        var (label, tone) = sms.Status switch
                        {
                            "Pending" => ("در صف ارسال", "info"), "Processing" => ("در حال ارسال", "primary"), "Sent" => ("ارسال‌شده", "success"),
                            "Failed" => ("ناموفق", "danger"), "Cancelled" => ("لغوشده", "muted"), _ => (sms.Status, "muted")
                        };
                        <tr>
                            <td class="fw-semibold">@sms.ApplicationName</td>
                            <td dir="ltr" class="text-end">@sms.Recipient</td>
                            <td>#@sms.RequestId</td>
                            <td>
                                <span class="status-pill status-pill--@tone">@label</span>
                                @if (sms.Error is not null) { <div class="text-danger fs-12 mt-1 text-wrap" style="max-width:320px">@sms.Error</div> }
                            </td>
                            <td>@sms.Attempts</td>
                            <td class="col-actions">
                                @if (sms.Status == "Failed")
                                {
                                    <form method="post" asp-page-handler="Retry" class="m-0" data-busy>
                                        <input type="hidden" name="alertId" value="@sms.Id" />
                                        <button class="btn btn-sm btn-primary-light" type="submit" title="پس از اصلاح تنظیمات پیامک"><i class="ti ti-refresh me-1"></i>تلاش مجدد</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_ServerPager" model='new OrganizationIntranet.Pages.Shared.ServerPager(Model.PageNumber, Model.Result.PageSize, Model.Result.Total, "پیامک")' />
    }
</div>

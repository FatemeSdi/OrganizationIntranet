@page
@model OrganizationIntranet.Pages.Admin.Publications.IndexModel
@using OrganizationIntranet.Contracts
@using OrganizationIntranet.Helper
@{
    ViewData["Title"] = "اطلاع‌رسانی سازمانی";
    ViewData["Icon"] = "ti ti-speakerphone";
    ViewData["Subtitle"] = "اخبار، اطلاعیه‌ها و بخشنامه‌های پورتال";
    Layout = "_LayoutAdmin";
    var filtered = !string.IsNullOrEmpty(Model.Search) || !string.IsNullOrEmpty(Model.Kind);
}
@section PageActions {
    <a asp-page="Edit" class="btn btn-primary btn-wave"><i class="ti ti-plus me-1"></i>افزودن محتوا</a>
}

<partial name="_ToastMessages" model='new OrganizationIntranet.Pages.Shared.ToastMessages(TempData["SuccessMessage"] as string)' />

<div class="card custom-card">
    <form method="get" class="admin-toolbar" role="search">
        <div class="admin-toolbar__search"><i class="ti ti-search" aria-hidden="true"></i><input asp-for="Search" type="search" maxlength="200" class="form-control" placeholder="جست‌وجو در عنوان و خلاصه" aria-label="جست‌وجو در عنوان و خلاصه" /></div>
        <select asp-for="Kind" class="form-select" aria-label="نوع محتوا" onchange="this.form.requestSubmit ? this.form.requestSubmit() : this.form.submit()">
            <option value="">همه انواع</option>
            @foreach (var kind in new[] { "News", "Announcement", "Circular" }) { <option value="@kind">@PublicationKinds.Label(kind)</option> }
        </select>
        <button class="btn btn-primary" type="submit"><i class="ti ti-search me-1"></i>جست‌وجو</button>
        @if (filtered) { <a asp-page="Index" class="btn btn-primary-light" title="پاک‌کردن فیلترها" aria-label="پاک‌کردن فیلترها"><i class="ti ti-filter-off"></i></a> }
        <span class="admin-toolbar__count">@Model.Result.Total مطلب</span>
    </form>

    <div class="card-body">
        @if (Model.Result.Items.Count == 0)
        {
            if (filtered)
            {
                <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-search-off", "مطلبی پیدا نشد", "عبارت جست‌وجو یا نوع محتوا را تغییر دهید.")' />
            }
            else
            {
                <partial name="_EmptyState" model='new OrganizationIntranet.Pages.Shared.EmptyState("ti ti-speakerphone", "هنوز مطلبی ثبت نشده است", "اولین خبر، اطلاعیه یا بخشنامه را بنویسید.", "افزودن محتوا", "/Admin/Publications/Edit")' />
            }
        }
        <div class="item-list">
            @foreach (var item in Model.Result.Items)
            {
                <article class="item-card @(item.IsPublished ? (item.IsPublic ? "item-card--success" : "item-card--primary") : "item-card--muted")">
                    <div class="d-flex flex-wrap align-items-center gap-1">
                        <span class="badge bg-primary-transparent">@PublicationKinds.Label(item.Kind)</span>
                        <span class="status-pill @(item.IsPublished ? "status-pill--success" : "status-pill--muted")">@(item.IsPublished ? "منتشرشده" : "پیش‌نویس")</span>
                        @if (item.IsPublic) { <span class="status-pill status-pill--info" title="بازدیدکننده‌ی بدون ورود هم می‌بیند"><i class="ti ti-world"></i> عمومی</span> }
                        <a asp-page="Edit" asp-route-id="@item.PublicationId" class="btn btn-sm btn-primary-light ms-auto"><i class="ti ti-edit me-1"></i>ویرایش</a>
                    </div>
                    <div class="d-flex gap-3 align-items-start">
                        @if (item.HasImage) { <img class="item-card__thumb mt-2" src="/Admin/Publications/Image?id=@item.PublicationId&v=@item.ImageVersion" alt="" loading="lazy" /> }
                        <div class="min-w-0">
                            <h2 class="item-card__title"><a asp-page="Edit" asp-route-id="@item.PublicationId">@item.Title</a></h2>
                            <p class="item-card__text">@item.Summary</p>
                        </div>
                    </div>
                    <div class="item-card__meta">
                        <span><i class="ti ti-calendar"></i>@(item.PublishedAt.HasValue ? "انتشار: " + item.PublishedAt.ToPersianDate() : "ایجاد: " + item.CreatedAt.ToPersianDate())</span>
                    </div>
                </article>
            }
        </div>
    </div>

    <partial name="_ServerPager" model='new OrganizationIntranet.Pages.Shared.ServerPager(Model.PageNumber, Model.Result.PageSize, Model.Result.Total, "مطلب", new Dictionary<string, string?> { ["kind"] = Model.Kind, ["search"] = Model.Search })' />
</div>

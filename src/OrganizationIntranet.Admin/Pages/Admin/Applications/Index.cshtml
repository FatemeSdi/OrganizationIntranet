@page
@model IndexModel
@using OrganizationIntranet.Pages.Shared
@{
    ViewData["Title"] = "سامانه‌ها";
    ViewData["Icon"] = "ti ti-apps";
    ViewData["Subtitle"] = "سامانه‌هایی که در پورتال نمایش داده می‌شوند و دسترسی به آن‌ها";
    Layout = "_LayoutAdmin";
    var canEdit = User.HasPermission(OrganizationIntranet.Contracts.AdminPermissions.ApplicationEdit);
}
@section PageActions {
    @if (canEdit) { <a asp-page="Import" class="btn btn-primary-light"><i class="ti ti-file-import me-1"></i>ثبت فهرست سامانه‌های سازمان</a> }
}

<partial name="_ToastMessages" model='new ToastMessages(TempData["SuccessMessage"] as string, Model.ErrorMessage)' />

<div class="row g-4">
    <div class="col-xl-8">
        <div class="card custom-card" data-filter-scope data-page-size="10" data-noun="سامانه">
            @if (Model.AllApplications.Count == 0)
            {
                <partial name="_EmptyState" model='new EmptyState("ti ti-apps", "سامانه‌ای ثبت نشده است", "سامانه را از فرم کناری اضافه کنید یا فهرست سامانه‌های سازمان را یک‌جا ثبت کنید.", "ثبت فهرست سامانه‌ها", "/Admin/Applications/Import")' />
            }
            else
            {
                <div class="admin-toolbar" role="search">
                    <div class="admin-toolbar__search"><i class="ti ti-search" aria-hidden="true"></i><input type="search" class="form-control" placeholder="جست‌وجوی نام، کد یا نشانی" aria-label="جست‌وجوی سامانه‌ها" data-filter="search" /></div>
                    <select class="form-select" aria-label="فیلتر وضعیت" data-filter="status">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="active">فعال</option>
                        <option value="inactive">غیرفعال</option>
                    </select>
                    <span class="admin-toolbar__count"><span data-filter-count>@Model.AllApplications.Count</span> سامانه</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-admin text-nowrap">
                        <thead><tr><th>سامانه</th><th>ویژگی‌ها</th><th>ترتیب</th><th>وضعیت</th><th class="col-actions">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var app in Model.AllApplications.OrderBy(a => a.DisplayOrder).ThenBy(a => a.ApplicationName))
                            {
                                <tr data-row data-search="@app.ApplicationName @app.ApplicationCode @app.BaseUrl" data-status="@(app.IsActive ? "active" : "inactive")">
                                    <td>
                                        <div class="entity">
                                            <span class="entity__avatar entity__avatar--square bg-info-transparent text-info">
                                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><use href="/assets/images/application-icons.svg#@(app.Icon ?? "apps")"></use></svg>
                                            </span>
                                            <div class="min-w-0">
                                                <div class="entity__name">@app.ApplicationName <span class="code-chip ms-1">@app.ApplicationCode</span></div>
                                                @if (!string.IsNullOrEmpty(app.BaseUrl)) { <div class="entity__sub text-truncate" dir="ltr" style="max-width:280px">@app.BaseUrl</div> }
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @if (app.IsPublic) { <span class="badge bg-success-transparent me-1" title="بدون نیاز به تخصیص دسترسی">عمومی</span> }
                                        @if (!app.RequiresLogin) { <span class="badge bg-warning-transparent me-1" title="بدون نیاز به ورود">بدون ورود</span> }
                                        @if (app.IsInternetAccessible) { <span class="badge bg-info-transparent me-1">اینترنتی</span> }
                                        @if (!app.IsPublic && app.RequiresLogin && !app.IsInternetAccessible) { <span class="text-muted fs-12">داخلی · با تخصیص</span> }
                                    </td>
                                    <td>@app.DisplayOrder</td>
                                    <td>
                                        <form method="post" asp-page-handler="Toggle" asp-route-applicationId="@app.ApplicationId" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <div class="form-check form-switch d-inline-flex align-items-center gap-2 m-0">
                                                <input class="form-check-input" type="checkbox" role="switch" id="app-toggle-@app.ApplicationId" checked="@app.IsActive" data-autosubmit disabled="@(!canEdit)"
                                                       data-confirm-off="@($"سامانه «{app.ApplicationName}» از پورتال همه‌ی کاربران پنهان شود؟")" />
                                                <label class="form-check-label" for="app-toggle-@app.ApplicationId"><span class="status-pill @(app.IsActive ? "status-pill--success" : "status-pill--muted")">@(app.IsActive ? "فعال" : "غیرفعال")</span></label>
                                            </div>
                                        </form>
                                    </td>
                                    <td class="col-actions">
                                        <a asp-page="Edit" asp-route-id="@app.ApplicationId" class="btn btn-sm btn-primary-light"><i class="ti ti-settings me-1"></i>تنظیمات و دسترسی</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div data-filter-empty hidden><partial name="_EmptyState" model='new EmptyState("ti ti-search-off", "سامانه‌ای پیدا نشد")' /></div>
                <div class="admin-pager" data-pager hidden></div>
            }
        </div>
    </div>

    @if (canEdit)
    {
    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header"><div class="card-title"><i class="ti ti-square-rounded-plus text-primary me-1"></i>افزودن سامانه</div></div>
            <form method="post" asp-page-handler="Create" class="card-body" data-busy>
                @Html.AntiForgeryToken()
                <div class="mb-3"><label asp-for="ApplicationName" class="form-label">نام سامانه</label><input asp-for="ApplicationName" class="form-control" placeholder="مثلاً اتوماسیون اداری" required /></div>
                <div class="mb-3"><label asp-for="ApplicationCode" class="form-label">کد سامانه</label><input asp-for="ApplicationCode" class="form-control" dir="ltr" placeholder="AUTOMATION" required /></div>
                <div class="mb-3"><label asp-for="BaseUrl" class="form-label">نشانی ورود</label><input asp-for="BaseUrl" class="form-control" dir="ltr" placeholder="https://..." /></div>
                <div class="mb-3"><label asp-for="Description" class="form-label">خلاصه کارکرد</label><textarea asp-for="Description" class="form-control" rows="2"></textarea></div>
                <div class="row g-2 mb-3">
                    <div class="col-6"><label asp-for="DisplayOrder" class="form-label">ترتیب نمایش</label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
                    <div class="col-6"><label asp-for="Icon" class="form-label">آیکن</label><select asp-for="Icon" class="form-select">
                        @foreach (var icon in OrganizationIntranet.Contracts.ApplicationCatalogOptions.Icons) { <option value="@icon">@AdminLabels.Icon(icon)</option> }
                    </select></div>
                </div>
                <div class="switch-row"><label class="switch-row__label" for="RequiresLogin">نیازمند ورود در سامانه</label><input asp-for="RequiresLogin" class="form-check-input" role="switch" /></div>
                <div class="switch-row"><label class="switch-row__label" for="IsInternetAccessible">قابل دسترسی از اینترنت</label><input asp-for="IsInternetAccessible" class="form-check-input" role="switch" /></div>
                <div class="switch-row">
                    <div><label class="switch-row__label" for="IsPublic">عمومی</label><p class="switch-row__help">برای همه‌ی کاربران فعال، بدون تخصیص دسترسی</p></div>
                    <input asp-for="IsPublic" class="form-check-input" role="switch" />
                </div>
                <div class="my-3"><label asp-for="AccessRequestNotificationChannels" class="form-label">اطلاع‌رسانی درخواست‌های دسترسی</label><select asp-for="AccessRequestNotificationChannels" class="form-select">
                    @foreach (var channel in new[] { "InApp", "Sms", "Both" }) { <option value="@channel">@AdminLabels.NotificationChannel(channel)</option> }
                </select></div>
                <div class="card-actions"><button type="submit" class="btn btn-primary btn-wave"><i class="ti ti-plus me-1"></i>ثبت سامانه</button></div>
            </form>
        </div>
    </div>
    }
</div>

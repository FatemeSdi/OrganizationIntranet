@page
@model IndexModel
@{
    ViewData["Title"] = "سامانه‌ها";
    Layout = "_LayoutAdmin";
}

<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-page="/Admin/Index">مدیریت</a></li>
    <li aria-current="page" class="breadcrumb-item active">سامانه‌ها</li>
</ol>

@if (TempData["SuccessMessage"] != null)
{
    <div id="successMessageData" class="d-none">@TempData["SuccessMessage"]</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div id="errorMessageData" class="d-none">@Model.ErrorMessage</div>
}

<div class="row">
    <div class="col-xl-4">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm avatar-rounded bg-info-transparent"><i class="ti ti-square-rounded-plus fs-14"></i></span>
                    افزودن سامانه جدید
                </div>
            </div>
            <div class="card-body">
                <form method="post" asp-page-handler="Create">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">نام سامانه</label>
                        <input asp-for="ApplicationName" class="form-control" placeholder="مثلاً اتوماسیون اداری" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">کد سامانه</label>
                        <input asp-for="ApplicationCode" class="form-control" dir="ltr" placeholder="مثلاً AUTOMATION" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">آدرس سامانه</label>
                        <input asp-for="BaseUrl" class="form-control" dir="ltr" placeholder="https://..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">توضیحات</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <input asp-for="DisplayOrder" type="number" class="form-control" />
                    </div>
                    <button type="submit" class="btn btn-primary btn-wave w-100"><i class="ti ti-plus me-1"></i>ثبت سامانه</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-xl-8">
        <div class="card custom-card">
            <div class="card-header">
                <div class="card-title d-flex align-items-center gap-2">
                    <span class="avatar avatar-sm avatar-rounded bg-info-transparent"><i class="ti ti-apps fs-14"></i></span>
                    لیست سامانه‌ها
                    <span class="badge bg-info-transparent rounded-pill">@Model.AllApplications.Count</span>
                </div>
            </div>
            <div class="card-body">
                @if (Model.AllApplications.Count == 0)
                {
                    <div class="text-center py-5">
                        <i class="ti ti-apps fs-40 text-muted op-5 d-block mb-2"></i>
                        <p class="text-muted mb-0">سامانه‌ای ثبت نشده است.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table text-nowrap text-center mb-0">
                            <thead>
                                <tr>
                                    <th>نام سامانه</th>
                                    <th>کد</th>
                                    <th>ترتیب</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var app in Model.AllApplications)
                                {
                                    <tr>
                                        <td class="fw-medium">@app.ApplicationName</td>
                                        <td dir="ltr"><span class="badge bg-light text-default border">@app.ApplicationCode</span></td>
                                        <td>@app.DisplayOrder</td>
                                        <td>
                                            <form method="post" asp-page-handler="Toggle" asp-route-applicationId="@app.ApplicationId">
                                                @Html.AntiForgeryToken()
                                                <label class="form-check form-switch status-switch d-inline-flex align-items-center gap-2 justify-content-center mb-0">
                                                    <input class="form-check-input" type="checkbox" role="switch"
                                                           checked="@app.IsActive" onchange="this.form.submit()"
                                                           title="@(app.IsActive ? "برای غیرفعال کردن کلیک کنید" : "برای فعال کردن کلیک کنید")" />
                                                    <span class="status-switch-label @(app.IsActive ? "text-success" : "text-danger")">
                                                        @(app.IsActive ? "فعال" : "غیرفعال")
                                                    </span>
                                                </label>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var successEl = document.getElementById('successMessageData');
            if (successEl) showToast(successEl.textContent, 'success');
            var errorEl = document.getElementById('errorMessageData');
            if (errorEl) showToast(errorEl.textContent, 'danger');
        })();
    </script>
}

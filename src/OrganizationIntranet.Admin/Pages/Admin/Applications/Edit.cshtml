@page
@model EditModel
@using OrganizationIntranet.Pages.Shared
@{
    ViewData["Title"] = "تنظیمات سامانه";
    ViewData["Icon"] = "ti ti-settings";
    ViewData["Subtitle"] = Model.Input.ApplicationName;
    ViewData["ParentTitle"] = "سامانه‌ها";
    ViewData["ParentUrl"] = "/Admin/Applications";
    Layout = "_LayoutAdmin";
    var canEdit = User.HasPermission(OrganizationIntranet.Contracts.AdminPermissions.ApplicationEdit);
}
@section PageActions {
    <a asp-page="Supervision" asp-route-id="@Model.Id" class="btn btn-primary-light"><i class="ti ti-eye me-1"></i>گروه‌های نظارت</a>
}

<partial name="_ToastMessages" model='new ToastMessages(TempData["SuccessMessage"] as string, Model.ErrorMessage)' />

<form method="post" class="card custom-card" data-busy data-dirty-guard>
    <input type="hidden" asp-for="Id" />

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-apps"></i>مشخصات سامانه</h2>
            <p class="form-section__help">نام، آیکن و خلاصه در کارت سامانه نمایش داده می‌شوند. اگر ترتیب نمایش خالی باشد، سامانه آخرین ردیف می‌شود.</p>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label asp-for="Input.ApplicationName" class="form-label">نام <span class="text-danger">*</span></label><input asp-for="Input.ApplicationName" class="form-control" required maxlength="150" /></div>
            <div class="col-md-6"><label asp-for="Input.ApplicationCode" class="form-label">کد <span class="text-danger">*</span></label><input asp-for="Input.ApplicationCode" class="form-control" dir="ltr" required maxlength="50" /></div>
            <div class="col-md-8"><label asp-for="Input.BaseUrl" class="form-label">نشانی ورود سامانه</label><input asp-for="Input.BaseUrl" class="form-control" dir="ltr" maxlength="500" placeholder="https://..." required type="url" /></div>
            <div class="col-md-4"><label asp-for="Input.DisplayOrder" class="form-label">ترتیب نمایش</label><input asp-for="Input.DisplayOrder" type="number" min="0" class="form-control" placeholder="خالی = آخرین ردیف" /></div>
            <div class="col-md-8"><label asp-for="Input.Description" class="form-label">خلاصه کارکرد</label><textarea asp-for="Input.Description" class="form-control" rows="2" maxlength="500" data-counter></textarea></div>
            <div class="col-md-4"><label asp-for="Input.Icon" class="form-label">آیکن</label><select asp-for="Input.Icon" class="form-select" data-icon-picker>
                @foreach (var icon in OrganizationIntranet.Contracts.ApplicationCatalogOptions.Icons) { <option value="@icon">@AdminLabels.Icon(icon)</option> }
            </select></div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-world"></i>نحوه‌ی دسترسی</h2>
            <p class="form-section__help">مشخص می‌کند چه کسی سامانه را ببیند و کاربر چه چیزی بداند.</p>
        </div>
        <div>
            <div class="switch-row">
                <div><label class="switch-row__label" for="Input_RequiresLogin">نیازمند ورود در سامانه</label><p class="switch-row__help">کاربر بعد از باز کردن سامانه، در خود سامانه هم باید وارد شود.</p></div>
                <input asp-for="Input.RequiresLogin" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label class="switch-row__label" for="Input_IsInternetAccessible">قابل دسترسی از اینترنت</label><p class="switch-row__help">سامانه از بیرون شبکه‌ی سازمان هم قابل استفاده است. فقط برای اطلاع کاربر.</p></div>
                <input asp-for="Input.IsInternetAccessible" class="form-check-input" role="switch" />
            </div>
            <div class="switch-row">
                <div><label class="switch-row__label" for="Input_IsPublic">عمومی</label><p class="switch-row__help">کارت سامانه را همه می‌بینند و نیازی به تخصیص دسترسی نیست.</p></div>
                <input asp-for="Input.IsPublic" class="form-check-input" role="switch" />
            </div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-users"></i>دسترسی کاربران و نقش‌ها</h2>
            <p class="form-section__help">کاربر یا نقش را انتخاب کنید؛ همان لحظه ثبت می‌شود و نیازی به ذخیره نیست.</p>
        </div>
        <div class="row g-3">
            <div class="col-lg-6"><partial name="_EntityPicker" model='PickList.ForUsers("Input.UserIds", "کاربران", Model.Users, Model.Input.UserIds, Url.Page("Edit", "Access", new { id = Model.Id }))' /></div>
            <div class="col-lg-6"><partial name="_EntityPicker" model='PickList.ForRoles("Input.RoleIds", "نقش‌ها", Model.Roles, Model.Input.RoleIds, Url.Page("Edit", "Access", new { id = Model.Id }))' /></div>
        </div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-bell"></i>اطلاع‌رسانی درخواست‌ها</h2>
            <p class="form-section__help">درخواست‌های دسترسی این سامانه از این راه به مدیران و گروه‌های نظارت اطلاع داده می‌شود.</p>
        </div>
        <div class="row"><div class="col-md-6">
            <label asp-for="Input.AccessRequestNotificationChannels" class="form-label">روش اطلاع‌رسانی</label>
            <select asp-for="Input.AccessRequestNotificationChannels" class="form-select">
                @foreach (var channel in new[] { "InApp", "Sms", "Both" }) { <option value="@channel">@AdminLabels.NotificationChannel(channel)</option> }
            </select>
        </div></div>
    </section>

    <section class="form-section">
        <div>
            <h2 class="form-section__title"><i class="ti ti-plug-connected"></i>سرویس‌های ثبت‌شده</h2>
            <p class="form-section__help">برای نمایش اعلان‌های سامانه، سرویس با کد <code>NOTIFICATIONS</code> را فعال کنید. برای افزودن سرویس، ردیف خالی را تکمیل و ذخیره کنید.</p>
        </div>
        <div>
            @foreach (var sync in Model.SyncStatuses.Where(s => s.ServiceCode == "NOTIFICATIONS"))
            {
                <div class="admin-callout @(sync.LastSyncError is null ? "" : "admin-callout--warning") mb-3" role="status">
                    <i class="ti @(sync.LastSyncError is null ? "ti-info-circle" : "ti-alert-triangle")" aria-hidden="true"></i>
                    <div>
                        آخرین واکشی موفق: <span dir="ltr">@(sync.LastSyncedAt?.ToString("yyyy/MM/dd HH:mm") ?? "هنوز انجام نشده")</span>
                        @if (sync.LastSyncError is not null) { <div class="text-danger">@sync.LastSyncError</div> }
                    </div>
                </div>
            }
            <div class="table-responsive border rounded-3">
                <table class="table table-admin">
                    <thead><tr><th>کد سرویس</th><th>نام</th><th>نشانی سرویس</th><th class="text-center">فعال</th><th class="text-center">حذف</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.Input.Services.Count; i++)
                        {
                            <tr>
                                <td style="min-width:140px"><input asp-for="Input.Services[i].ServiceCode" aria-label="کد سرویس" class="form-control form-control-sm" dir="ltr" maxlength="50" placeholder="@(i == Model.Input.Services.Count - 1 ? "سرویس جدید" : "")" /></td>
                                <td style="min-width:140px"><input asp-for="Input.Services[i].DisplayName" aria-label="نام سرویس" class="form-control form-control-sm" maxlength="150" /></td>
                                <td style="min-width:200px"><input asp-for="Input.Services[i].EndpointUrl" aria-label="نشانی سرویس" class="form-control form-control-sm" dir="ltr" maxlength="500" /></td>
                                <td class="text-center"><input asp-for="Input.Services[i].IsActive" aria-label="فعال" class="form-check-input" /></td>
                                <td class="text-center"><input asp-for="Input.Services[i].Remove" aria-label="حذف" class="form-check-input" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>

    <div class="form-actions">
        @if (canEdit) { <button class="btn btn-primary btn-wave" type="submit"><i class="ti ti-device-floppy me-1"></i>ذخیره تنظیمات</button> }
        <a asp-page="Index" class="btn btn-primary-light">بازگشت</a>
    </div>
</form>

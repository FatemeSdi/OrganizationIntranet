@page
@model LoginModel
@{
    ViewData["Title"] = "ورود به پنل مدیریت";
    Layout = "_LayoutAuth";
}
<style>
    #loginForm { width: 100%; min-width: 0 !important; max-width: 100%; }
    #securitySection, #securitySection label { min-width: 0; max-width: 100%; }
    .login-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 16px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(1100px 600px at 8% 0%, rgba(27,66,117,.10), transparent 60%), radial-gradient(900px 500px at 100% 100%, rgba(183,138,52,.08), transparent 55%), #eef1f5;
    }

        .login-container::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(11,37,64,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(11,37,64,.035) 1px, transparent 1px);
            background-size: 42px 42px;
            pointer-events: none;
        }

    .official-header {
        width: 100%;
        max-width: 860px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 20px;
        z-index: 1;
    }

        .official-header .badge-line {
            width: 46px;
            height: 3px;
            background: linear-gradient(90deg, #b78a34, #1b4275);
            border-radius: 3px;
        }

        .official-header h6 {
            margin: 0;
            color: #0b2540;
            font-weight: 700;
            font-size: 15px;
        }

    .login-card {
        display: flex;
        width: 960px;
        min-height: 450px;
        height: auto;
        max-width: 100%;
        background: #fff;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(36, 75, 139, 0.12);
        position: relative;
        z-index: 1;
    }

    .login-right {
        min-width: 0;
        flex: 1;
        padding: 40px 36px;
    }

    .login-left {
        width: 320px;
        background: linear-gradient(160deg, #244b8b, #3a6bb5);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        padding: 36px 28px;
        color: #fff;
        text-align: center;
    }

        .login-left img {
            max-width: 160px;
            margin-bottom: 24px;
            filter: brightness(0) invert(1);
        }

    .login-title {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.6;
        margin-bottom: 20px;
    }

    .form-control, .captchaInput {
        height: 46px !important;
        border-radius: 10px !important;
        border: 1px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

    .input-group .form-control {
        border-radius: 10px 0 0 10px !important;
    }

    /* رمز عبور: آیکن کلید در راست، دکمه‌ی نمایش رمز در چپ */
    .password-input-group .form-control {
        border-radius: 0 !important;
    }

    .password-input-group .password-key-icon {
        border-radius: 0 10px 10px 0 !important;
    }

    .password-input-group .password-toggle {
        border-radius: 10px 0 0 10px !important;
        cursor: pointer;
    }

    /* کد امنیتی راست‌به‌چپ مثل بقیه‌ی فرم */
    .captchaInput {
        direction: rtl !important;
        text-align: right;
    }

        .form-control:focus {
            border-color: #244b8b !important;
            box-shadow: 0 0 0 3px rgba(36, 75, 139, 0.12) !important;
            background: #fff !important;
        }

    .input-group-text {
        border-radius: 0 10px 10px 0 !important;
        border: 1px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

    .btn-primary {
        height: 48px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        background: #244b8b;
    }

        .btn-primary:hover {
            background: #1a3a6e;
        }

    .support-btn {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 50px;
        padding: 10px 18px;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

        .support-btn:hover {
            background: rgba(255,255,255,.25);
            color: #fff;
        }

    .support-number-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        background: #f8fafc;
        border-radius: 10px;
        margin-bottom: 8px;
    }

        .support-number-item i {
            color: #244b8b;
            font-size: 18px;
        }

        .support-number-item .number {
            font-weight: 600;
            direction: ltr;
            font-size: 13px;
        }

        .support-number-item .label {
            color: #64748b;
            font-size: 12px;
        }

    .otp-input { font-size: 22px; letter-spacing: 10px; font-weight: 700; }

    .authentication-barrier p {
        font-size: 12px;
        color: #94a3b8;
    }

    #supportModal .modal-content {
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 16px 48px rgba(36, 75, 139, 0.18);
    }

    #supportModal .modal-header {
        background: linear-gradient(135deg, #244b8b, #3a6bb5);
        color: #fff;
        border: none;
        padding: 20px 24px;
        margin-bottom: 0;
    }

    #supportModal .modal-title {
        color: #fff;
        font-size: 17px;
        margin: 0;
        line-height: 1.4;
    }

    #supportModal .btn-close {
        filter: invert(1);
        opacity: .8;
    }

    #supportModal .modal-body {
        padding: 24px;
        background: #f8fafc;
    }

    #supportModal .support-number-item {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 10px;
        transition: .2s;
    }

        #supportModal .support-number-item:hover {
            border-color: #244b8b;
            box-shadow: 0 4px 12px rgba(36, 75, 139, 0.08);
        }

        #supportModal .support-number-item i {
            color: #244b8b;
            font-size: 20px;
            width: 28px;
            text-align: center;
        }

        #supportModal .support-number-item .label {
            color: #64748b;
            font-size: 12px;
        }

        #supportModal .support-number-item .number {
            font-weight: 600;
            color: #0b2540;
            font-size: 14px;
            direction: ltr;
        }

    @@media (max-width: 991px) {
        .login-card {
            flex-direction: column;
            max-width: 420px;
        }

        .login-left {
            width: 100%;
            padding: 28px 20px;
        }

        .login-right {
            padding: 28px 20px;
        }
    }
</style>

<div class="login-container">
    <div class="official-header">
        <span class="badge-line"></span>
        <h6>پنل مدیریت اینترانت سازمان</h6>
        <span class="badge-line"></span>
    </div>

    <div class="login-card">
        <div class="login-right">
            @if (Model.Error is not null) { <div class="alert alert-danger" role="alert">@Model.Error</div> }

            <form id="loginForm" method="post" autocomplete="off" asp-page="/Account/Login">
                @if (TempData["AuthenticationMessage"] is string message) { <p role="status" class="alert alert-success">@message</p> }
                <input type="hidden" asp-for="ReturnUrl" />
                @Html.AntiForgeryToken()
                <label for="loginMethod" class="form-label">روش ورود</label>
                <select asp-for="Method" id="loginMethod" class="form-select mb-3">
                    @if (Model.Methods.PasswordEnabled) { <option value="password">نام کاربری و رمز عبور</option> }
                    @if (Model.Methods.LdapEnabled) { <option value="ldap">حساب سازمانی (LDAP)</option> }
                    @if (Model.Methods.NationalIdSmsEnabled) { <option value="national-id-sms">کد ملی و پیامک</option> }
                </select>

                <div data-method-panel="credentials">
                    <div class="form-group mb-3">
                        <div class="input-group mt-3">
                            <span class="input-group-text"><i class="ti ti-user text-muted"></i></span>
                            <input asp-for="Username" class="form-control" placeholder="نام کاربری" aria-label="نام کاربری" autocomplete="username" required />
                        </div>
                    </div>
                    <div class="form-group mb-3">
                        <div class="input-group password-input-group" id="Password-toggle">
                            <span class="input-group-text password-key-icon" aria-hidden="true"><i class="ti ti-key text-muted"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="رمز عبور" aria-label="رمز عبور" autocomplete="current-password" required />
                            <button class="input-group-text password-toggle" type="button" aria-label="نمایش رمز عبور" title="نمایش رمز عبور" aria-pressed="false">
                                <i class="ti ti-eye text-muted"></i>
                            </button>
                        </div>
                        @if (Model.Methods.ForgotPasswordEnabled) {
                        <a class="float-end link-danger fw-medium fs-12 mt-1" asp-page="/Account/ForgotPassword">رمز عبور را فراموش کرده‌اید؟</a>
                        }
                    </div>
                </div>

                <div data-method-panel="national-id" hidden>
                    <div id="nationalIdStep" class="mb-3">
                        <div class="input-group mt-3">
                            <span class="input-group-text"><i class="ti ti-id text-muted"></i></span>
                            <input asp-for="NationalId" class="form-control" inputmode="numeric" maxlength="10" dir="ltr" placeholder="کد ملی ۱۰ رقمی" aria-label="کد ملی" autocomplete="off" required />
                        </div>
                        <small class="text-muted fs-12 d-block mt-1"><i class="ti ti-message-2 me-1"></i>کد تأیید به شماره همراه ثبت‌شده در سامانه پیامک می‌شود.</small>
                    </div>
                    <div id="codeStep" class="mb-3" hidden>
                        <label for="Code" class="form-label">کد تأیید پیامک‌شده</label>
                        <input asp-for="Code" class="form-control text-center otp-input" inputmode="numeric" maxlength="6" dir="ltr" placeholder="------" autocomplete="one-time-code" aria-label="کد تأیید ۶ رقمی" required />
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <button type="button" id="changeNationalId" class="btn btn-link p-0 fs-12 text-muted"><i class="ti ti-arrow-right me-1"></i>تغییر کد ملی</button>
                            <button type="button" id="resendCode" class="btn btn-link p-0 fs-12" disabled>ارسال دوباره <span id="resendTimer"></span></button>
                        </div>
                    </div>
                </div>

                <div id="securitySection" class="form-group text-start mt-2" style="direction:rtl;">
                    <dnt-captcha asp-captcha-generator-max="99999"
                                 asp-captcha-generator-min="10000"
                                 asp-captcha-generator-language="English"
                                 asp-captcha-generator-display-mode="ShowDigits"
                                 asp-use-relative-urls="true"
                                 asp-placeholder="کد امنیتی را وارد کنید"
                                 asp-text-box-class="form-control captchaInput"
                                 asp-validation-error-message="کد امنیتی اشتباه است."
                                 asp-too-many-requests-error-message="درخواست‌های زیاد! لطفاً یک دقیقه صبر کنید!"
                                 asp-font-name="Arial"
                                 asp-font-size="30"
                                 asp-fore-color="#24324A"
                                 asp-back-color="#F3F7FA"
                                 asp-text-box-template="<div class='form-group'>{0}</div>"
                                 asp-validation-message-class="text-danger"
                                 asp-show-refresh-button="true"
                                 asp-refresh-button-class="ti ti-refresh btn captcha-refresh" />
                </div>

                <div class="form-check mt-3 mb-0">
                    <input asp-for="RememberMe" class="form-check-input" id="defaultCheck1" type="checkbox" />
                    <label class="form-check-label fs-13" for="defaultCheck1">مرا به خاطر بسپار</label>
                </div>

                <div class="form-group mt-3">
                    <button type="submit" id="loginBtn" class="btn btn-primary w-100" disabled="@(!Model.AnyMethodEnabled)">
                        <span id="loginText">ورود</span>
                        <span id="loginSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                    </button>
                </div>
            </form>

            <div class="text-center mt-4 authentication-barrier">
                <p class="mb-0"><i class="ti ti-shield-check me-1"></i>پیروی از ISMS — تمامی فعالیت‌ها ثبت می‌شود</p>
            </div>
        </div>

        <div class="login-left">
            <img src="~/assets/images/brand-logos/logo-pmo.png" alt="Logo" />
            <div class="login-title">اداره کل بنادر و دریانوردی<br>استان هرمزگان</div>
            <button class="support-btn" data-bs-toggle="modal" data-bs-target="#supportModal">
                <i class="ti ti-headset"></i><span>پشتیبانی</span>
            </button>
        </div>
    </div>
</div>

<div class="modal fade" id="supportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0" style="border-radius:16px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-semibold"><i class="ti ti-headset me-2"></i>پشتیبانی</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-3">
                <div class="support-number-item">
                    <i class="ti ti-phone"></i>
                    <div>
                        <div class="label">فاوا — نرم‌افزار (ساعات اداری)</div>
                        <div class="number">۰۹۹۴۰۶۵۷۷۵۳ — فاطمه صادقی</div>
                    </div>
                </div>
                <div class="support-number-item">
                    <i class="ti ti-phone"></i>
                    <div>
                        <div class="label">داخلی</div>
                        <div class="number">۴۶۴۷</div>
                    </div>
                </div>
                <div class="support-number-item">
                    <i class="ti ti-mail"></i>
                    <div>
                        <div class="label">ایمیل</div>
                        <div class="number">sdi10fateme@@gmail.com</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (Model.LoggedOut) { <script>document.addEventListener('DOMContentLoaded', function () { showToast('با موفقیت از سیستم خارج شدید', 'success'); });</script> }
    <script src="~/js/login-form.js" asp-append-version="true"></script>
}

@page
@model OrganizationIntranet.Pages.Account.SecurityModel
@{ ViewData["Title"] = "امنیت حساب"; Layout = "_LayoutAuth"; }
<link rel="stylesheet" href="~/assets/css/authentication.css" asp-append-version="true" />
<main class="auth-shell" dir="rtl"><section class="auth-panel">
<h1>امنیت حساب و Google Authenticator</h1>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
<p>احراز هویت دومرحله‌ای: @(Model.Status.TwoFactorRequired ? "الزامی" : "غیرفعال")</p>
<p>روش پیامک: @(Model.Status.SmsAvailable ? "در دسترس" : "در دسترس نیست")</p>
@if (Model.Status.AuthenticatorConfigured) {
<p class="alert alert-success">Google Authenticator قبلاً تنظیم شده است.</p>
<p>در صورت از دست دادن دستگاه، از پیامکِ فعال یا پشتیبانی سازمان کمک بگیرید.</p>
} else if (!Model.Status.AuthenticatorAvailable) {
<p>مدیر سامانه این روش را غیرفعال کرده است.</p>
} else if (Model.Setup is not null) {
<p>در Google Authenticator گزینه «وارد کردن کلید راه‌اندازی» را انتخاب کنید، نوع کلید را «مبتنی بر زمان» قرار دهید و این کلید را وارد کنید:</p>
<code class="auth-secret">@Model.Setup.Secret</code>
<p class="mt-3">سپس کد فعلی برنامه را وارد کنید. تا تأیید کد، راه‌اندازی کامل نمی‌شود.</p>
<form method="post" asp-page-handler="Confirm">
<label asp-for="Code">کد Google Authenticator</label>
<input asp-for="Code" class="form-control mb-3" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" maxlength="6" required />
<button class="btn btn-primary w-100" type="submit">تأیید راه‌اندازی</button>
</form>
<p class="mt-3">اعتبار این مرحله ۵ دقیقه است. پس از تأیید باید دوباره وارد شوید.</p>
} else {
<p>پیش از اجباری شدن ورود دومرحله‌ای، برنامه را برای حساب خود تنظیم کنید.</p>
<form method="post">
<label asp-for="LoginMethod">روش تأیید رمز فعلی</label>
<select asp-for="LoginMethod" class="form-select mb-3">
@if (Model.Methods.PasswordEnabled) { <option value="password">رمز محلی</option> }
@if (Model.Methods.LdapEnabled) { <option value="ldap">LDAP</option> }
</select>
<label asp-for="Password">رمز فعلی</label>
<input asp-for="Password" type="password" class="form-control mb-3" autocomplete="current-password" required />
<button class="btn btn-primary w-100" type="submit">راه‌اندازی Google Authenticator</button>
</form>
}
<a asp-page="/Account/Profile" class="d-block mt-3">بازگشت به پروفایل</a>
</section></main>

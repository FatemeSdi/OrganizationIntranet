@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "بازنشانی رمز عبور";
    Layout = "_LayoutAuth";
}
<style>
    .login-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 16px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(1100px 600px at 8% 0%, rgba(27,66,117,.10), transparent 60%), radial-gradient(900px 500px at 100% 100%, rgba(183,138,52,.08), transparent 55%), #eef1f5;
    }

        .login-container::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image: linear-gradient(rgba(11,37,64,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(11,37,64,.035) 1px, transparent 1px);
            background-size: 42px 42px;
            pointer-events: none;
        }

    .official-header {
        width: 100%;
        max-width: 460px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin-bottom: 20px;
        z-index: 1;
    }

        .official-header .badge-line {
            width: 46px;
            height: 3px;
            background: linear-gradient(90deg, #b78a34, #1b4275);
            border-radius: 3px;
        }

        .official-header h6 {
            margin: 0;
            color: #0b2540;
            font-weight: 700;
            font-size: 15px;
        }

    .reset-card {
        width: 460px;
        max-width: 100%;
        background: #fff;
        border-radius: 20px;
        padding: 40px 36px;
        box-shadow: 0 12px 40px rgba(36, 75, 139, 0.12);
        position: relative;
        z-index: 1;
    }

    .form-control {
        height: 46px !important;
        border-radius: 10px !important;
        border: 1px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

        .form-control:focus {
            border-color: #244b8b !important;
            box-shadow: 0 0 0 3px rgba(36, 75, 139, 0.12) !important;
            background: #fff !important;
        }

    .btn-primary {
        height: 48px;
        border: none;
        border-radius: 10px;
        font-weight: 600;
        background: #244b8b;
    }

        .btn-primary:hover {
            background: #1a3a6e;
        }
</style>

<div class="login-container">
    <div class="official-header">
        <span class="badge-line"></span>
        <h6>بازنشانی رمز عبور</h6>
        <span class="badge-line"></span>
    </div>

    <div class="reset-card">
        <div class="alert alert-danger py-2 d-none" id="serverError"></div>

        <p class="text-muted fs-13 mb-4">
            برای بازنشانی رمز عبور، نام کاربری، کد ملی و شماره همراه ثبت‌شده‌ی خود را وارد کنید.
        </p>

        <form id="resetForm" method="post" autocomplete="off" asp-page="/Account/ForgotPassword">
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label class="form-label fs-13">نام کاربری</label>
                <input asp-for="Username" class="form-control" placeholder="نام کاربری" autocomplete="username" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label fs-13">کد ملی</label>
                <input asp-for="NationalId" class="form-control" placeholder="کد ملی" inputmode="numeric" maxlength="10" autocomplete="off" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label fs-13">شماره همراه</label>
                <input asp-for="MobileNumber" class="form-control" placeholder="09xxxxxxxxx" inputmode="numeric" maxlength="11" autocomplete="off" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label fs-13">رمز عبور جدید</label>
                <input asp-for="NewPassword" type="password" class="form-control" placeholder="رمز عبور جدید" autocomplete="new-password" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label fs-13">تأیید رمز عبور جدید</label>
                <input asp-for="ConfirmNewPassword" type="password" class="form-control" placeholder="تأیید رمز عبور جدید" autocomplete="new-password" required />
            </div>

            <div class="form-group mt-3">
                <button type="submit" id="resetBtn" class="btn btn-primary w-100">
                    <span id="resetText">ثبت رمز عبور جدید</span>
                    <span id="resetSpinner" class="spinner-border spinner-border-sm ms-2 d-none"></span>
                </button>
            </div>
        </form>

        <div class="text-center mt-3">
            <a class="fs-13 text-primary" asp-page="/Account/Login">
                <i class="ti ti-arrow-right"></i>
                بازگشت به صفحه ورود
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $('#resetForm').submit(function (e) {
            e.preventDefault();
            const btn = $("#resetBtn"), spinner = $("#resetSpinner"), text = $("#resetText");
            btn.prop("disabled", true); spinner.removeClass("d-none"); text.text("در حال ثبت...");
            $.ajax({
                url: '@Url.Page("/Account/ForgotPassword")', type: 'POST', data: $(this).serialize(),
                success: function (res) {
                    if (res.success) {
                        showToast(res.message || "رمز عبور با موفقیت تغییر کرد", "success");
                        setTimeout(function () { window.location.href = res.redirectUrl; }, 1200);
                    } else {
                        spinner.addClass("d-none"); text.text("ثبت رمز عبور جدید"); btn.prop("disabled", false);
                        showToast(res.message || "خطا در بازنشانی رمز عبور", "danger");
                    }
                },
                error: function () {
                    spinner.addClass("d-none"); text.text("ثبت رمز عبور جدید"); btn.prop("disabled", false);
                    showToast("خطای سرور", "danger");
                }
            });
        });
    </script>
}
